  <PropertyGroup Label="UserMacros" />
  <!-- IntelliSense-only Visual Studio project. VS is used to browse and edit the sources; the
       extension itself is built with SCons from a terminal, so no build, clean or IntelliSense-page
       properties are set here. The editor takes the include roots from the VC++ include directories
       and the compiler switches from the ClCompile item definition below. -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <DockitConfigDefines>WIN32;_DEBUG</DockitConfigDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DockitConfigDefines>_DEBUG</DockitConfigDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <DockitConfigDefines>WIN32;NDEBUG</DockitConfigDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DockitConfigDefines>NDEBUG</DockitConfigDefines>
  </PropertyGroup>
  <!-- SCons puts src/ first on the include path, so every include inside the project is written
       relative to it ("formats/html/...", "editor/...", "nodes/..."); the other roots provide the
       upstream, staged and generated headers the sources include by bare name ("types.h",
       "internal.h", "gumbo.h", "latex.h", "tinyxml2.h"). -->
  <PropertyGroup>
    <DockitIncludeRoots>$(ProjectDir)src;$(ProjectDir)src\gen\html\include;$(ProjectDir)src\gen\html\include\litehtml;$(ProjectDir)src\thirdparty\litehtml\src;$(ProjectDir)src\thirdparty\litehtml\src\gumbo\include;$(ProjectDir)src\thirdparty\litehtml\src\gumbo\include\gumbo;$(ProjectDir)src\thirdparty\litehtml\src\gumbo\visualc\include;$(ProjectDir)src\thirdparty\microtex\src;$(ProjectDir)src\thirdparty\tinyxml2</DockitIncludeRoots>
    <!-- Keep upstream Godot-cpp headers external so VS reports diagnostics from Dockit sources, not the dependency. -->
    <DockitExternalIncludeRoots>$(ProjectDir)godot-cpp\gdextension;$(ProjectDir)godot-cpp\include;$(ProjectDir)godot-cpp\gen\include</DockitExternalIncludeRoots>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64' And Exists('$(ProjectDir)src\thirdparty\merman-sdk\include\merman.h') And Exists('$(ProjectDir)src\thirdparty\merman-sdk\lib\merman_ffi.lib')">
    <DockitIncludeRoots>$(ProjectDir)src\thirdparty\merman-sdk\include;$(DockitIncludeRoots)</DockitIncludeRoots>
    <DockitSdkDefines>MARKDOWN_LABEL_MERMAN_ENABLED;$(DockitSdkDefines)</DockitSdkDefines>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)'=='x64' And Exists('$(ProjectDir)src\thirdparty\pdfium-sdk\include\fpdfview.h') And Exists('$(ProjectDir)src\thirdparty\pdfium-sdk\bin\pdfium.dll')">
    <DockitIncludeRoots>$(ProjectDir)src\thirdparty\pdfium-sdk\include;$(DockitIncludeRoots)</DockitIncludeRoots>
    <DockitSdkDefines>DOCKIT_PDFIUM_ENABLED;$(DockitSdkDefines)</DockitSdkDefines>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(DockitIncludeRoots);$(IncludePath)</IncludePath>
    <ExternalIncludePath>$(DockitExternalIncludeRoots);$(ExternalIncludePath)</ExternalIncludePath>
  </PropertyGroup>
  <!-- These ClCompile settings are what Visual Studio's IntelliSense parses with. /permissive- is
       deliberately NOT passed: it is a cl.exe switch and the IntelliSense front end does not emulate
       it reliably. The alternative tokens (not, and, or) the HTML sources use come from the forced
       iso646.h include instead, which behaves identically in cl and in IntelliSense.
       The project type is StaticLibrary only so VS follows the normal C++ pipeline instead of the
       Makefile one; the solution does not build it (no Build.0 entries) and SCons builds the
       extension from a terminal. -->
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <AdditionalOptions>/std:c++17 /utf-8 /permissive- %(AdditionalOptions)</AdditionalOptions>
      <AdditionalIncludeDirectories>$(DockitIncludeRoots);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <DisableAnalyzeExternal>true</DisableAnalyzeExternal>
      <TreatExternalTemplatesAsInternal>false</TreatExternalTemplatesAsInternal>
      <PreprocessorDefinitions>NOMINMAX;TYPED_METHOD_BIND;WINDOWS_ENABLED;GDEXTENSION;$(DockitSdkDefines);$(DockitConfigDefines);%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
