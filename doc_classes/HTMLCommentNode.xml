<?xml version="1.0" encoding="UTF-8" ?>
<class name="HTMLCommentNode" inherits="HTMLNode" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<brief_description>
		A DOM comment node.
	</brief_description>
	<methods>
		<method name="get_data" qualifiers="const">
			<return type="String" />
			<description>
				Returns the node's character data.
			</description>
		</method>
		<method name="set_data">
			<return type="int" enum="Error" />
			<param index="0" name="data" type="String" />
			<description>
				Replaces the node's character data and retains the handle.
			</description>
		</method>
	</methods>
	<members>
		<member name="data" type="String" setter="set_data" getter="get_data">
		</member>
	</members>
</class>
