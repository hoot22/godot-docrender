<?xml version="1.0" encoding="UTF-8" ?>
<class name="HTMLHRElement" inherits="HTMLElement" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<brief_description>
		An HTML thematic break.
	</brief_description>
	<description>
		Represents the [code]&lt;hr&gt;[/code] element.
	</description>
	<members>
		<member name="align" type="String" setter="set_align" getter="get_align">
			Reflects the legacy align attribute.
		</member>
		<member name="color" type="String" setter="set_color" getter="get_color">
			Reflects the legacy color attribute.
		</member>
		<member name="size" type="String" setter="set_size" getter="get_size">
			Reflects the legacy size attribute.
		</member>
		<member name="width" type="String" setter="set_width" getter="get_width">
			Reflects the legacy width attribute.
		</member>
		<member name="no_shade" type="bool" setter="set_no_shade" getter="is_no_shade">
			Reflects the legacy noshade attribute.
		</member>
	</members>
</class>
