<?xml version="1.0" encoding="UTF-8" ?>
<class name="HTMLMetaElement" inherits="HTMLElement" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<brief_description>
		An HTML metadata declaration.
	</brief_description>
	<description>
		Represents [code]&lt;meta&gt;[/code]. These properties reflect metadata attributes. Documents are read as UTF-8.
	</description>
	<members>
		<member name="charset" type="String" setter="set_charset" getter="get_charset">
			The declared character encoding.
		</member>
		<member name="content" type="String" setter="set_content" getter="get_content">
			The metadata content.
		</member>
		<member name="http_equiv" type="String" setter="set_http_equiv" getter="get_http_equiv">
			Reflects the [code]http-equiv[/code] attribute.
		</member>
		<member name="media" type="String" setter="set_media" getter="get_media">
			The declared media condition.
		</member>
		<member name="name" type="String" setter="set_name" getter="get_name">
			The metadata name.
		</member>
	</members>
</class>
