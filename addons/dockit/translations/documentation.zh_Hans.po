#. doc_classes/MarkdownLabel.xml
msgid ""
"A Control node for rendering Markdown text with scroll, text selection, search, and streaming "
"support."
msgstr "渲染 Markdown 文本的 Control 节点，支持滚动、选择、搜索和流式输出。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Activates the given link URI. A [code]#id[/code] link scrolls to the matching anchor before "
"emitting [signal link_pressed]. If [member open_external_links] is [code]true[/code] and the URI "
"starts with [code]http://[/code] or [code]https://[/code], opens it in the system default "
"browser."
msgstr ""
"激活指定的链接 URI。[code]#id[/code] 链接会先滚动到对应锚点，再发出 [signal link_pressed] 信号。当 "
"[member open_external_links] 为 [code]true[/code]，且 URI 以 [code]http://[/code] 或 "
"[code]https://[/code] 开头时，使用系统默认浏览器打开。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Additional font size added to all text sizes in the document. Clamped to [code][0, 16][/code]. "
"Can also be changed by the user with Ctrl+MouseWheel."
msgstr "应用于文档所有文本的额外字号。取值限制在 [code][0, 16][/code]。用户也可用 Ctrl+鼠标滚轮调整。"

#. doc_classes/LatexLabel.xml
msgid ""
"Aligns the formula horizontally. Left and right mirror in right-to-left layouts. Fill places the "
"formula at the left without stretching it."
msgstr "设置公式的水平对齐方式。在从右向左的布局中，左对齐和右对齐互换。填充模式会将公式放在左侧，保持原尺寸。"

#. doc_classes/LatexLabel.xml
msgid ""
"Aligns the formula vertically inside the normal stylebox margins. Fill places the formula at the "
"top."
msgstr "在常规样式盒的边距内垂直对齐公式。填充模式会将公式放在顶部。"

#. doc_classes/LatexLabel3D.xml
msgid "Allows 3D lights to affect the formula."
msgstr "使公式受 3D 光照影响。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Appends [param delta] to the current Markdown text. When [member streaming_enabled] is "
"[code]true[/code], only the unstable tail region is re-parsed for performance. When [member "
"scroll_following] is [code]true[/code] and the scroll bar was already at the bottom, the view "
"automatically scrolls to stay at the bottom."
msgstr ""
"将 [param delta] 追加到当前 Markdown 文本。[member streaming_enabled] 为 [code]true[/code] "
"时，仅重新解析尚未稳定的末尾区域以提升性能。[member scroll_following] 为 [code]true[/code] 且滚动条已在底部时，视图会跟随新内容保持在底部。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Autowrap space trimming flags. See [constant TextServer.BREAK_TRIM_START_EDGE_SPACES] and "
"[constant TextServer.BREAK_TRIM_END_EDGE_SPACES]."
msgstr ""
"自动换行时的空格裁剪标志。参见 [constant TextServer.BREAK_TRIM_START_EDGE_SPACES] 和 [constant "
"TextServer.BREAK_TRIM_END_EDGE_SPACES]。"

#. doc_classes/LatexLabel.xml
msgid "Background drawn when the control has keyboard focus."
msgstr "控件拥有键盘焦点时绘制的背景。"

#. doc_classes/LatexLabel3D.xml
msgid "Blends transparent texels."
msgstr "对透明纹素进行混合。"

#. doc_classes/TeXRender.xml
msgid ""
"Call [method parse] on the main thread to create a layout. Keep the [TeXRender] instance to "
"measure it and draw it repeatedly. Call [method draw] from [method CanvasItem._draw] or a [signal"
" CanvasItem.draw] callback.\n"
"Use [constant STYLE_TEXT] for inline math. Use [method get_baseline_offset] to align the formula "
"with the baseline of surrounding text."
msgstr ""
"在主线程调用 [method parse] 创建布局。保留 [TeXRender] 实例以反复测量和绘制。请从 [method CanvasItem._draw] 或 [signal "
"CanvasItem.draw] 的回调中调用 [method draw]。\n"
"行内公式使用 [constant STYLE_TEXT]。使用 [method get_baseline_offset] 将公式基线与周围文字对齐。"

#. doc_classes/TeXRender.xml
msgid ""
"Changes the foreground of the current layout. A fully transparent color uses MicroTeX's default "
"foreground. Colors specified in the expression still apply."
msgstr "更改当前布局的前景色。使用完全透明的颜色时，沿用 MicroTeX 的默认前景色。表达式内部指定的颜色仍然生效。"

#. doc_classes/MarkdownLabel.xml
msgid "Clears all Markdown text and resets the document state. Emits [signal text_changed]."
msgstr "清空 Markdown 文本并重置文档状态。发出 [signal text_changed]。"

#. doc_classes/MarkdownLabel.xml
msgid "Clears the current text selection."
msgstr "清除当前的文本选择。"

#. doc_classes/TeXRender.xml
msgid "Clears the layout, its settings, and the last error."
msgstr "清除布局、布局设置和上次错误。"

#. doc_classes/MermaidRender.xml
msgid "Clears the output, metadata, and error."
msgstr "清除输出、元数据和错误。"

#. doc_classes/LatexLabel.xml
msgid ""
"Clips formula drawing to the control's rectangle. The formula can be laid out in a narrower "
"control when enabled. Its height and the normal stylebox margins still contribute to the minimum "
"size."
msgstr "将公式裁剪到控件矩形内。启用后可在更窄的控件内排版，高度和常规样式盒的边距仍计入最小尺寸。"

#. doc_classes/MermaidLabel.xml
msgid "Color of connections and arrowheads for diagram types that support a shared line color."
msgstr "连线和箭头的颜色，适用于支持统一连线颜色的图表类型。"

#. doc_classes/MermaidLabel.xml
msgid "Color of node text and labels that use the diagram's shared text color."
msgstr "图表节点文字以及使用图表统一文字颜色的标签颜色。"

#. doc_classes/MarkdownLabel.xml
msgid "Context menu item ID for the Copy action."
msgstr "右键菜单中「复制」的菜单项 ID。"

#. doc_classes/MarkdownLabel.xml
msgid "Context menu item ID for the Select All action."
msgstr "右键菜单中「全选」的菜单项 ID。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls [member double_sided]."
msgstr "控制 [member double_sided]。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls [member fixed_size]."
msgstr "控制 [member fixed_size]。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls [member no_depth_test]."
msgstr "控制 [member no_depth_test]。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls [member shaded]."
msgstr "控制 [member shaded]。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls how the formula faces the camera."
msgstr "控制公式如何朝向摄像机。"

#. doc_classes/LatexLabel3D.xml
msgid "Controls how the material handles transparent texels."
msgstr "控制材质如何处理透明纹素。"

#. doc_classes/MermaidLabel.xml
msgid "Controls palette selection in [constant THEME_AUTO]. Falls back to the [Label] theme's font color."
msgstr "控制 [constant THEME_AUTO] 的配色选择。未设置时使用 [Label] 主题的字体颜色。"

#. doc_classes/TeXRender.xml
msgid "Cramped display math style."
msgstr "紧缩独立公式样式。"

#. doc_classes/TeXRender.xml
msgid "Cramped inline math style."
msgstr "紧缩行内公式样式。"

#. doc_classes/TeXRender.xml
msgid "Cramped nested script math style."
msgstr "紧缩嵌套上下标样式。"

#. doc_classes/TeXRender.xml
msgid "Cramped script math style."
msgstr "紧缩上下标样式。"

#. doc_classes/MermaidRender.xml
msgid ""
"Create a [MermaidRender] instance to configure a diagram, export it, or read its layout for "
"custom drawing. Call [method render] on the main thread. The operation is synchronous and stores "
"its result on the instance.\n"
"Use [method get_texture] for PNG or JPEG output, [method get_output_text] for SVG, ASCII, or "
"JSON, and [method get_bytes] for binary data. The current SDK backend is available in Windows x64"
" MSVC builds with Merman enabled."
msgstr ""
"创建 [MermaidRender] 实例来配置或导出图表，也可以读取布局用于自定义绘制。在主线程调用 [method render]。操作同步执行，结果保存在实例上。\n"
"使用 [method get_texture] 读取 PNG 或 JPEG 输出，使用 [method get_output_text] 读取 SVG、ASCII 或 JSON，使用 "
"[method get_bytes] 读取二进制数据。启用 Merman 的 Windows x64 MSVC 构建支持当前 SDK 后端。"

#. doc_classes/MermaidRender.xml
msgid ""
"Creates a new [ImageTexture] from the current PNG or JPEG output. Keep the returned texture if "
"you plan to draw it repeatedly."
msgstr "根据当前 PNG 或 JPEG 输出创建新的 [ImageTexture]。如果需要反复绘制，请保留返回的纹理。"

#. doc_classes/MermaidRender.xml
msgid ""
"Decodes the current PNG or JPEG output into a new [Image]. Returns [code]null[/code] for other "
"output formats or an empty result."
msgstr "将当前的 PNG 或 JPEG 输出解码为新的 [Image]。输出为空或使用其他格式时返回 [code]null[/code]。"

#. doc_classes/LatexLabel.xml
msgid "Default background and content margins for the formula."
msgstr "公式的默认背景和内容边距。"

#. doc_classes/MarkdownLabel.xml
msgid "Deferred streaming layout flush interval in milliseconds. Clamped to [code][1, 1000][/code]."
msgstr "延迟流式排版的刷新间隔，单位为毫秒。取值限制在 [code][1, 1000][/code]。"

#. doc_classes/LatexLabel3D.xml
msgid "Disables the depth test for the formula material."
msgstr "禁用公式材质的深度测试。"

#. doc_classes/LatexLabel3D.xml
msgid "Discards texels below the opacity threshold."
msgstr "丢弃不透明度低于阈值的纹素。"

#. doc_classes/TeXRender.xml
msgid "Display math style."
msgstr "独立公式样式。"

#. doc_classes/LatexLabel3D.xml
msgid "Displays a LaTeX formula in a 3D scene."
msgstr "在 3D 场景中显示 LaTeX 公式。"

#. doc_classes/LatexLabel.xml
msgid "Displays a LaTeX math expression using MicroTeX."
msgstr "使用 MicroTeX 显示 LaTeX 数学表达式。"

#. doc_classes/MermaidLabel.xml
msgid "Displays a standalone Mermaid diagram using Merman."
msgstr "使用 Merman 显示独立的 Mermaid 图表。"

#. doc_classes/LatexLabel3D.xml
msgid "Draws both sides of the formula quad."
msgstr "绘制公式四边形的两面。"

#. doc_classes/LatexLabel3D.xml
msgid "Draws opaque portions in a depth prepass."
msgstr "在深度预通道中绘制不透明区域。"

#. doc_classes/TeXRender.xml
msgid ""
"Draws the current layout with its top-left corner at [param position] in [param canvas]'s local "
"coordinates. After drawing, the canvas item's draw transform is set to identity."
msgstr "绘制当前布局，使其左上角位于 [param canvas] 局部坐标中的 [param position]。绘制完成后，画布项的绘制变换会恢复为单位变换。"

#. doc_classes/MarkdownLabel.xml
msgid "Emitted when [member extra_font_size] changes, either programmatically or via Ctrl+MouseWheel."
msgstr "[member extra_font_size] 通过代码或 Ctrl+鼠标滚轮发生变化时发出。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Emitted when a link is clicked. [param uri] is the target URL. If [member open_external_links] is"
" [code]true[/code], http/https links are also opened in the browser automatically."
msgstr ""
"点击链接时发出。[param uri] 是目标 URL。[member open_external_links] 为 [code]true[/code] 时，还会在浏览器中自动打开 "
"http/https 链接。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Emitted when the Markdown parser encounters a warning, such as a broken image or an unrecognized "
"block type."
msgstr "Markdown 解析器遇到警告时发出，例如图片无法加载或遇到无法识别的块类型。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Emitted when the Markdown text changes via [method set_markdown_text], [method append_text], "
"[method clear], or [method load_markdown_file]."
msgstr ""
"通过 [method set_markdown_text]、[method append_text]、[method clear] 或 [method load_markdown_file] "
"修改 Markdown 文本时发出。"

#. doc_classes/MermaidLabel.xml
msgid ""
"Emitted when the current diagram finishes rendering. Inspect [method get_texture] and [method "
"get_render_error] for the result."
msgstr "当前图表完成渲染时发出。通过 [method get_texture] 和 [method get_render_error] 查看结果。"

#. doc_classes/LatexLabel3D.xml
msgid "Enables or disables the specified draw flag."
msgstr "启用或禁用指定的绘制标志。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Enables the supported GitHub Flavored Markdown extensions for tables, task lists, strikethrough, "
"and [code]<www.example.com>[/code] autolinks. Changing this property reparses the current text. "
"Math parsing is controlled by [member parse_latex]."
msgstr ""
"启用表格、任务列表、删除线和 [code]<www.example.com>[/code] 自动链接等受支持的 GitHub Flavored Markdown "
"扩展。修改此属性会重新解析当前文本。数学公式解析由 [member parse_latex] 控制。"

#. doc_classes/MermaidLabel.xml
msgid ""
"Enter Mermaid source directly in [member text]. The diagram renders in the background after the "
"control enters the scene tree. When ready, the diagram is centered in the control and its logical"
" size becomes the control's minimum size.\n"
"Use [member theme_mode] to select a default diagram palette. Set the [theme_item "
"node_background_color], [theme_item node_border_color], [theme_item node_text_color], and "
"[theme_item line_color] theme items to customize the diagram. Changing the theme rerenders the "
"diagram.\n"
"[method get_texture] returns the rendered texture for use by other controls. The Merman backend "
"is available in Windows x64 MSVC builds with the SDK installed."
msgstr ""
"在 [member text] 中直接输入 Mermaid 源码。控件进入场景树后，图表会在后台渲染。渲染完成后，图表在控件中居中，其逻辑尺寸成为控件的最小尺寸。\n"
"使用 [member theme_mode] 选择图表的默认配色。设置 [theme_item node_background_color]、[theme_item "
"node_border_color]、[theme_item node_text_color] 和 [theme_item line_color] 主题项可自定义图表。修改主题后会重新渲染图表。"
"\n"
"[method get_texture] 返回渲染后的纹理，供其他控件使用。安装 SDK 后，Windows x64 MSVC 构建可使用 Merman 后端。"

#. doc_classes/LatexLabel.xml
msgid ""
"Enter an expression such as [code]\\"
"frac{1}{\\sqrt{x}}[/code] in [member text]. [LatexLabel] uses"
" embedded math fonts and draws the result on the Godot canvas. Its minimum size follows the "
"dimensions of the formula.\n"
"Use [member label_settings] to share a font size and color between labels, or override the "
"[code]font_size[/code] and [code]font_color[/code] theme items. Theme values fall back to the "
"[Label] theme."
msgstr ""
"在 [member text] 中输入表达式，例如 [code]\\"
"frac{1}{\\sqrt{x}}[/code]。[LatexLabel] 使用内置数学字体在 Godot "
"画布上绘制公式，最小尺寸由公式大小决定。\n"
"使用 [member label_settings] 在多个标签间共享字号和颜色，也可以覆盖 [code]font_size[/code] 和 [code]font_color[/code] "
"主题项。未设置的主题值沿用 [Label] 的主题。"

#. doc_classes/MermaidRender.xml
msgid ""
"Executes a Merman operation and replaces the previous result. Example IDs include "
"[code]png[/code], [code]svg[/code], [code]pdf[/code], [code]semantic-json[/code], [code]layout-"
"json[/code], and [code]validation-json[/code]. Consult [method get_runtime_catalog] for the full "
"list.\n"
"Pass Merman options as a dictionary with JSON-compatible values. Use [code]site_config[/code] for"
" Mermaid settings, [code]raster[/code] for image export settings, and [code]presentation[/code] "
"for Merman theme roles. Options depend on the operation. For document analysis, supply the "
"document text and its [param uri].\n"
"[param timeout_msec] limits the operation in milliseconds. Use [code]0[/code] to run without a "
"deadline. Returns [constant OK] when the operation produces a result. For validation and analysis"
" operations, inspect the returned JSON for diagnostics."
msgstr ""
"执行 Merman 操作并替换上一次的结果。操作 ID 示例包括 [code]png[/code]、[code]svg[/code]、[code]pdf[/code]、[code"
"]semantic-json[/code]、[code]layout-json[/code] 和 [code]validation-json[/code]。完整列表见 [method "
"get_runtime_catalog]。\n"
"通过字典传入 Merman 选项，字典值须兼容 JSON。Mermaid 设置用 [code]site_config[/code]，图片导出设置用 "
"[code]raster[/code]，Merman 主题角色设置用 [code]presentation[/code]。可用选项取决于操作。分析文档时请提供文档文本及其 [param "
"uri]。\n"
"[param timeout_msec] 指定操作时限，单位为毫秒。设为 [code]0[/code] 可取消时限。操作产生结果时返回 [constant "
"OK]。对于验证和分析操作，请检查返回的 JSON 中的诊断信息。"

#. doc_classes/TeXRender.xml
msgid ""
"Expands the layout to at least [param height] pixels, positioning the formula at the top, center,"
" or bottom of the extra space."
msgstr "将布局高度扩展到至少 [param height] 像素，使公式在额外空间中顶部对齐、居中或底部对齐。"

#. doc_classes/TeXRender.xml
msgid ""
"Expands the layout to at least [param width] pixels, positioning the formula at the left, center,"
" or right of the extra space."
msgstr "将布局宽度扩展到至少 [param width] 像素，使公式在额外空间中左对齐、居中或右对齐。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Exposes RichTextLabel-compatible visible-character scroll following. MarkdownLabel does not "
"currently implement visible-character clipping, so this property is stored but has no visual "
"effect."
msgstr "提供与 RichTextLabel 兼容的逐字显示滚动跟随属性。MarkdownLabel 目前尚未实现按可见字符数裁剪，因此该属性会保存但没有可见效果。"

#. doc_classes/MermaidLabel.xml
msgid "Fill color of diagram nodes, such as flowchart boxes and sequence diagram participants."
msgstr "图表节点的填充颜色，例如流程图方框和时序图参与者的背景。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Flushes any deferred streaming parse and layout update immediately. Returns [code]true[/code] if "
"pending text was flushed."
msgstr "立即执行延迟的流式解析和排版更新。处理了待更新的文本时返回 [code]true[/code]。"

#. doc_classes/LatexLabel3D.xml
msgid "Font size used for formula layout, in pixels."
msgstr "公式排版使用的字号，单位为像素。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Forces a full re-parse of the entire document. Call this after the last [method append_text] call"
" to ensure correct final layout. Respects [member scroll_following] behavior."
msgstr "强制重新解析整篇文档。在最后一次调用 [method append_text] 后调用此方法，以生成正确的最终布局。遵循 [member scroll_following] 的设置。"

#. doc_classes/LatexLabel.xml
msgid "Foreground color for the formula when [member label_settings] is unset."
msgstr "未设置 [member label_settings] 时使用的公式前景色。"

#. doc_classes/LatexLabel.xml
msgid "Formula size when [member label_settings] is unset."
msgstr "未设置 [member label_settings] 时使用的公式字号。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Handles a menu option selection by its identifier. Typically used with the IDs from the [enum "
"MenuItems] enum."
msgstr "按标识符处理菜单选项。通常使用 [enum MenuItems] 中定义的 ID。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], [method append_text] performs incremental re-parsing. Enable this for real-"
"time text streaming scenarios."
msgstr "为 [code]true[/code] 时，[method append_text] 使用增量解析。适用于需要实时显示流式文本的场景。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], a context menu with Copy and Select All options appears on right-click."
msgstr "为 [code]true[/code] 时，右键单击会显示含「复制」和「全选」的菜单。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], clicking an http/https link opens it in the system default browser."
msgstr "为 [code]true[/code] 时，点击 http/https 链接会使用系统默认浏览器打开。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], internal vertical scrolling is active."
msgstr "为 [code]true[/code] 时，启用内部垂直滚动。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], keyboard shortcuts (Ctrl+C, Ctrl+A) are handled by the control."
msgstr "为 [code]true[/code] 时，控件处理键盘快捷键（Ctrl+C、Ctrl+A）。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], renders closed fenced [code]mermaid[/code] blocks as diagrams using Merman."
" The rendering palette follows the luminance of the Markdown theme's text color. The editor's "
"Markdown preview enables this property.\n"
"The source code is displayed while rendering, after an error, or on builds without the Merman "
"backend. Text selection copies the diagram source."
msgstr ""
"为 [code]true[/code] 时，使用 Merman 将已闭合的 [code]mermaid[/code] 围栏代码块渲染为图表。图表配色取决于 Markdown "
"主题文字颜色的亮度。编辑器的 Markdown 预览会启用此属性。\n"
"渲染期间、渲染失败或构建中缺少 Merman 后端时显示图表源码。复制选区时会复制图表源码。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], selected text can be dragged and dropped to other controls."
msgstr "为 [code]true[/code] 时，可以将选中文本拖放到其他控件。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], streaming appends are parsed and laid out in batches instead of on every "
"[method append_text] call."
msgstr "为 [code]true[/code] 时，流式追加的内容分批解析和排版，无需每次调用 [method append_text] 时立即处理。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], text can be selected with the mouse."
msgstr "为 [code]true[/code] 时，可以用鼠标选择文本。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], the control reports the rendered content height as its minimum height."
msgstr "为 [code]true[/code] 时，控件将渲染内容的高度作为最小高度。"

#. doc_classes/MarkdownLabel.xml
msgid "If [code]true[/code], the text selection is automatically cleared when the node loses focus."
msgstr "为 [code]true[/code] 时，节点失去焦点会自动清除选区。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], the view follows appended content while the scroll bar is already at the "
"bottom."
msgstr "为 [code]true[/code] 时，如果滚动条已在底部，视图会跟随追加内容。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], uses [TeXRender] to render [code]$...$[/code] as inline math. A centered "
"display formula starts a line with [code]$$[/code] and ends the same or a later line with "
"[code]$$[/code].\n"
"Escape a literal dollar sign as [code]\\$[/code]. Inline code and fenced code keep their dollar "
"signs. If parsing a formula fails, its source is displayed as text. Text selection copies the "
"formula source, including its delimiters."
msgstr ""
"为 [code]true[/code] 时，使用 [TeXRender] 将 [code]$...$[/code] 渲染为行内公式。居中的块级公式从行首的 [code]$$[/code] "
"开始，并以同一行或后续行中的 [code]$$[/code] 结束。\n"
"使用 [code]\\$[/code] 转义美元符号。行内代码和围栏代码块中的美元符号按原文显示。解析公式失败时显示公式源码。复制选区时会保留公式源码及其定界符。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If set to something other than [constant TextServer.AUTOWRAP_OFF], rendered Markdown text wraps "
"inside the control bounds."
msgstr "设为 [constant TextServer.AUTOWRAP_OFF] 以外的值时，渲染后的 Markdown 文本会在控件范围内换行。"

#. doc_classes/LatexDocument.xml
msgid "Imported LaTeX document."
msgstr "导入的 LaTeX 文档。"

#. doc_classes/MermaidDocument.xml
msgid "Imported Mermaid document."
msgstr "导入的 Mermaid 文档。"

#. doc_classes/TeXRender.xml
msgid "Inline math style."
msgstr "行内公式样式。"

#. doc_classes/TeXRender.xml
msgid "Lays out and draws a LaTeX math expression on a [CanvasItem]."
msgstr "在 [CanvasItem] 上排版并绘制 LaTeX 数学表达式。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Loads Markdown text from the file at [param path] and sets it as the document content. Returns "
"[constant OK] on success, or an error code such as [constant ERR_FILE_CANT_OPEN] if the file "
"could not be opened. Emits [signal text_changed] on success."
msgstr ""
"从 [param path] 指定的文件读取 Markdown 文本并设为文档内容。成功时返回 [constant OK]，并发出 [signal text_changed]。无法打开文件时返回"
" [constant ERR_FILE_CANT_OPEN] 等错误码。"

#. doc_classes/LatexLabel3D.xml
msgid "Maintains the formula's apparent size as camera distance changes."
msgstr "摄像机距离改变时，保持公式的视觉大小。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Marks the layout as dirty and triggers a redraw. Call this after changing theme properties to "
"force a visual update."
msgstr "将布局标记为需要更新并触发重绘。主题属性改变后可调用此方法强制刷新。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Maximum number of lines from the end of the document that are re-parsed on each [method "
"append_text] call in streaming mode. Clamped to [code][1, 256][/code]."
msgstr "流式模式下，每次调用 [method append_text] 最多从文档末尾重新解析的行数。取值限制在 [code][1, 256][/code]。"

#. doc_classes/LatexLabel3D.xml
msgid "Minimum opacity for a texel to appear in alpha discard mode."
msgstr "Alpha 丢弃模式中保留纹素所需的最低不透明度。"

#. doc_classes/TeXRender.xml
msgid "Nested script math style."
msgstr "嵌套上下标样式。"

#. doc_classes/LatexLabel3D.xml
msgid "Number of draw flags."
msgstr "绘制标志的数量。"

#. doc_classes/LatexLabel3D.xml
msgid ""
"Offset from the node's origin in formula pixels. Positive X moves right and positive Y moves up "
"in local space."
msgstr "以公式像素为单位设置相对于节点原点的偏移。局部 X 轴正方向向右，Y 轴正方向向上。"

#. doc_classes/LatexLabel3D.xml
msgid ""
"Places the formula's left edge, center, or right edge at the node's origin. Fill uses the center "
"for a single formula."
msgstr "将公式的左边缘、中心或右边缘对齐到节点原点。填充模式下，单个公式居中。"

#. doc_classes/LatexLabel3D.xml
msgid "Places the formula's top edge, center, or bottom edge at the node's origin."
msgstr "将公式的上边缘、中心或下边缘对齐到节点原点。"

#. doc_classes/MermaidRender.xml
msgid "Renders Mermaid diagrams and exposes Merman's diagram data."
msgstr "渲染 Mermaid 图表并提供 Merman 的图表数据。"

#. doc_classes/TeXRender.xml
msgid ""
"Replaces the current layout with the parsed LaTeX expression and returns [constant OK] on "
"success. Empty or whitespace-only input clears the layout and returns [constant OK]. A parse "
"error clears the layout and can be read with [method get_render_error]."
msgstr ""
"用解析后的 LaTeX 表达式替换当前布局。成功时返回 [constant OK]。空输入或仅含空白的输入会清除布局并返回 [constant OK]。解析错误也会清除布局，错误信息可通过 "
"[method get_render_error] 读取。"

#. doc_classes/MarkdownLabel.xml
msgid "Represents the total number of menu items. Used for bounds checking."
msgstr "菜单项总数，用于检查索引范围。"

#. doc_classes/LatexLabel3D.xml
msgid ""
"Resolution multiplier for the formula texture, from [code]1.0[/code] to [code]4.0[/code]. The "
"formula's layout, alignment, and size in 3D stay the same. The longest texture edge is capped at "
"4096 pixels."
msgstr "公式纹理的分辨率倍率，范围为 [code]1.0[/code] 至 [code]4.0[/code]。3D 中的排版、对齐和尺寸由公式的逻辑尺寸决定。纹理长边上限为 4096 像素。"

#. doc_classes/MermaidRender.xml
msgid ""
"Returns Merman's runtime catalog, including supported operation IDs in "
"[code]capabilities.operation_ids[/code]. Returns an empty dictionary when the backend is "
"unavailable."
msgstr "返回 Merman 的运行时目录。支持的操作 ID 位于 [code]capabilities.operation_ids[/code]。后端不可用时返回空字典。"

#. doc_classes/MermaidRender.xml
msgid "Returns SVG, ASCII, or JSON output as a string. Returns an empty string for binary output."
msgstr "以字符串形式返回 SVG、ASCII 或 JSON 输出。二进制输出返回空字符串。"

#. doc_classes/TeXRender.xml
msgid "Returns [code]true[/code] if a formula layout is available."
msgstr "有可用的公式布局时返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if drag-and-drop of selected text is enabled. The default value is "
"[code]true[/code]."
msgstr "允许拖放选中的文本时返回 [code]true[/code]。默认值为 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if external links (http/https) are automatically opened in the system "
"browser."
msgstr "外部链接（http/https）会自动在系统浏览器中打开时，返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns [code]true[/code] if internal vertical scrolling is active."
msgstr "内部垂直滚动已启用时，返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if keyboard shortcuts (Ctrl+C, Ctrl+A) are enabled. The default value "
"is [code]true[/code]."
msgstr "启用键盘快捷键（Ctrl+C、Ctrl+A）时返回 [code]true[/code]。默认值为 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if scroll following for visible-character reveals is enabled. "
"MarkdownLabel currently exposes this for RichTextLabel API parity; it has no effect until "
"visible-character clipping is implemented."
msgstr "启用逐字显示时的滚动跟随，则返回 [code]true[/code]。MarkdownLabel 提供此属性以兼容 RichTextLabel API。实现按可见字符数裁剪前，该属性没有效果。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if streaming layout updates are coalesced instead of being applied on "
"every [method append_text] call."
msgstr "流式排版更新会合并处理时，返回 [code]true[/code]。启用后每次调用 [method append_text] 时无需立即更新布局。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns [code]true[/code] if streaming mode is enabled. The default value is [code]false[/code]."
msgstr "启用流式模式时返回 [code]true[/code]。默认值为 [code]false[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns [code]true[/code] if text selection is enabled. The default value is [code]true[/code]."
msgstr "启用文本选择时返回 [code]true[/code]。默认值为 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns [code]true[/code] if the context menu is currently visible."
msgstr "右键菜单当前可见时返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if the control reports its rendered content height as its minimum "
"height."
msgstr "控件将已渲染内容的高度作为最小高度时，返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if the document contains a Markdown heading anchor or a laid-out HTML "
"element with the given ID."
msgstr "文档中存在指定 ID 的 Markdown 标题锚点或已排版的 HTML 元素时，返回 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if the right-click context menu is enabled. The default value is "
"[code]false[/code]."
msgstr "启用右键菜单时返回 [code]true[/code]。默认值为 [code]false[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if the selection is automatically cleared when the node loses focus. "
"The default value is [code]true[/code]."
msgstr "节点失去焦点时会自动清除选区，则返回 [code]true[/code]。默认值为 [code]true[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns [code]true[/code] if the view follows appended content when it is already scrolled to the"
" bottom."
msgstr "视图位于底部并跟随新追加内容滚动时，返回 [code]true[/code]。"

#. doc_classes/MermaidRender.xml
msgid ""
"Returns a copy of Merman's metadata or structured error details for the last operation. For JSON "
"operations, read the operation's data with [method get_output_text]."
msgstr "返回上次操作的 Merman 元数据副本或结构化错误详情。JSON 操作的数据可通过 [method get_output_text] 读取。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the URI of the link at the given local position (relative to the MarkdownLabel), or an "
"empty string if no link is under the position."
msgstr "返回指定局部坐标处的链接 URI，坐标相对于 MarkdownLabel。该位置没有链接时返回空字符串。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the additional font size added to all text in the document. The default value is "
"[code]0[/code]."
msgstr "返回应用于文档全部文本的额外字号。默认值为 [code]0[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the autowrap space trimming flags."
msgstr "返回自动换行时的空格裁剪标志。"

#. doc_classes/TeXRender.xml
msgid ""
"Returns the baseline position as a fraction of the layout height. Returns [code]0.0[/code] for an"
" empty layout."
msgstr "返回基线位置占布局高度的比例。布局为空时返回 [code]0.0[/code]。"

#. doc_classes/TeXRender.xml
msgid "Returns the configured foreground color."
msgstr "返回设置的前景色。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the content margin in pixels. The default value is [code]16[/code]."
msgstr "返回内容边距，单位为像素。默认值为 [code]16[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the current autowrap mode. The default value is [constant TextServer.AUTOWRAP_WORD_SMART]."
msgstr "返回当前自动换行模式。默认值为 [constant TextServer.AUTOWRAP_WORD_SMART]。"

#. doc_classes/MermaidLabel.xml
msgid ""
"Returns the current diagram's rendering error. Returns an empty string while rendering or when "
"there is no error."
msgstr "返回当前图表的渲染错误。渲染期间或没有错误时返回空字符串。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the current raw Markdown text."
msgstr "返回当前的 Markdown 源文本。"

#. doc_classes/TeXRender.xml
msgid "Returns the current text size in pixels, or [code]0.0[/code] when there is no layout."
msgstr "返回当前字号，单位为像素。没有布局时返回 [code]0.0[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the currently selected plain text, or an empty string if nothing is selected."
msgstr "返回当前选中的纯文本。未选中文本时返回空字符串。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the deferred streaming layout flush interval in milliseconds. The default value is "
"[code]33[/code]."
msgstr "返回延迟流式排版的刷新间隔，单位为毫秒。默认值为 [code]33[/code]。"

#. doc_classes/TeXRender.xml
msgid "Returns the depth below the baseline in pixels, including any bottom inset and padding."
msgstr "返回基线下方的深度，单位为像素，包含底部内嵌距和留白。"

#. doc_classes/MermaidRender.xml
msgid ""
"Returns the diagnostic message for the last failed operation. Returns an empty string after a "
"successful operation."
msgstr "返回最近一次失败操作的诊断信息。操作成功时返回空字符串。"

#. doc_classes/TeXRender.xml
msgid ""
"Returns the distance from the top of the layout to its baseline in pixels, measured using the "
"layout's integer height."
msgstr "返回布局顶部到基线的距离，单位为像素，按布局的整数高度计算。"

#. doc_classes/TeXRender.xml
msgid ""
"Returns the effective insets in left, top, right, bottom order. Includes MicroTeX's automatic "
"insets when enabled."
msgstr "按左、上、右、下的顺序返回实际内嵌距。启用自动内嵌距时包含 MicroTeX 添加的部分。"

#. doc_classes/LatexLabel.xml
msgid ""
"Returns the error from the last attempt to lay out the expression. Returns an empty string if the "
"expression rendered successfully or is empty. The label lays out its expression after entering "
"the scene tree."
msgstr "返回上次排版表达式时的错误。表达式为空或渲染成功时返回空字符串。标签进入场景树后才会排版。"

#. doc_classes/LatexLabel3D.xml
msgid ""
"Returns the error from the last layout update, or an empty string on success. Formula changes are"
" applied on a deferred update."
msgstr "返回上次排版更新的错误信息。排版成功时返回空字符串。公式改动会在延迟更新时应用。"

#. doc_classes/TeXRender.xml
msgid "Returns the error message from the last parse attempt, or an empty string on success."
msgstr "返回上次解析的错误信息。解析成功时返回空字符串。"

#. doc_classes/LatexDocument.xml
#. doc_classes/MermaidDocument.xml
msgid "Returns the imported source text, including its original line breaks."
msgstr "返回导入的源文本，保留原有换行。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the internal [PopupMenu] used for the context menu. The menu is lazily created on first "
"access."
msgstr "返回右键菜单使用的内部 [PopupMenu]。首次访问时创建。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the internal horizontal scroll bar, or [code]null[/code] if the control has not been "
"created yet. Typically not useful since horizontal scrolling is disabled by default."
msgstr "返回内部水平滚动条。控件尚未创建时返回 [code]null[/code]。水平滚动默认禁用。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the internal vertical scroll bar, or [code]null[/code] if the control has not been "
"created yet."
msgstr "返回内部垂直滚动条。控件尚未创建时返回 [code]null[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Returns the list of Markdown heading anchors and IDs from laid-out HTML blocks in the document."
msgstr "返回文档中的 Markdown 标题锚点和已排版的 HTML 块内的元素 ID。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the maximum number of unstable lines used for incremental re-parsing. The default value "
"is [code]32[/code]."
msgstr "返回增量解析使用的最大未稳定行数。默认值为 [code]32[/code]。"

#. doc_classes/MermaidRender.xml
msgid "Returns the media type of the current output, such as [code]image/png[/code]."
msgstr "返回当前输出的媒体类型，例如 [code]image/png[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the number of rendered top-level Markdown blocks, or [code]0[/code] if the canvas has not"
" been created yet."
msgstr "返回已渲染的顶层 Markdown 块数量。绘制节点尚未创建时返回 [code]0[/code]。"

#. doc_classes/MermaidRender.xml
msgid "Returns the raw output bytes of the last successful operation."
msgstr "返回最近一次成功操作的原始输出字节。"

#. doc_classes/MermaidLabel.xml
msgid ""
"Returns the texture of the current diagram. Returns [code]null[/code] until a diagram renders "
"successfully. The texture has twice the logical display resolution."
msgstr "返回当前图表的纹理。在图表成功渲染前返回 [code]null[/code]。纹理分辨率是逻辑显示分辨率的两倍。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Returns the total content height in pixels, or [code]1.0[/code] if the canvas has not been "
"created yet."
msgstr "返回内容总高度，单位为像素。绘制节点尚未创建时返回 [code]1.0[/code]。"

#. doc_classes/TeXRender.xml
msgid "Returns the total layout height in pixels."
msgstr "返回布局的总高度，单位为像素。"

#. doc_classes/TeXRender.xml
msgid "Returns the total layout size in pixels."
msgstr "返回布局总尺寸，单位为像素。"

#. doc_classes/TeXRender.xml
msgid "Returns the total layout width in pixels."
msgstr "返回布局的总宽度，单位为像素。"

#. doc_classes/MermaidRender.xml
msgid "Returns whether the Merman backend is available in this build."
msgstr "返回当前构建是否支持 Merman 后端。"

#. doc_classes/LatexLabel3D.xml
msgid "Returns whether the specified draw flag is enabled."
msgstr "返回指定的绘制标志是否已启用。"

#. doc_classes/LatexLabel3D.xml
msgid "Sampling filter for the formula texture."
msgstr "公式纹理的采样滤镜。"

#. doc_classes/LatexLabel3D.xml
msgid "Scale of the transparency pattern in alpha hash mode."
msgstr "Alpha 哈希模式中透明图案的缩放比例。"

#. doc_classes/TeXRender.xml
msgid "Scales the current formula to [param text_size] pixels. Insets keep their current pixel values."
msgstr "将当前公式缩放至 [param text_size] 像素。内嵌距保留当前像素值。"

#. doc_classes/TeXRender.xml
msgid "Script math style."
msgstr "上下标样式。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Scrolls to the current search result (set by a previous [method search] call). [param align] "
"controls where the result appears in the viewport: [code]0.0[/code] (top) to [code]1.0[/code] "
"(bottom). Returns [code]false[/code] if there is no active search result."
msgstr ""
"滚动到当前搜索结果，由先前的 [method search] 调用设置。[param align] 控制结果在视口中的位置，从 [code]0.0[/code]（顶部）到 "
"[code]1.0[/code]（底部）。没有当前搜索结果时返回 [code]false[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Scrolls to the first Markdown heading or laid-out HTML element with the given anchor ID. Pass the"
" case-sensitive ID without [code]#[/code]. [param align] ranges from [code]0.0[/code] at the top "
"of the viewport to [code]1.0[/code] at the bottom. HTML anchors scroll their own containers "
"first and use CSS scroll margins for the Markdown viewport. With [member fit_content] enabled, this "
"scrolls the nearest ancestor [ScrollContainer] with vertical scrolling enabled, when present. "
"Returns [code]false[/code] if the anchor does not exist."
msgstr "滚动到第一个具有指定锚点 ID 的 Markdown 标题或已排版的 HTML 元素。ID 区分大小写，传入时省略 [code]#[/code]。"
"[param align] 从视口顶部的 [code]0.0[/code] 到底部的 [code]1.0[/code]。HTML 锚点先滚动自身的容器，"
"再以 CSS 滚动外边距计算 Markdown 视口中的位置。启用 [member fit_content] 后，"
"会滚动最近的启用了垂直滚动的祖先 [ScrollContainer]。锚点不存在时返回 [code]false[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Searches the document for [param text] starting from ([param from_line], [param from_column]). "
"[param flags] is a bitmask: [code]1[/code] = match case, [code]2[/code] = whole words, "
"[code]4[/code] = search backwards. Returns the line and column of the match as a [Vector2i], or "
"[code]Vector2i(-1, -1)[/code] if no match was found. The match is highlighted on screen."
msgstr ""
"从 ([param from_line], [param from_column]) 开始查找 [param text]。[param flags] 是位掩码：[code]1[/code] "
"表示区分大小写，[code]2[/code] 表示匹配整个单词，[code]4[/code] 表示向后搜索。返回匹配位置的行列坐标 [Vector2i]，没有匹配时返回 "
"[code]Vector2i(-1, -1)[/code]。匹配结果会在控件中高亮显示。"

#. doc_classes/HTMLInputElement.xml
msgid "A handle to an HTML input element."
msgstr "HTML 输入元素的句柄。"

#. doc_classes/HTMLDocument.xml
msgid ""
"Load an imported [code].html[/code] or [code].htm[/code] file, or create an [HTMLDocument] and "
"set its [member text]. Assign the resource to [member HTMLLabel.document] for automatic display. "
"Use [method create_layout] when drawing directly.\n"
"Scripts that previously called [code]HTMLDocument.new().parse(html)[/code] should call "
"[code]HTMLLayout.new().parse(html)[/code]. Each [HTMLLayout] keeps its own parsed document, "
"viewport, and drawing state.\n"
"The HTML importer embeds linked and imported CSS and records their textures and local [code"
"]@font-face[/code] fonts as resource dependencies for export. Reimport the HTML file after "
"changing a linked stylesheet.\n"
"Imported documents include local image dependencies from all media query branches. In a selected-"
"scenes export preset, add [code]addons/dockit/dockit.gdextension[/code] to the include "
"filter so the exported project can load Dockit classes."
msgstr ""
"加载导入的 [code].html[/code] 或 [code].htm[/code] 文件，或创建 [HTMLDocument] 并设置 [member text]。将资源赋给 [member HTMLLabel.document] 即可自动显示。直接绘制时使用 [method create_layout]。\n"
"原先调用 [code]HTMLDocument.new().parse(html)[/code] 的脚本可改为调用 [code]HTMLLayout.new().parse(html)[/code]。每个 [HTMLLayout] 独立持有解析后的文档、视口和绘制状态。\n"
"HTML 导入器嵌入链接和导入的 CSS，并将所用纹理及本地 [code]@font-face[/code] 字体记录为导出依赖。更改链接的样式表后请重新导入 HTML 文件。\n"
"导入资源包含全部媒体查询分支的本地图像依赖。选定场景导出时，请在包含过滤器中加入 [code]addons/dockit/dockit.gdextension[/code]，使导出的项目可以加载 Dockit 类。"

#. doc_classes/HTMLInputElement.xml
msgid ""
"Returns the end of the single-line text selection. Other input types and invalid handles return "
"[code]-1[/code]."
msgstr "返回单行文本选区的终点。其他输入类型和无效句柄返回 [code]-1[/code]。"

#. doc_classes/HTMLInputElement.xml
msgid ""
"Returns the start of the single-line text selection. Other input types and invalid handles return"
" [code]-1[/code]."
msgstr "返回单行文本选区的起点。其他输入类型和无效句柄返回 [code]-1[/code]。"

#. doc_classes/HTMLInputElement.xml
msgid ""
"Sets the single-line selection using Godot string character indices. Indices snap to grapheme "
"boundaries. Equal indices set the caret."
msgstr "使用 Godot 字符串字符索引设置单行文本选区。索引会对齐到字素边界。两个索引相等时设置光标位置。"

#. doc_classes/HTMLInputElement.xml
msgid ""
"The current checked state. Before a script or user sets it, the state follows the "
"[code]checked[/code] attribute."
msgstr "当前勾选状态。脚本或用户设置之前，状态随 [code]checked[/code] 属性变化。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the focused element, or [code]null[/code] when the label has no DOM focus. Removing the focused element "
"from the document clears focus and ends input method composition immediately. Reinserting it does not restore focus."
msgstr ""
"返回当前聚焦的元素。控件没有 DOM 焦点时返回 [code]null[/code]。聚焦元素移出文档时会立即失焦并结束输入法预编辑。"
"重新插入该元素后，需要再次聚焦。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Focuses a visible, enabled element from this label and scrolls it into view. Returns "
"[code]false[/code] if the element cannot receive focus."
msgstr "聚焦此控件中可见且已启用的元素并将其滚入视口。元素无法聚焦时返回 [code]false[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Emitted when the left mouse button is pressed and released over the same visible link without "
"dragging or scrolling, when Enter activates a focused link, or when [method activate_element] "
"activates a link. [param uri] is the link's original nonempty [code]href[/code]."
msgstr ""
"左键在同一可见链接上按下和松开且期间没有拖动或滚动、按 Enter 激活已聚焦的链接，或通过 [method activate_element] "
"激活链接时发出。[param uri] 为链接原始的非空 [code]href[/code]。"

#. doc_classes/HTMLLabel.xml doc_classes/MarkdownLabel.xml
msgid "Selects all text in the document."
msgstr "选中文档中的所有文本。"

#. doc_classes/LatexLabel3D.xml
msgid ""
"Set [member text] to a formula such as [code]\\"
"frac{1}{\\sqrt{x^2+1}}[/code]. [TeXRender] lays "
"out the formula and draws it to a transparent texture. The node displays the texture on a quad "
"facing local [code]+Z[/code].\n"
"[member font_size] sets the formula size in pixels and [member pixel_size] converts formula "
"pixels into local 3D units. Texture resolution is capped at 4096 pixels on its longest edge. The "
"node regenerates its mesh from the formula when entering the scene tree or when the text changes."
msgstr ""
"将 [member text] 设为公式，例如 [code]\\"
"frac{1}{\\sqrt{x^2+1}}[/code]。[TeXRender] 将公式排版后绘制到透明纹理。节点在面向局部 "
"[code]+Z[/code] 的四边形上显示该纹理。\n"
"[member font_size] 设置公式的像素字号，[member pixel_size] 将公式像素换算为局部 3D 单位。纹理的最长边最多为 4096 "
"像素。进入场景树或文本变化时，节点会按公式重新生成网格。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets an additional font size added to all text in the document. Clamped to the range [code][0, "
"16][/code]. Emits [signal extra_font_size_changed]."
msgstr "为文档中所有文本设置额外字号。取值限制在 [code][0, 16][/code]，并发出 [signal extra_font_size_changed]。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets autowrap space trimming flags. Only trim flags are stored."
msgstr "设置自动换行的空格裁剪标志。仅保存与空格裁剪相关的标志。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets how often deferred streaming layout updates are flushed. Clamped to the range [code][1, "
"1000][/code]. The default value is [code]33[/code]."
msgstr "设置执行延迟流式排版更新的间隔。取值限制在 [code][1, 1000][/code]。默认值为 [code]33[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets how rendered Markdown text wraps inside the control bounds."
msgstr "设置渲染后的 Markdown 文本如何在控件范围内换行。"

#. doc_classes/TeXRender.xml
msgid ""
"Sets insets in left, top, right, bottom order. When [param true_values] is [code]false[/code], "
"MicroTeX adds its automatic padding to the specified values. Pass [code]Vector4i(0, 0, 0, 0), "
"true[/code] for tight inline layout."
msgstr ""
"按左、上、右、下的顺序设置内嵌距。[param true_values] 为 [code]false[/code] 时，MicroTeX 会在指定值上加上自动留白。传入 "
"[code]Vector4i(0, 0, 0, 0), true[/code] 可获得紧凑的行内布局。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets the Markdown text to render. Emits [signal text_changed]. Resets the current selection and "
"search state."
msgstr "设置要渲染的 Markdown 文本。发出 [signal text_changed]，并重置选区和搜索状态。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets the content margin in pixels. Clamped to the range [code][0, 128][/code]. The default value "
"is [code]16[/code]."
msgstr "设置内容边距，单位为像素。取值限制在 [code][0, 128][/code]。默认值为 [code]16[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets the maximum number of unstable lines for incremental re-parsing in streaming mode. Clamped "
"to the range [code][1, 256][/code]. The default value is [code]32[/code]."
msgstr "设置流式模式下增量解析使用的最大未稳定行数。取值限制在 [code][1, 256][/code]。默认值为 [code]32[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether drag-and-drop of selected text is enabled."
msgstr "设置是否允许拖放选中的文本。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets whether external links (http/https) are automatically opened in the system default browser "
"when clicked."
msgstr "设置点击外部链接（http/https）时是否自动使用系统默认浏览器打开。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets whether internal vertical scrolling is active. When disabled, the internal vertical scroll "
"mode is disabled."
msgstr "设置是否启用内部垂直滚动。关闭后会禁用内部垂直滚动模式。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether keyboard shortcuts (Ctrl+C to copy, Ctrl+A to select all) are enabled."
msgstr "设置是否启用键盘快捷键（Ctrl+C 复制，Ctrl+A 全选）。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets whether scroll following for visible-character reveals is enabled. MarkdownLabel currently "
"exposes this for RichTextLabel API parity; it has no effect until visible-character clipping is "
"implemented."
msgstr "设置是否启用逐字显示时的滚动跟随。MarkdownLabel 提供此属性以兼容 RichTextLabel API。实现按可见字符数裁剪前，该属性没有效果。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets whether streaming layout updates are deferred and coalesced. This is useful for AI-style "
"token streaming, especially when [member fit_content] is enabled."
msgstr "设置是否延迟并合并流式排版更新。适用于 AI 聊天等逐段流式输出，尤其是在启用 [member fit_content] 时。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"Sets whether streaming mode is enabled. When [code]true[/code], [method append_text] performs "
"incremental re-parsing for better performance with real-time text output."
msgstr "设置是否启用流式模式。设为 [code]true[/code] 时，[method append_text] 会增量解析，以提升实时输出性能。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether text selection with the mouse is enabled."
msgstr "设置是否允许用鼠标选择文本。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether the control reports its rendered content height as its minimum height."
msgstr "设置控件是否将已渲染内容的高度作为最小高度。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether the right-click context menu is enabled."
msgstr "设置是否启用右键菜单。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether the text selection is automatically cleared when the node loses focus."
msgstr "设置节点失去焦点时是否自动清除选区。"

#. doc_classes/MarkdownLabel.xml
msgid "Sets whether the view follows newly appended content when the scroll bar is already at the bottom."
msgstr "设置滚动条已在底部时视图是否跟随新追加的内容滚动。"

#. doc_classes/LatexLabel3D.xml
msgid "Size of a formula pixel in local 3D units."
msgstr "单个公式像素在局部 3D 空间中的尺寸。"

#. doc_classes/MermaidLabel.xml
msgid "Solid outline color of diagram nodes."
msgstr "图表节点的纯色描边。"

#. doc_classes/LatexLabel3D.xml
msgid "Sort priority of the formula's material."
msgstr "公式材质的渲染排序优先级。"

#. doc_classes/LatexLabel.xml
#, python-brace-format
msgid ""
"The LaTeX expression to display when [member document] is unset. Supply the formula directly, for "
"example [code]\\sum_{n=1}^{10} n^2[/code]."
msgstr "未设置 [member document] 时显示的 LaTeX 表达式。直接填写公式源码，例如 [code]\\sum_{n=1}^{10} n^2[/code]。"

#. doc_classes/LatexLabel3D.xml
msgid "The LaTeX expression to display when [member document] is unset. Use the formula source directly."
msgstr "未设置 [member document] 时显示的 LaTeX 表达式。直接填写公式源码。"

#. doc_classes/LatexLabel.xml
#. doc_classes/LatexLabel3D.xml
msgid ""
"The LaTeX resource to display, such as an imported [code].tex[/code] file containing a math "
"expression. The formula updates when the resource changes or is reimported. Set this to "
"[code]null[/code] to use [member text]."
msgstr "要显示的 LaTeX 资源，例如包含数学表达式且已导入的 [code].tex[/code] 文件。资源变更或重新导入时会更新公式。设为 [code]null[/code] 后使用 [member text]。"

#. doc_classes/MarkdownLabel.xml
msgid "The Markdown text to render. Setting this property resets the selection and search state."
msgstr "要渲染的 Markdown 文本。设置此属性会重置选区和搜索状态。"

#. doc_classes/MermaidLabel.xml
msgid ""
"The Mermaid diagram source to display when [member document] is unset, for example "
"[code]flowchart LR; A[Start] --> B[Done][/code]."
msgstr "未设置 [member document] 时显示的 Mermaid 图表源码，例如 [code]flowchart LR; A[Start] --> B[Done][/code]。"

#. doc_classes/MermaidLabel.xml
msgid ""
"The Mermaid resource to display, such as an imported [code].mmd[/code] or [code].mermaid[/code] "
"file. The diagram updates when the resource changes or is reimported. Set this to "
"[code]null[/code] to use [member text]."
msgstr "要显示的 Mermaid 资源，例如已导入的 [code].mmd[/code] 或 [code].mermaid[/code] 文件。资源变更或重新导入时会更新图表。设为 [code]null[/code] 后使用 [member text]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"The content margin in pixels. Controls the padding between the MarkdownLabel edges and the "
"rendered content."
msgstr "内容边距，单位为像素。控制 MarkdownLabel 边缘与渲染内容之间的留白。"

#. doc_classes/MermaidLabel.xml
msgid "The default palette for the diagram."
msgstr "图表的默认配色。"

#. doc_classes/MermaidDocument.xml
msgid ""
"The editor imports UTF-8 [code].mmd[/code] files as [MermaidDocument] resources. Use [method "
"get_text] to read the Mermaid source."
msgstr ""
"编辑器会将 UTF-8 编码的 [code].mmd[/code] 文件导入为 [MermaidDocument] 资源。使用 [method get_text]"
" 读取 Mermaid 源文本。"

#. doc_classes/LatexDocument.xml
msgid ""
"The editor imports UTF-8 [code].tex[/code] files as [LatexDocument] resources. Use [method "
"get_text] to read the LaTeX source."
msgstr ""
"编辑器会将 UTF-8 编码的 [code].tex[/code] 文件导入为 [LatexDocument] 资源。使用 [method get_text] "
"读取 LaTeX 源文本。"

#. doc_classes/LatexLabel3D.xml
msgid "Tints the entire formula, including colors specified inside it."
msgstr "为整个公式着色，包括公式内部指定了颜色的部分。"

#. doc_classes/LatexLabel3D.xml
msgid "Uses a dither pattern for transparency."
msgstr "使用抖动图案表现透明度。"

#. doc_classes/LatexLabel3D.xml
msgid "Uses display math style when enabled and the compact inline math style when disabled."
msgstr "启用时使用独立公式样式，关闭时使用紧凑的行内公式样式。"

#. doc_classes/LatexLabel.xml
msgid "Uses display math style when enabled and the more compact inline math style when disabled."
msgstr "启用时使用独立公式样式，关闭时使用更紧凑的行内公式样式。"

#. doc_classes/MermaidLabel.xml
msgid "Uses the dark palette."
msgstr "使用深色配色。"

#. doc_classes/MermaidLabel.xml
msgid ""
"Uses the light palette with a dark theme font color and the dark palette with a light theme font "
"color."
msgstr "主题字体颜色较深时使用浅色配色，颜色较浅时使用深色配色。"

#. doc_classes/MermaidLabel.xml
msgid "Uses the light palette."
msgstr "使用浅色配色。"

#. doc_classes/LatexLabel.xml
msgid ""
"Uses the resource's font size and font color in preference to the theme. Changes to a shared "
"resource update the formula. The glyphs use the embedded math fonts."
msgstr "优先使用该资源的字号和字体颜色。共享资源发生变化时会更新公式。公式字形来自内置数学字体。"

#. doc_classes/PDFTexture.xml
msgid "A texture imported from a single PDF page."
msgstr "从单页 PDF 导入的纹理。"

#. doc_classes/PDFTexture.xml
msgid ""
"The Windows x64 editor can import a [code].pdf[/code] file as a [PDFTexture]. Select the page "
"and DPI in the Import dock, then use the resource anywhere a [Texture2D] is accepted. Exported "
"projects load the baked pixels without PDFium."
msgstr ""
"Windows x64 编辑器可以将 [code].pdf[/code] 文件导入为 [PDFTexture]。在导入面板中选择页码和 DPI 后，"
"即可在接受 [Texture2D] 的位置使用该资源。导出的项目直接加载烘焙后的像素，无需 PDFium。"

#. doc_classes/PDFTexture.xml
msgid "The resolution in dots per inch used to render the imported page."
msgstr "渲染导入页面时使用的分辨率，单位为每英寸点数。"

#. doc_classes/PDFTexture.xml
msgid "The imported page number, starting at 1."
msgstr "导入的页码，从 1 开始。"

#. doc_classes/PDFReader.xml
msgid "Allows consecutive search matches to overlap."
msgstr "允许连续搜索结果相互重叠。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]annotations[/code]. Reads the string or name at PDF dictionary [param key] on "
"annotation [param annotation_index] of [param page_index]. Returns an empty string when the value"
" is absent."
msgstr ""
"能力 [code]annotations[/code]。读取 [param page_index] 上索引为 [param annotation_index] 的注释字典中 [param "
"key] 对应的字符串或名称。缺少该值时返回空字符串。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]annotations[/code]. Returns annotations on [param page_index] with available "
"fields [code]index, subtype, flags, author, contents, subject, modified, rect, color, "
"interior_color, quads, vertices, ink_paths, line, border[/code]. Border components are horizontal"
" radius, vertical radius and width."
msgstr ""
"能力 [code]annotations[/code]。返回 [param page_index] 上的注释及可用字段 [code]index, subtype, flags, author, "
"contents, subject, modified, rect, color, interior_color, quads, vertices, ink_paths, line, "
"border[/code]。边框分量依次为水平半径、垂直半径和宽度。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]attachments[/code]. Returns attachment metadata with available fields "
"[code]index, name, description, mime_type, relationship, size, CreationDate, ModDate, "
"CheckSum[/code]. The size is in bytes."
msgstr ""
"能力 [code]attachments[/code]。返回附件元数据及可用字段 [code]index, name, description, mime_type, relationship,"
" size, CreationDate, ModDate, CheckSum[/code]。大小以字节为单位。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]attachments[/code]. Returns the decoded contents of attachment [param index] as "
"bytes."
msgstr "能力 [code]attachments[/code]。返回附件 [param index] 解码后的内容字节。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]core[/code]. Converts [param position] from the full bitmap at [param dpi] and "
"additional [param rotation] to a PDF point on [param page_index]."
msgstr ""
"能力 [code]core[/code]。将指定 [param dpi] 和额外 [param rotation] 下的整页位图像素坐标 [param position] 转换为 [param "
"page_index] 上的 PDF 点坐标。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]core[/code]. Converts a PDF point [param position] on [param page_index] to an "
"integer pixel position in the full bitmap at [param dpi] and additional [param rotation]."
msgstr ""
"能力 [code]core[/code]。将 [param page_index] 上的 PDF 点坐标 [param position] 转换为指定 [param dpi] 和额外 "
"[param rotation] 下的整页位图整数像素坐标。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]core[/code]. Renders [param page_index] at [param dpi] to an RGBA8 image over "
"[param background]. Use [param flags] from [enum RenderFlags]. Additional clockwise [param "
"rotation] must be 0, 90, 180, or 270 degrees. Output is limited to 8192 pixels per side and 64 "
"MiB. Form widgets require [code]forms[/code]."
msgstr ""
"能力 [code]core[/code]。以 [param dpi] 将 [param page_index] 渲染为 RGBA8 图像，底色为 [param "
"background]。[param flags] 使用 [enum RenderFlags] 中的标志。额外顺时针旋转 [param rotation] 可以是 0、90、180 或 270 "
"度。输出单边最长为 8192 像素，大小上限为 64 MiB。绘制表单控件需要 [code]forms[/code] 能力。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]core[/code]. Renders only [param region] of [param page_index]. Measure the "
"region from the top-left of the full bitmap at [param dpi] and additional [param rotation]. The "
"region must be inside the full page. The bitmap limits, [param flags] and [param background] work"
" as in [method render_page]."
msgstr ""
"能力 [code]core[/code]。只渲染 [param page_index] 的 [param region]。区域以指定 [param dpi] 和额外 [param "
"rotation] 下的整页位图左上角为原点，且必须位于整页范围内。位图限制、[param flags] 和 [param background] 与 [method render_page] "
"相同。"

#. doc_classes/PDFReader.xml
msgid "Capability [code]core[/code]. Returns the number of pages in the open document."
msgstr "能力 [code]core[/code]。返回当前文档的页数。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]document[/code]. Returns [code]page_index, size_pt, rotation, has_transparency, "
"label, boxes[/code] for [param page_index]. Rotation is in clockwise degrees. The "
"[code]boxes[/code] dictionary contains any available PDF point rectangles [code]media, crop, "
"bleed, trim, art, bounds[/code]."
msgstr ""
"能力 [code]document[/code]。返回 [param page_index] 对应的 [code]page_index, size_pt, rotation, "
"has_transparency, label, boxes[/code]。旋转角度以顺时针为正。[code]boxes[/code] 字典包含可用的 PDF 点坐标矩形 "
"[code]media, crop, bleed, trim, art, bounds[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]document[/code]. Returns [code]version[/code] (e.g. 17 for PDF 1.7), "
"[code]page_count[/code], [code]valid_cross_reference_table[/code], [code]permissions[/code], "
"[code]user_permissions[/code], [code]security_handler_revision[/code], [code]form_type[/code], "
"[code]tagged[/code], [code]language[/code], [code]permanent_id[/code], [code]changing_id[/code], "
"[code]trailer_ends[/code] and [code]viewer_preferences[/code]. Viewer preferences contain "
"[code]print_scaling[/code], [code]copies[/code], [code]duplex[/code] and "
"[code]print_page_range[/code]. File identifiers are raw bytes."
msgstr ""
"能力 [code]document[/code]。返回 [code]version[/code]（例如 PDF 1.7 的值为 "
"17）、[code]page_count[/code]、[code]valid_cross_reference_table[/code]、[code]permissions[/code]、[code]user_permissions[/code]、[code]security_handler_revision[/code]、[code]form_type[/code]、[code]tagged[/code]、[code]language[/code]、[code]permanent_id[/code]、[code]changing_id[/code]、[code]trailer_ends[/code]"
" 和 [code]viewer_preferences[/code]。查看器偏好包括 "
"[code]print_scaling[/code]、[code]copies[/code]、[code]duplex[/code] 和 "
"[code]print_page_range[/code]。文件标识为原始字节。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]document[/code]. Returns the available PDF information dictionary strings "
"[code]Title, Author, Subject, Keywords, Creator, Producer, CreationDate, ModDate[/code]."
msgstr ""
"能力 [code]document[/code]。返回 PDF 信息字典中可用的字符串 [code]Title, Author, Subject, Keywords, Creator, "
"Producer, CreationDate, ModDate[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]forms[/code]. Returns AcroForm widgets on [param page_index] with "
"[code]annotation_index, name, alternate_name, value, export_value, type, flags, checked, rect, "
"options[/code]. Each option contains [code]index, label, selected[/code]."
msgstr ""
"能力 [code]forms[/code]。返回 [param page_index] 上的 AcroForm 控件，字段为 [code]annotation_index, name, "
"alternate_name, value, export_value, type, flags, checked, rect, options[/code]。每个选项包含 "
"[code]index, label, selected[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]javascript[/code]. Returns document JavaScript actions with [code]index, name, "
"script[/code]. The script is returned as text."
msgstr "能力 [code]javascript[/code]。返回文档 JavaScript 动作的 [code]index, name, script[/code]，其中脚本以文本形式返回。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]navigation[/code]. Returns a bookmark tree. Each entry contains [code]title, "
"count, style, destination, action, children[/code] and optional [code]color[/code]. Destinations "
"and actions use the fields described in [method get_page_links]."
msgstr ""
"能力 [code]navigation[/code]。返回书签树。每个条目包含 [code]title, count, style, destination, action, "
"children[/code] 及可选的 [code]color[/code]。目标和动作字段参见 [method get_page_links]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]navigation[/code]. Returns destination dictionaries with [code]name[/code] and "
"the fields described in [method get_page_links]."
msgstr "能力 [code]navigation[/code]。返回目标字典数组，包含 [code]name[/code] 及 [method get_page_links] 所述字段。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]navigation[/code]. Returns explicit links on [param page_index] with [code]rect,"
" quads, destination, action[/code]. A destination can contain [code]page_index, view, parameters,"
" x, y, zoom[/code]. An action can contain [code]type, uri, file_path, destination[/code]. The "
"type and view are PDFium numeric codes. A remote destination may lack a resolvable page index."
msgstr ""
"能力 [code]navigation[/code]。返回 [param page_index] 上的显式链接，字段为 [code]rect, quads, destination, "
"action[/code]。目标可包含 [code]page_index, view, parameters, x, y, zoom[/code]。动作可包含 [code]type, uri, "
"file_path, destination[/code]。类型和视图采用 PDFium 数值代码。远程目标可能没有可解析的页索引。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]page_objects[/code]. Returns a tree of objects on [param page_index]. Common "
"fields are [code]path, type, marked_content_id, has_transparency, active, bounds, rotated_bounds,"
" transform, fill_color, stroke_color, stroke_width, line_join, line_cap, dash_phase, "
"dash_array[/code]. Text adds [code]text, font_size, text_render_mode, font[/code]. Font fields "
"are [code]family, base_name, embedded, flags, weight[/code]. Paths add [code]segments, fill_mode,"
" stroke[/code] and each segment has [code]type, point, close[/code]. Images add [code]pixel_size,"
" dpi, bits_per_pixel, color_space, filters[/code]. Form objects add [code]children[/code]. Use "
"[code]path[/code] for follow-up extraction."
msgstr ""
"能力 [code]page_objects[/code]。返回 [param page_index] 的对象树。通用字段为 [code]path, type, "
"marked_content_id, has_transparency, active, bounds, rotated_bounds, transform, fill_color, "
"stroke_color, stroke_width, line_join, line_cap, dash_phase, dash_array[/code]。文本还包括 [code]text, "
"font_size, text_render_mode, font[/code]，字体字段为 [code]family, base_name, embedded, flags, "
"weight[/code]。路径还包括 [code]segments, fill_mode, stroke[/code]，各线段包含 [code]type, point, "
"close[/code]。图像还包括 [code]pixel_size, dpi, bits_per_pixel, color_space, filters[/code]。表单对象还包括 "
"[code]children[/code]。可使用 [code]path[/code] 进一步提取对象数据。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]page_objects[/code]. Returns an RGBA8 image for the image object at [param "
"object_path] on [param page_index]. Enable [param rendered] to include the image matrix and mask."
" The bitmap limits from [method render_page] apply."
msgstr ""
"能力 [code]page_objects[/code]。返回 [param page_index] 上 [param object_path] 对应图像对象的 RGBA8 图像。启用 "
"[param rendered] 时应用图像矩阵和遮罩。位图限制与 [method render_page] 相同。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]page_objects[/code]. Returns stream bytes for the image object at [param "
"object_path] on [param page_index]. Enable [param decoded] to apply the PDF stream filters that "
"PDFium supports for this API."
msgstr ""
"能力 [code]page_objects[/code]。返回 [param page_index] 上 [param object_path] 对应图像对象的流字节。启用 [param "
"decoded] 时应用 PDFium 在此接口中支持的 PDF 流过滤器。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]page_objects[/code]. Returns the font program bytes PDFium uses for the text "
"object at [param object_path] on [param page_index]."
msgstr "能力 [code]page_objects[/code]。返回 PDFium 为 [param page_index] 上 [param object_path] 对应文本对象使用的字体程序字节。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]signatures[/code]. Returns [code]index, subfilter, time, reason, "
"doc_mdp_permission, byte_range[/code] for each signature. The byte range contains alternating "
"offsets and lengths."
msgstr ""
"能力 [code]signatures[/code]。返回各签名的 [code]index, subfilter, time, reason, doc_mdp_permission, "
"byte_range[/code]。字节范围由偏移量和长度交替组成。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]signatures[/code]. Returns the raw PDF signature contents at [param index] for "
"inspection."
msgstr "能力 [code]signatures[/code]。返回签名 [param index] 的 PDF 原始内容，供调用方检查。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]structure[/code]. Returns the tagged structure tree for [param page_index]. "
"Element fields are [code]type, title, alt_text, actual_text, language, id, expansion, "
"marked_content_id, marked_content_ids, attributes, children[/code]. Marked-content children may "
"contain just [code]marked_content_id[/code]. Attribute dictionaries map names to a "
"[code]type[/code] code and an optional [code]value[/code]."
msgstr ""
"能力 [code]structure[/code]。返回 [param page_index] 的标签结构树。元素字段为 [code]type, title, alt_text, "
"actual_text, language, id, expansion, marked_content_id, marked_content_ids, attributes, "
"children[/code]。标记内容子项可能仅含 [code]marked_content_id[/code]。属性字典以名称为键，每项包含 [code]type[/code] 代码和可选的"
" [code]value[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Counts PDFium character indices on [param page_index], including "
"generated separators."
msgstr "能力 [code]text[/code]。统计 [param page_index] 的 PDFium 字符索引数量，包含生成的分隔符。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Finds Unicode [param query] on [param page_index] using [param "
"flags] from [enum FindFlags]. Each match contains [code]start[/code] and [code]count[/code] in "
"PDFium characters and [code]rects[/code] in PDF points."
msgstr ""
"能力 [code]text[/code]。使用 [enum FindFlags] 中的 [param flags] 在 [param page_index] 搜索 Unicode [param "
"query]。每项结果包含 PDFium 字符索引 [code]start[/code]、数量 [code]count[/code] 及 PDF 点坐标矩形 "
"[code]rects[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Finds the character index near [param position] on [param "
"page_index] within the horizontal and vertical [param tolerance] in points. Returns -1 on a miss "
"or error."
msgstr ""
"能力 [code]text[/code]。按 [param tolerance] 给出的水平和垂直点坐标容差，查找 [param page_index] 上接近 [param position]"
" 的字符索引。未命中或出错时返回 -1。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Returns PDF point rectangles for [param count] characters starting "
"at [param start] on [param page_index]. A count of -1 selects to the end."
msgstr ""
"能力 [code]text[/code]。返回 [param page_index] 上从 [param start] 开始的 [param count] 个字符所对应的 PDF "
"点坐标矩形。数量为 -1 时选择到末尾。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Returns Unicode text on [param page_index] from [param start] for "
"[param count] PDFium characters. A count of -1 reads to the end. Unmapped characters can be "
"omitted from the resulting string."
msgstr ""
"能力 [code]text[/code]。读取 [param page_index] 上从 [param start] 开始的 [param count] 个 PDFium 字符，返回 "
"Unicode 文本。数量为 -1 时读取到末尾。返回字符串中可能省略无映射字符。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Returns Unicode text within the PDF point [param rect] on [param "
"page_index]."
msgstr "能力 [code]text[/code]。返回 [param page_index] 上 PDF 点坐标矩形 [param rect] 内的 Unicode 文本。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]text[/code]. Returns character data for [param char_index] on [param "
"page_index]. Fields include [code]index, unicode, generated, hyphen, unicode_map_error, angle, "
"font_size, font_weight, font_name, font_flags, bounds, loose_bounds, origin, transform, "
"fill_color, stroke_color[/code]. The angle is in radians."
msgstr ""
"能力 [code]text[/code]。返回 [param page_index] 上 [param char_index] 对应的字符数据。字段包括 [code]index, "
"unicode, generated, hyphen, unicode_map_error, angle, font_size, font_weight, font_name, "
"font_flags, bounds, loose_bounds, origin, transform, fill_color, stroke_color[/code]。角度以弧度为单位。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]thumbnail[/code]. Returns the embedded thumbnail for [param page_index] as "
"RGBA8, or [code]null[/code] if the page has none."
msgstr "能力 [code]thumbnail[/code]。返回 [param page_index] 的 RGBA8 内嵌缩略图。页面没有缩略图时返回 [code]null[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]web_links[/code]. Returns URLs detected in the text on [param page_index]. "
"Entries contain [code]uri, rects, start, count[/code]."
msgstr ""
"能力 [code]web_links[/code]。返回从 [param page_index] 文本中识别出的 URL。每项包含 [code]uri, rects, start, "
"count[/code]。"

#. doc_classes/PDFReader.xml
msgid ""
"Capability [code]xfa[/code]. Returns embedded XFA packets with [code]index, name, data[/code]. "
"Packet data is returned as bytes."
msgstr "能力 [code]xfa[/code]。返回内嵌 XFA 数据包的 [code]index, name, data[/code]，其中数据以字节形式返回。"

#. doc_classes/PDFReader.xml
msgid "Closes the current document and clears the last error. Safe to call repeatedly."
msgstr "关闭当前文档并清除错误。可重复调用。"

#. doc_classes/PDFReader.xml
msgid "Disables native text output."
msgstr "禁用原生文字输出。"

#. doc_classes/PDFReader.xml
msgid "Disables smoothing for images."
msgstr "禁用图像平滑。"

#. doc_classes/PDFReader.xml
msgid "Disables smoothing for paths."
msgstr "禁用路径平滑。"

#. doc_classes/PDFReader.xml
msgid "Disables smoothing for text."
msgstr "禁用文字平滑。"

#. doc_classes/PDFReader.xml
msgid "Draws AcroForm widget appearances."
msgstr "绘制 AcroForm 控件外观。"

#. doc_classes/PDFReader.xml
msgid "Draws ordinary page annotations."
msgstr "绘制普通页面注释。"

#. doc_classes/PDFReader.xml
msgid ""
"Each reader holds one document. Pages, characters, attachments, signatures and object paths use "
"zero-based indices. Geometry uses native PDF point coordinates with Y increasing upward. Pixel "
"coordinates use the top-left of the full rendered page. Results are Godot values and remain "
"usable after [method close].\n"
"Check [method get_capabilities] to discover available groups. A missing capability sets [constant"
" ERR_UNAVAILABLE]. If the document has no matching content, the method returns an empty result "
"with [constant OK]. Use [method get_last_error] to distinguish these cases. Fields for absent "
"optional data may be omitted.\n"
"PDF enum values in result dictionaries use the codes in the PDFium public headers. Embedded "
"scripts, XFA data and signature contents are returned for inspection."
msgstr ""
"每个读取器持有一份文档。页面、字符、附件、签名和对象路径均从 0 开始索引。几何数据使用原生 PDF 点坐标，Y 轴向上。像素坐标以完整渲染页面的左上角为原点。返回的 Godot 值在 "
"[method close] 之后仍可使用。\n"
"通过 [method get_capabilities] 查看可用能力。缺少对应能力时设为 [constant ERR_UNAVAILABLE]。文档中没有匹配内容时返回空结果并设为 "
"[constant OK]。用 [method get_last_error] 区分两种情况。缺少可选数据时可能省略对应字段。\n"
"返回字典中的 PDF 枚举值采用 PDFium 公开头文件中的代码。内嵌脚本、XFA 数据和签名内容供调用方检查。"

#. doc_classes/PDFReader.xml
msgid "Enables LCD text rendering."
msgstr "启用 LCD 文字渲染。"

#. doc_classes/PDFReader.xml
msgid "Forces halftone image scaling."
msgstr "强制使用半色调图像缩放。"

#. doc_classes/PDFReader.xml
msgid "Limits the PDFium image cache."
msgstr "限制 PDFium 图像缓存。"

#. doc_classes/PDFReader.xml
msgid "Matches letter case."
msgstr "匹配大小写。"

#. doc_classes/PDFReader.xml
msgid "Matches whole words."
msgstr "匹配完整单词。"

#. doc_classes/PDFReader.xml
msgid ""
"Opens [param path] through [FileAccess]. Supply [param password] for an encrypted document. A "
"failed attempt preserves the open document. Returns [constant OK] on success."
msgstr "通过 [FileAccess] 打开 [param path]。加密文档需要提供 [param password]。打开失败时保留当前文档。成功时返回 [constant OK]。"

#. doc_classes/PDFReader.xml
msgid ""
"Opens a PDF from [param bytes] with an optional [param password]. The reader retains the bytes "
"until the document closes. A failed attempt preserves the open document. Returns [constant OK] on"
" success."
msgstr "从 [param bytes] 打开 PDF，可以传入 [param password]。读取器保留字节直到关闭文档。打开失败时保留当前文档。成功时返回 [constant OK]。"

#. doc_classes/PDFReader.xml
msgid "Reads and renders PDF documents through PDFium."
msgstr "使用 PDFium 读取和渲染 PDF 文档。"

#. doc_classes/PDFReader.xml
msgid "Renders page content in grayscale."
msgstr "以灰度渲染页面内容。"

#. doc_classes/PDFReader.xml
msgid ""
"Returns available PDFium capability identifiers. The identifiers are [code]core, document, "
"thumbnail, text, navigation, web_links, annotations, forms, attachments, signatures, structure, "
"page_objects, javascript, xfa[/code]."
msgstr ""
"返回可用的 PDFium 能力标识。标识包括 [code]core, document, thumbnail, text, navigation, web_links, annotations,"
" forms, attachments, signatures, structure, page_objects, javascript, xfa[/code]。"

#. doc_classes/PDFReader.xml
msgid "Returns the last operation's diagnostic message, or an empty string on success."
msgstr "返回上一次操作的错误说明。成功时返回空字符串。"

#. doc_classes/PDFReader.xml
msgid ""
"Returns the last operation's error on this instance. A successful query clears the error, "
"including a query that finds no content."
msgstr "返回此实例上一次操作的错误码。查询成功时清除错误，即使结果为空。"

#. doc_classes/PDFReader.xml
msgid "Returns whether the core PDFium library can be loaded."
msgstr "返回 PDFium 核心库是否可以加载。"

#. doc_classes/PDFReader.xml
msgid "Returns whether this reader holds an open document."
msgstr "返回此读取器是否已打开文档。"

#. doc_classes/PDFReader.xml
msgid "Uses PDFium's print rendering mode."
msgstr "使用 PDFium 的打印渲染模式。"

#. doc_classes/PDFWriter.xml
msgid ""
"A writer holds one document and keeps edits in memory until saved. Page and list indices are "
"zero-based, except the ranges in [method import_page_range]. Geometry uses PDF points with the Y "
"axis increasing upward. Object, annotation and font IDs belong to the current writer. Saving and "
"changing the page order close all open edit pages and invalidate their IDs. Clipping, "
"transforming page content, or flattening closes the affected page. Changing an appearance stream "
"can invalidate its object IDs. Detached objects and fonts are released when the document closes. "
"PDFium supports detaching or removing direct children of a top-level Form. Detach a child before "
"editing its properties. Its transform is still relative to its previous Form, so adjust it before"
" placing the object on a page.\n"
"Capability identifiers are [code]document, save, pages, page_import, page_templates, "
"page_geometry, objects, paths, content_marks, fonts, text, images, annotations, "
"annotation_appearance, forms, flatten, attachments, catalog[/code]. A missing capability sets "
"[constant ERR_UNAVAILABLE]. Query [method get_last_error] and [method get_last_error_message] "
"after an operation fails. Mutations return [constant OK] on success unless otherwise documented. "
"New object, font, and annotation IDs are positive and return 0 on failure.\n"
"Full saves can invalidate existing signatures. Incremental saves retain the original bytes and "
"append an edited revision. Signature validity and permissions for a modified revision depend on "
"the original signature and must be checked separately. Form editing uses existing AcroForm "
"widgets."
msgstr ""
"每个写入器持有一份文档，编辑在保存前保留在内存中。页面和列表索引从零开始，[method import_page_range] 使用从一开始的范围。几何使用 PDF 点坐标，Y "
"轴向上。对象、注释和字体 ID 归当前写入器所有。保存和改变页面顺序会关闭所有打开的编辑页面，并使对应 ID 失效。裁剪、变换页面内容或压平会关闭受影响的页面。更改外观流可能使其对象 ID "
"失效。文档关闭时释放分离对象和字体。PDFium 支持分离或移除顶层 Form 的直接子对象。编辑属性前需先分离子对象。分离后其变换仍相对于原 Form，放入页面前请调整。\n"
"能力标识为 [code]document, save, pages, page_import, page_templates, page_geometry, objects, paths, "
"content_marks, fonts, text, images, annotations, annotation_appearance, forms, flatten, "
"attachments, catalog[/code]。能力缺失时设为 [constant ERR_UNAVAILABLE]。操作失败后可查询 [method get_last_error] 和"
" [method get_last_error_message]。除非另有说明，修改操作成功时返回 [constant OK]。新对象、字体和注释的 ID 为正数，失败时返回 0。\n"
"完整保存可能使现有签名失效。增量保存保留原始字节并追加编辑后的修订版。修改后的修订版是否符合签名及其权限取决于原签名，需要另行检查。表单编辑使用已有的 AcroForm 控件。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Appends detached path, text, or image [param "
"object_id] to the appearance of [param annotation_id]."
msgstr ""
"能力 [code]annotation_appearance[/code]。将分离的路径、文本或图像对象 [param object_id] 追加到 [param annotation_id] "
"的外观。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Removes and destroys appearance object [param "
"index] from [param annotation_id]."
msgstr "能力 [code]annotation_appearance[/code]。移除并销毁 [param annotation_id] 中索引为 [param index] 的外观对象。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Returns appearance object [param index] of [param "
"annotation_id]. PDFium supports Ink and Stamp appearance objects."
msgstr ""
"能力 [code]annotation_appearance[/code]。返回 [param annotation_id] 中索引为 [param index] 的外观对象 ID。PDFium"
" 支持墨迹和图章外观对象。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Returns the appearance object count of [param "
"annotation_id]."
msgstr "能力 [code]annotation_appearance[/code]。返回 [param annotation_id] 的外观对象数量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Sets the PDF appearance stream of [param "
"annotation_id] in [param mode] using a string. Pass [code]null[/code] in [param appearance] to "
"clear it. Use [enum AppearanceMode] constants."
msgstr ""
"能力 [code]annotation_appearance[/code]。用字符串设置 [param annotation_id] 在 [param mode] 下的 PDF 外观流。可在 "
"[param appearance] 传入 [code]null[/code] 清除外观。使用 [enum AppearanceMode] 常量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotation_appearance[/code]. Sets the font [param color] of a FreeText [param "
"annotation_id]."
msgstr "能力 [code]annotation_appearance[/code]。设置 FreeText 注释 [param annotation_id] 的字体颜色 [param color]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Adds an embedded file with [param name] and [param bytes] to"
" [param annotation_id]. An existing file attachment is replaced with the given bytes and retains "
"its name."
msgstr ""
"能力 [code]annotations[/code]。将名为 [param name]、内容为 [param bytes] 的文件嵌入 [param "
"annotation_id]。已有附件时替换其字节并保留文件名。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Adds an ink stroke from [param points] to [param "
"annotation_id]. Returns its index or -1 on failure."
msgstr "能力 [code]annotations[/code]。向 [param annotation_id] 添加由 [param points] 构成的墨迹笔画。返回索引，失败时返回 -1。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Appends a quad of four [param points] to [param "
"annotation_id]."
msgstr "能力 [code]annotations[/code]。向 [param annotation_id] 追加由四个 [param points] 构成的四边形。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Creates an annotation of [param subtype] on [param "
"page_index]. Use a code from [method get_supported_annotation_subtypes]."
msgstr ""
"能力 [code]annotations[/code]。在 [param page_index] 创建类型为 [param subtype] 的注释。使用 [method "
"get_supported_annotation_subtypes] 返回的代码。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Removes [param annotation_id] and invalidates its appearance"
" object IDs."
msgstr "能力 [code]annotations[/code]。移除 [param annotation_id]，并使其外观对象 ID 失效。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]annotations[/code]. Removes the ink list of [param annotation_id]."
msgstr "能力 [code]annotations[/code]。移除 [param annotation_id] 的墨迹列表。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Replaces attachment quad [param index] on [param "
"annotation_id] with four [param points] in PDFium order."
msgstr ""
"能力 [code]annotations[/code]。用 PDFium 顺序的四个 [param points] 替换 [param annotation_id] 中索引为 [param "
"index] 的附着四边形。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Returns [enum AnnotationSubtype] codes that the active "
"backend supports for creation."
msgstr "能力 [code]annotations[/code]。返回当前后端支持创建的 [enum AnnotationSubtype] 代码。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Returns the ID of annotation [param annotation_index] on "
"[param page_index]."
msgstr "能力 [code]annotations[/code]。返回 [param page_index] 上索引为 [param annotation_index] 的注释 ID。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Sets [param color] on [param annotation_id]. Enable [param "
"interior] for the interior color. For an existing appearance stream, edit its objects instead."
msgstr ""
"能力 [code]annotations[/code]。设置 [param annotation_id] 的颜色 [param color]。启用 [param interior] "
"可设置内部颜色。已有外观流时可编辑其中的对象。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]annotations[/code]. Sets the PDF point [param rect] of [param annotation_id]."
msgstr "能力 [code]annotations[/code]。设置 [param annotation_id] 的 PDF 点坐标矩形 [param rect]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Sets the [param radii] and [param width] of the border of "
"[param annotation_id] in points. PDFium may remove an existing appearance stream that overrides "
"the border."
msgstr ""
"能力 [code]annotations[/code]。以点为单位设置 [param annotation_id] 的边框半径 [param radii] 和宽度 [param "
"width]。PDFium 可能移除覆盖边框设置的已有外观流。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Sets the annotation [param flags] of [param annotation_id]. "
"Use [enum AnnotationFlags] constants."
msgstr ""
"能力 [code]annotations[/code]。设置 [param annotation_id] 的注释标志 [param flags]。使用 [enum "
"AnnotationFlags] 常量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Sets the link action of [param annotation_id] to the ASCII "
"[param uri]."
msgstr "能力 [code]annotations[/code]。将 [param annotation_id] 的链接动作设为 ASCII [param uri]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]annotations[/code]. Writes [param value] to a string entry [param key] on [param"
" annotation_id]. Use the dedicated methods for typed PDF entries."
msgstr ""
"能力 [code]annotations[/code]。将 [param value] 写入 [param annotation_id] 的字符串项 [param key]。有专用类型的 PDF"
" 项请使用对应方法。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]attachments[/code]. Adds a document attachment with [param name] and [param "
"bytes]. Returns its index or -1 on failure. Attachment indices can shift when entries change."
msgstr ""
"能力 [code]attachments[/code]。添加名为 [param name]、内容为 [param bytes] 的文档附件。返回其索引，失败时返回 "
"-1。条目变化时附件索引可能移动。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]attachments[/code]. Deletes document attachment [param index]."
msgstr "能力 [code]attachments[/code]。删除文档附件 [param index]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]attachments[/code]. Replaces document attachment [param index] with [param "
"bytes]."
msgstr "能力 [code]attachments[/code]。用 [param bytes] 替换文档附件 [param index] 的内容。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]attachments[/code]. Sets a supported PDFium string property [param key] on "
"document attachment [param index] to [param value]."
msgstr "能力 [code]attachments[/code]。将文档附件 [param index] 上 PDFium 支持的字符串属性 [param key] 设为 [param value]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]attachments[/code]. Sets the [param description] of document attachment [param "
"index]."
msgstr "能力 [code]attachments[/code]。设置文档附件 [param index] 的描述 [param description]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]catalog[/code]. Copies the viewer preferences from the open [param reader]."
msgstr "能力 [code]catalog[/code]。从已打开的 [param reader] 复制查看器偏好。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]catalog[/code]. Sets the document catalog [param language], for example [code"
"]zh-Hans[/code]."
msgstr "能力 [code]catalog[/code]。设置文档目录语言 [param language]，例如 [code]zh-Hans[/code]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]content_marks[/code]. Adds a content mark named [param name] to [param "
"object_id]. Returns its index or -1 on failure."
msgstr "能力 [code]content_marks[/code]。向 [param object_id] 添加名为 [param name] 的内容标记。返回标记索引，失败时返回 -1。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]content_marks[/code]. Adds the mark at [param mark_index] of [param "
"source_object_id] to [param object_id]. Consecutive objects can share one content mark in the "
"output."
msgstr ""
"能力 [code]content_marks[/code]。将 [param source_object_id] 中 [param mark_index] 对应的标记添加到 [param "
"object_id]。输出中连续的对象可共用一个内容标记。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]content_marks[/code]. Removes [param key] from mark [param mark_index] of [param"
" object_id]."
msgstr "能力 [code]content_marks[/code]。移除 [param object_id] 的标记 [param mark_index] 中的 [param key]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]content_marks[/code]. Removes [param mark_index] from [param object_id]. Later "
"mark indices can shift."
msgstr "能力 [code]content_marks[/code]。移除 [param object_id] 中索引为 [param mark_index] 的标记。后续标记索引可能移动。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]content_marks[/code]. Writes [param key] on mark [param mark_index] of [param "
"object_id]. [param value] accepts an integer, float, string, or byte array."
msgstr ""
"能力 [code]content_marks[/code]。写入 [param object_id] 的标记 [param mark_index] 中的 [param key]。[param "
"value] 接受整数、浮点数、字符串或字节数组。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]document[/code]. Creates an empty PDF and makes it the current document on "
"success."
msgstr "能力 [code]document[/code]。创建空白 PDF，成功后将其设为当前文档。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]flatten[/code]. Flattens supported annotation and form appearances on [param "
"page_index] into page content. Use a [enum FlattenMode] constant for [param mode]."
msgstr ""
"能力 [code]flatten[/code]。将 [param page_index] 上受支持的注释和表单外观压平到页面内容。为 [param mode] 使用 [enum "
"FlattenMode] 常量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]fonts[/code]. Loads a CID Type 2 font from [param data], a ToUnicode CMap [param"
" to_unicode], and the [param cid_to_gid] mapping bytes."
msgstr ""
"能力 [code]fonts[/code]。从 [param data]、ToUnicode CMap [param to_unicode] 和映射字节 [param cid_to_gid] "
"加载 CID Type 2 字体。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]fonts[/code]. Loads a standard PDF font by [param name], such as "
"[code]Helvetica[/code]."
msgstr "能力 [code]fonts[/code]。按 [param name] 加载标准 PDF 字体，例如 [code]Helvetica[/code]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]fonts[/code]. Loads font [param data] with [param type] from [enum FontType]. "
"Use [param cid] to create a composite CID font."
msgstr ""
"能力 [code]fonts[/code]。按 [enum FontType] 中的 [param type] 加载字体 [param data]。使用 [param cid] 可创建复合 "
"CID 字体。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]fonts[/code]. Releases [param font_id]. Existing text objects retain their fonts."
msgstr "能力 [code]fonts[/code]。释放 [param font_id]。现有文本对象保留其字体。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]forms[/code]. Replaces the text of existing AcroForm field [param annotation_id]"
" with [param text], then commits the change."
msgstr "能力 [code]forms[/code]。将现有 AcroForm 字段 [param annotation_id] 的文本替换为 [param text]，并提交修改。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]forms[/code]. Selects the existing AcroForm radio widget [param annotation_id]."
msgstr "能力 [code]forms[/code]。选中现有 AcroForm 单选控件 [param annotation_id]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]forms[/code]. Sets the field [param flags] of the AcroForm widget [param "
"annotation_id]. These are PDF field flags, independent of annotation flags."
msgstr "能力 [code]forms[/code]。设置 AcroForm 控件 [param annotation_id] 的字段标志 [param flags]。这些标志属于 PDF 表单字段。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]forms[/code]. Sets whether choice [param option_index] is [param selected] on "
"the AcroForm field [param annotation_id]."
msgstr ""
"能力 [code]forms[/code]。通过 [param selected] 设置 AcroForm 字段 [param annotation_id] 中的选项 [param "
"option_index] 是否选中。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]forms[/code]. Sets whether the existing AcroForm checkbox [param annotation_id] "
"is [param checked]."
msgstr "能力 [code]forms[/code]。通过 [param checked] 设置现有 AcroForm 复选框 [param annotation_id] 是否勾选。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]images[/code]. Creates a detached image object from JPEG [param bytes]."
msgstr "能力 [code]images[/code]。从 JPEG [param bytes] 创建分离的图像对象。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]images[/code]. Creates a detached image object from [param image]. Set its page "
"size and placement with [method set_object_matrix]."
msgstr "能力 [code]images[/code]。从 [param image] 创建分离的图像对象。用 [method set_object_matrix] 设置其页面大小和位置。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]images[/code]. Replaces [param object_id] pixels with [param image], preserving "
"its transform. The RGBA8 bitmap is limited to 8192 pixels per edge and 64 MiB."
msgstr ""
"能力 [code]images[/code]。用 [param image] 替换 [param object_id] 的像素并保留变换。RGBA8 位图单边最多 8192 像素，大小上限为 "
"64 MiB。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]images[/code]. Replaces [param object_id] with inline JPEG [param bytes], "
"preserving its transform."
msgstr "能力 [code]images[/code]。用内联 JPEG [param bytes] 替换 [param object_id]，并保留变换。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Applies [param transform] to [param object_id]."
msgstr "能力 [code]objects[/code]。对 [param object_id] 应用 [param transform]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Applies [param transform] to the clip path of [param object_id]."
msgstr "能力 [code]objects[/code]。对 [param object_id] 的裁剪路径应用 [param transform]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Detaches [param object_id] from its page or parent Form. The "
"object ID can be inserted again. Reacquire any descendant IDs. For a deeply nested object, detach"
" the containing Form first."
msgstr ""
"能力 [code]objects[/code]。从页面或父 Form 对象分离 [param object_id]。可用该 ID 重新插入对象。后代对象的 ID "
"需重新获取。对于多层嵌套的对象，先分离其所属的 Form。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Generates the PDF content stream for [param page_index]. Saving "
"also generates dirty pages automatically."
msgstr "能力 [code]objects[/code]。生成 [param page_index] 的 PDF 内容流。保存时也会自动生成已修改页面的内容流。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Inserts detached [param object_id] into [param page_index] at "
"[param at]. Pass -1 to append."
msgstr "能力 [code]objects[/code]。将分离对象 [param object_id] 插入 [param page_index] 的 [param at]。传入 -1 可追加。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Removes and destroys [param object_id], including a detached "
"object. Use [method remove_annotation_object] for an annotation appearance object."
msgstr ""
"能力 [code]objects[/code]。移除并销毁 [param object_id]，包括已分离的对象。注释外观对象使用 [method "
"remove_annotation_object]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Replaces the matrix of [param object_id] with [param transform]."
msgstr "能力 [code]objects[/code]。将 [param object_id] 的矩阵替换为 [param transform]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Returns child [param index] of the Form object [param object_id]."
msgstr "能力 [code]objects[/code]。返回 Form 对象 [param object_id] 中索引为 [param index] 的子对象 ID。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Returns the child count of the Form object [param object_id]."
msgstr "能力 [code]objects[/code]。返回 Form 对象 [param object_id] 的子对象数量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Returns the object ID at [param object_path] on [param "
"page_index]. Path components are zero-based indices into the page and nested Form objects."
msgstr ""
"能力 [code]objects[/code]。返回 [param page_index] 上 [param object_path] 对应的对象 ID。路径分量是页面和嵌套 Form 对象中从"
" 0 开始的索引。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Sets [param object_id] blend mode to the PDF name [param mode], "
"such as [code]Multiply[/code]."
msgstr "能力 [code]objects[/code]。将 [param object_id] 的混合模式设置为 PDF 名称 [param mode]，例如 [code]Multiply[/code]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Sets dash [param lengths] and [param phase] in points on [param "
"object_id]. An empty array makes a solid stroke."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的虚线长度 [param lengths] 和相位 [param phase]，单位为点。空数组表示实线。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Sets the fill [param color] of [param object_id]."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的填充颜色 [param color]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Sets the line [param cap] of [param object_id]. Use a [enum "
"LineCap] constant."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的线端 [param cap]。使用 [enum LineCap] 常量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Sets the line [param join] of [param object_id]. Use a [enum "
"LineJoin] constant."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的线连接 [param join]。使用 [enum LineJoin] 常量。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Sets the stroke [param color] of [param object_id]."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的描边颜色 [param color]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]objects[/code]. Sets the stroke [param width] of [param object_id] in points."
msgstr "能力 [code]objects[/code]。设置 [param object_id] 的描边宽度 [param width]，单位为点。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]objects[/code]. Sets whether [param object_id] is included when [param active] "
"is true."
msgstr "能力 [code]objects[/code]。通过 [param active] 设置是否包含 [param object_id]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_geometry[/code]. Applies [param transform] to all annotations on [param "
"page_index]."
msgstr "能力 [code]page_geometry[/code]。对 [param page_index] 上的所有注释应用 [param transform]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]page_geometry[/code]. Clips [param page_index] to [param rect]."
msgstr "能力 [code]page_geometry[/code]。将 [param page_index] 裁剪到 [param rect]。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_geometry[/code]. Sets [param box] of [param page_index] to [param rect]. "
"Use a [enum PageBox] constant."
msgstr ""
"能力 [code]page_geometry[/code]。将 [param page_index] 的 [param box] 设置为 [param rect]。使用 [enum "
"PageBox] 常量。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_geometry[/code]. Sets [param page_index] rotation to [param degrees] "
"clockwise. Accepts 0, 90, 180, and 270."
msgstr "能力 [code]page_geometry[/code]。将 [param page_index] 设为顺时针旋转 [param degrees] 度。可用值为 0、90、180 和 270。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_geometry[/code]. Transforms the contents of [param page_index] with [param "
"transform]. Pass a [Rect2] in [param clip] to also clip the page."
msgstr ""
"能力 [code]page_geometry[/code]。用 [param transform] 变换 [param page_index] 的内容。可向 [param clip] 传入 "
"[Rect2] 以裁剪页面。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_import[/code]. Copies pages from [param reader] at [param at]. [param "
"range] uses the one-based PDFium syntax, for example [code]1,3,5-7[/code]. An empty string "
"selects all pages. Pass -1 to append."
msgstr ""
"能力 [code]page_import[/code]。在 [param at] 从 [param reader] 复制页面。[param range] 使用从 1 开始的 PDFium "
"范围语法，例如 [code]1,3,5-7[/code]。空字符串选择全部页面。传入 -1 可追加。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_import[/code]. Copies pages from [param reader] in the order of [param "
"indices]. An empty array selects all pages. Pass -1 for [param at] to append."
msgstr ""
"能力 [code]page_import[/code]。从 [param reader] 按 [param indices] 顺序复制页面。空数组选择全部页面。[param at] 传入 -1 "
"可追加。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_templates[/code]. Creates a detached vector Form object from [param "
"page_index] in [param reader]. Call again to place multiple copies."
msgstr "能力 [code]page_templates[/code]。从 [param reader] 的 [param page_index] 创建分离的矢量 Form 对象。再次调用可放置多个副本。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]page_templates[/code]. Creates a new document by arranging pages from [param "
"reader] in a grid of [param columns] by [param rows] on pages of [param size_pt] points. Replaces"
" the current document on success."
msgstr ""
"能力 [code]page_templates[/code]。将 [param reader] 的页面按 [param columns] 列、[param rows] 行排列在大小为 "
"[param size_pt] 点的页面上。成功后替换当前文档。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]pages[/code]. Deletes the page at [param page_index]."
msgstr "能力 [code]pages[/code]。删除 [param page_index] 对应的页面。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]pages[/code]. Inserts a page of [param size_pt] points at [param at] and returns"
" its index. Pass -1 to append. Returns -1 on failure."
msgstr "能力 [code]pages[/code]。在 [param at] 插入大小为 [param size_pt] 点的页面，返回其索引。传入 -1 可追加。失败时返回 -1。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]pages[/code]. Moves [param indices] in the given order to position [param at] in"
" the remaining pages. Duplicate indices are invalid."
msgstr "能力 [code]pages[/code]。按给定顺序将 [param indices] 移动到剩余页面中的 [param at]。索引不得重复。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]paths[/code]. Adds a cubic Bézier segment to [param object_id] with controls "
"[param control_a] and [param control_b], ending at [param end]."
msgstr ""
"能力 [code]paths[/code]。向 [param object_id] 添加三次 Bézier 线段，控制点为 [param control_a] 和 [param "
"control_b]，终点为 [param end]。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]paths[/code]. Adds a line to [param point] in [param object_id]."
msgstr "能力 [code]paths[/code]。在 [param object_id] 中添加到 [param point] 的直线。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]paths[/code]. Closes the current subpath in [param object_id]."
msgstr "能力 [code]paths[/code]。闭合 [param object_id] 的当前子路径。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]paths[/code]. Creates a detached path beginning at [param start]."
msgstr "能力 [code]paths[/code]。创建从 [param start] 开始的分离路径。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]paths[/code]. Creates a detached rectangular path with bounds [param rect]."
msgstr "能力 [code]paths[/code]。创建范围为 [param rect] 的分离矩形路径。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]paths[/code]. Sets [param object_id] to [param fill_mode] and enables its stroke"
" with [param stroke]. Use a [enum FillMode] constant."
msgstr ""
"能力 [code]paths[/code]。为 [param object_id] 设置 [param fill_mode]，并用 [param stroke] 启用描边。使用 [enum "
"FillMode] 常量。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]paths[/code]. Starts a new subpath in [param object_id] at [param point]."
msgstr "能力 [code]paths[/code]。在 [param object_id] 的 [param point] 开始新的子路径。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]save[/code]. Saves the current document to a byte array. Use [enum SaveFlags] "
"for [param flags]. [param version] is zero for the SDK default or 10 through 17 for PDF 1.0 "
"through 1.7. Returns an empty array on failure."
msgstr ""
"能力 [code]save[/code]。将当前文档保存为字节数组。[param flags] 使用 [enum SaveFlags]。[param version] 为零时使用 SDK "
"默认值，10 至 17 对应 PDF 1.0 至 1.7。失败时返回空数组。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]save[/code]. Saves to [param path], replacing the destination after a successful"
" write. Use [param flags] and [param version] as in [method save_to_buffer]. The writer remains "
"open for further edits."
msgstr ""
"能力 [code]save[/code]。保存到 [param path]，写入成功后替换目标文件。[param flags] 和 [param version] 与 [method "
"save_to_buffer] 相同。写入器保持打开，可以继续编辑。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]text[/code]. Creates a detached text object using [param font_id], [param "
"font_size] in points, and [param text]. The caller can set the text position with [method "
"set_object_matrix]."
msgstr ""
"能力 [code]text[/code]。用 [param font_id]、以点为单位的 [param font_size] 和 [param text] 创建分离的文本对象。可通过 "
"[method set_object_matrix] 设置文本位置。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]text[/code]. Replaces [param object_id] text using font-specific unsigned 32-bit"
" [param charcodes]."
msgstr "能力 [code]text[/code]。用字体对应的无符号 32 位 [param charcodes] 替换 [param object_id] 的文本。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]text[/code]. Replaces the text in [param object_id] with [param text]. PDFium "
"requires a non-empty string."
msgstr "能力 [code]text[/code]。将 [param object_id] 的文本替换为 [param text]。PDFium 要求非空字符串。"

#. doc_classes/PDFWriter.xml
msgid "Capability [code]text[/code]. Sets [param object_id] font [param size] in points."
msgstr "能力 [code]text[/code]。设置 [param object_id] 的字体大小 [param size]，单位为点。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]text[/code]. Sets relative [param positions] in points for the characters of "
"[param object_id], excluding the first character at position zero."
msgstr "能力 [code]text[/code]。以点为单位设置 [param object_id] 中文字的相对 [param positions]，首字符固定在零位置。"

#. doc_classes/PDFWriter.xml
msgid ""
"Capability [code]text[/code]. Sets the text render [param mode] of [param object_id]. Use a [enum"
" TextRenderMode] constant."
msgstr "能力 [code]text[/code]。设置 [param object_id] 的文本渲染模式 [param mode]。使用 [enum TextRenderMode] 常量。"

#. doc_classes/PDFWriter.xml
msgid "Closes the document and discards unsaved edits. May be called repeatedly."
msgstr "关闭文档并丢弃未保存的编辑。可重复调用。"

#. doc_classes/PDFWriter.xml
msgid "Creates and edits PDF documents through PDFium."
msgstr "使用 PDFium 创建和编辑 PDF 文档。"

#. doc_classes/PDFWriter.xml
msgid ""
"Opens [param bytes] with the optional [param password]. The writer retains the input until the "
"document closes."
msgstr "使用可选的 [param password] 打开 [param bytes]。写入器保留输入字节直到文档关闭。"

#. doc_classes/PDFWriter.xml
msgid ""
"Opens [param path] with the optional [param password]. A failed open preserves the current "
"document."
msgstr "使用可选的 [param password] 打开 [param path]。失败时保留当前文档。"

#. doc_classes/PDFWriter.xml
msgid "Removes existing encryption during a full save."
msgstr "完整保存时移除已有加密。"

#. doc_classes/PDFWriter.xml
msgid "Requests PDFium font subsetting for newly added text."
msgstr "请求 PDFium 为新添加的文字生成字体子集。"

#. doc_classes/PDFWriter.xml
msgid "Returns the available writer capability groups. See the class description for their identifiers."
msgstr "返回可用的写入能力组。标识见类说明。"

#. doc_classes/PDFWriter.xml
msgid "Returns the last operation's diagnostic message."
msgstr "返回上一次操作的错误说明。"

#. doc_classes/PDFWriter.xml
msgid "Returns the last operation's error on this instance."
msgstr "返回此实例上一次操作的错误码。"

#. doc_classes/PDFWriter.xml
msgid "Returns the page count of the current document."
msgstr "返回当前文档的页数。"

#. doc_classes/PDFWriter.xml
msgid "Returns whether a document is open."
msgstr "返回是否已打开文档。"

#. doc_classes/PDFWriter.xml
msgid "Returns whether the PDFium backend can create, open, and save a document."
msgstr "返回 PDFium 后端是否可以创建、打开和保存文档。"

#. doc_classes/PDFWriter.xml
msgid ""
"Writes a copy with the original input bytes followed by the changes. Requires an opened PDF, the "
"default version and unchanged encryption."
msgstr "写入原始输入字节，再追加修改。需要已打开的 PDF、默认版本及原有加密。"

#. doc_classes/PDFWriter.xml
msgid "Writes a full PDF copy and preserves existing encryption."
msgstr "写入完整 PDF 副本并保留已有加密。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Draws the current layout during [method CanvasItem._draw]. Both the top-left drawing position and"
" the optional axis-aligned clip rectangle are in the canvas item's local coordinates. The default"
" clip applies only the document's clipping rules. Before a successful layout, this method draws "
"nothing."
msgstr ""
"在 [method CanvasItem._draw] "
"中绘制当前布局。绘制起点为左上角，与可选的轴对齐裁剪矩形均使用画布项的局部坐标。默认裁剪仅应用文档的裁剪规则。首次成功布局前，此方法不绘制内容。"

#. doc_classes/HTMLLayout.xml
msgid "Parses and lays out HTML for drawing on a [CanvasItem]."
msgstr "解析并排版 HTML，以便在 [CanvasItem] 上绘制。"

#. doc_classes/HTMLLayout.xml
msgid "Releases the document, layout, and drawing resources, and clears the last error."
msgstr "释放文档、布局及绘制资源，并清除上次错误。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Replaces the document and resets its layout. An empty string creates an empty document. Styles "
"come from inline attributes, [code]<style>[/code] elements, [code]<link "
"rel=\"stylesheet\">[/code], and the optional stylesheet text. Use [code]@import[/code] to include"
" UTF-8 [code].css[/code] files under the Godot resource or user data directory. Relative URLs in "
"a CSS file are resolved from that file's directory. Relative URLs in HTML and stylesheet text are"
" resolved from [param base_dir]. Asset URLs accept [code]res://[/code], [code]user://[/code], and"
" registered [code]uid://[/code] references. Images can be imported PNG, JPEG, WebP, or SVG "
"textures. Missing or unsupported assets are skipped. Returns [constant OK] on success, [constant "
"ERR_INVALID_PARAMETER] for a base directory outside [code]res://[/code] or [code]user://[/code], "
"or [constant ERR_PARSE_ERROR] if the document cannot be parsed.\n"
"The additional [param stylesheet] contributes author rules after the document's stylesheets. The "
"author cascade compares [code]!important[/code], inline style precedence, cascade layer, selector"
" specificity, and source order, in that order. A rule in the additional stylesheet wins by source"
" order when all earlier criteria are equal. In a document without author layers, "
"[code]revert[/code] and [code]revert-layer[/code] restore the pre-author defaults and HTML "
"presentational hints.\n"
"Invalid literal declarations are ignored. Custom properties and longhand declarations are "
"cascaded before [code]var()[/code] substitution. If substitution makes the winning value invalid,"
" that longhand uses [code]unset[/code]. A shorthand with [code]var()[/code] is resolved once per "
"element and only updates the longhands it wins. CSS-wide keywords produced by substitution are "
"evaluated as usual. On a custom property, the keyword is applied before substituting values that "
"reference that property."
msgstr ""
"替换文档并重置布局。空字符串会创建空文档。样式来自内联属性、[code]<style>[/code] 元素、[code]<link rel=\"stylesheet\">[/code] "
"和附加样式表。通过 [code]@import[/code] 加载 UTF-8 编码的 [code].css[/code] 文件。相对 URL 从样式表所在目录或 [param "
"base_dir] 解析。资源 URL 支持 [code]res://[/code]、[code]user://[/code] 及已注册的 "
"[code]uid://[/code]。缺失或不支持的资源会被跳过。成功时返回 [constant OK]，基目录不在 [code]res://[/code] 或 "
"[code]user://[/code] 时返回 [constant ERR_INVALID_PARAMETER]，文档无法解析时返回 [constant ERR_PARSE_ERROR]。\n"
"附加的 [param stylesheet] 在文档样式表之后提供作者规则。作者层叠依次比较 "
"[code]!important[/code]、内联样式优先级、层叠层、选择器权重和源码顺序。前几项相同时，附加样式表中的规则凭源码顺序胜出。文档没有作者层叠层时，[code]revert[/code]"
" 和 [code]revert-layer[/code] 恢复应用作者样式前的默认值及 HTML 表现属性。\n"
"忽略无效的字面声明。先确定自定义属性和各长属性的层叠结果，再替换 [code]var()[/code]。若替换使获胜值无效，该长属性按 [code]unset[/code] 计算。含 "
"[code]var()[/code] 的简写在每个元素上只求值一次，仅更新它仍然获胜的长属性。替换得出的 CSS "
"全局关键字按正常规则求值。自定义属性会先应用该关键字，再将结果代入引用它的属性值。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the content size in pixels from the most recent successful layout of the current "
"document, including scrollable overflow from CSS transforms. Returns [constant Vector2i.ZERO] before layout and for an empty document."
msgstr "返回当前文档最近一次成功布局的内容尺寸，单位为像素，包含 CSS 变换产生的可滚动溢出。布局前或文档为空时返回 [constant Vector2i.ZERO]。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the diagnostic message from the last failed parse or layout. A successful parse or layout"
" clears the message."
msgstr "返回最近一次解析或布局失败的诊断消息。成功解析或布局后清除该消息。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the original [code]href[/code] of the link at a point in document coordinates, or an "
"empty string. Subtract the drawing position from the canvas-local point and apply any caller-"
"supplied clip before querying. The caller handles navigation."
msgstr "返回文档坐标中指定点命中的链接的原始 [code]href[/code]，没有链接时返回空字符串。查询前，从画布局部坐标中减去绘制起点，并检查调用方指定的裁剪区域。导航由调用方处理。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Updates media queries and lays out the current document using the viewport width and height in "
"pixels. Returns [constant OK] on success, [constant ERR_INVALID_PARAMETER] for nonpositive "
"dimensions, [constant ERR_UNCONFIGURED] before a successful parse, or [constant ERR_INVALID_DATA] "
"if the layout cannot be represented."
msgstr ""
"更新媒体查询并按视口的像素宽高布局当前文档。成功时返回 [constant OK]，尺寸非正数时返回 [constant ERR_INVALID_PARAMETER]，尚未成功解析时返回 "
"[constant ERR_UNCONFIGURED]，布局结果无法表示时返回 [constant ERR_INVALID_DATA]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the attribute value, or [param default_value] if the attribute is absent. Attribute names are ASCII case-insensitive. An explicitly empty attribute returns an empty string."
msgstr "返回属性值。属性不存在时返回 [param default_value]。属性名称的 ASCII 字母不区分大小写。显式指定的空属性返回空字符串。"

#. doc_classes/HTMLElement.xml
msgid "Returns the union of the rectangles from [method get_client_rects], or an empty rectangle if there are no boxes."
msgstr "返回包含 [method get_client_rects] 所有矩形的最小矩形。没有布局盒时返回空矩形。"

#. doc_classes/HTMLElement.xml
msgid "Returns the direct child elements in document order. Text nodes, comments, and CSS-generated pseudo-elements are excluded."
msgstr "按文档顺序返回直接子元素，跳过文本节点、注释和 CSS 生成的伪元素。"

#. doc_classes/HTMLElement.xml
msgid "Returns the axis-aligned bounds of the element's border-box fragments in document pixel coordinates after CSS transforms and before clipping or label scrolling. An inline element may have multiple rectangles. The array is empty before layout or when the element has no layout box."
msgstr "以文档像素坐标返回元素各边框盒片段经 CSS 变换后的轴对齐外接矩形，坐标取自裁剪和控件滚动之前。行内元素可能有多个矩形。排版前或元素没有布局盒时返回空数组。"

#. doc_classes/HTMLElement.xml
msgid "Returns the parent element, or [code]null[/code] if this element has no parent."
msgstr "返回父元素。没有父元素时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the element's lowercase HTML tag name."
msgstr "返回元素的小写 HTML 标签名。"

#. doc_classes/HTMLElement.xml
msgid "Concatenates the parsed text nodes in document order, including hidden content. Comments and CSS-generated text are excluded. For the laid-out text of the document, see [method HTMLLayout.get_plain_text]."
msgstr "按文档顺序连接解析后的文本节点，包含隐藏内容，跳过注释和 CSS 生成的文本。获取排版后的文档文本请参见 [method HTMLLayout.get_plain_text]。"

#. doc_classes/HTMLElement.xml
msgid "Returns whether the element has an attribute with the given name, including an empty attribute."
msgstr "返回元素是否具有指定名称的属性，空属性也视为存在。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the frontmost element at the given document pixel position, accounting for overflow clipping. Returns [code]null[/code] when there is no hit or no layout."
msgstr "返回指定文档像素位置处最上层的元素，并考虑溢出裁剪。未命中或尚未排版时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the first element with the given case-sensitive HTML ID, including hidden elements. Pass the ID without [code]#[/code]. Returns [code]null[/code] if the ID is absent."
msgstr "返回第一个匹配指定 HTML ID 的元素，包括隐藏元素。ID 区分大小写，传入时省略 [code]#[/code]。ID 不存在时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the first match in document order, or [code]null[/code]. See [method query_selector_all] for selector syntax."
msgstr "按文档顺序返回第一个匹配项。无匹配时返回 [code]null[/code]。选择器语法见 [method query_selector_all]。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the element at the given position in this control's local coordinates. The scroll offset is applied automatically. Returns [code]null[/code] outside the content viewport, including the scrollbars, and when there is no hit or the layout is pending."
msgstr "返回控件局部坐标中指定位置处的元素，并自动应用滚动偏移。位置在内容视口之外（含滚动条区域）、未命中或布局待更新时返回 [code]null[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "Looks up a case-sensitive HTML ID in this label's parsed document. See [method HTMLLayout.get_element_by_id]."
msgstr "在控件解析后的文档中查找区分大小写的 HTML ID。参见 [method HTMLLayout.get_element_by_id]。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the first match in this label's parsed document. See [method HTMLLayout.query_selector]."
msgstr "返回控件解析后的文档中的第一个匹配项。参见 [method HTMLLayout.query_selector]。"

#. doc_classes/HTMLLabel.xml
msgid "Returns all matches in this label's parsed document. See [method HTMLLayout.query_selector_all]."
msgstr "返回控件解析后的文档中的全部匹配项。参见 [method HTMLLayout.query_selector_all]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Scrolls to an element obtained from this label, starting with its innermost scroll container. "
"[param align] places the top of the target's CSS scroll margin area from [code]0.0[/code] at "
"the top of the scroll-padding region to [code]1.0[/code] at its bottom, within the scrollable "
"range. Horizontal scrolling adjusts when the area's left edge is outside that region. "
"Returns [code]false[/code] for an invalid or foreign element, an element without a visible layout box, or a pending layout."
msgstr "滚动到从此控件获取的元素，从目标最内层的滚动容器开始。[param align] 将目标 CSS 滚动外边距区域的顶部"
"定位在滚动内边距区域顶部的 [code]0.0[/code] 和底部的 [code]1.0[/code] 之间，偏移限制在可滚动范围内。"
"目标区域左边缘超出该区域时会调整横向偏移。元素无效、属于其他布局、没有可见布局盒或布局待更新时返回 [code]false[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "Displays a scrollable HTML document."
msgstr "显示可滚动的 HTML 文档。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the horizontal and vertical scroll offset in pixels from the start of the document."
msgstr "返回相对于文档起点的水平和垂直滚动偏移，单位为像素。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the laid-out document size in pixels. Returns [constant Vector2i.ZERO] when there is no "
"valid layout or the document is empty."
msgstr "返回排版后的文档尺寸，单位为像素。布局无效或文档为空时返回 [constant Vector2i.ZERO]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the latest parsing or layout error, or an empty string on success. Errors are also shown "
"in the editor as node configuration warnings."
msgstr "返回最近一次解析或布局错误，成功时返回空字符串。编辑器也会以节点配置警告显示错误。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Sets the horizontal and vertical scroll offset in pixels, clamped to the scrollable range. If a "
"layout is pending, the offset is applied after that layout."
msgstr "设置水平和垂直滚动偏移，单位为像素，取值限制在可滚动范围内。如果正在等待布局，则在该次布局后应用偏移。"

#. doc_classes/HTMLLabel.xml
msgid "The HTML document or fragment to display."
msgstr "要显示的 HTML 文档或片段。"

#. doc_classes/HTMLDocument.xml
msgid "A shareable source document for static HTML."
msgstr "可共享的静态 HTML 源文档。"

#. doc_classes/HTMLPrintLayout.xml
msgid "A paginated print layout created from an [HTMLDocument]."
msgstr "从 [HTMLDocument] 创建的分页打印布局。"

#. doc_classes/HTMLDocument.xml
msgid "Creates a print layout from this resource. The layout uses print media queries, applies CSS [code]@page[/code] size and margins, and exposes page geometry in CSS pixels. The default page is A4 portrait with 10 mm margins. The optional dictionary accepts [code]page_size: Vector2[/code] in CSS pixels, [code]orientation[/code] as [code]portrait[/code] or [code]landscape[/code], [code]margin[/code] as a number, [code]Vector4(left, top, right, bottom)[/code], or a dictionary of side values, and [code]page_name[/code] for named [code]@page[/code] rules. Explicit options override CSS."
msgstr "从此资源创建打印布局。布局会应用打印媒体查询、CSS [code]@page[/code] 的尺寸和边距，并以 CSS 像素提供页面几何信息。默认纸张为 A4 纵向，边距为 10 毫米。可选字典接受以 CSS 像素表示的 [code]page_size: Vector2[/code]、值为 [code]portrait[/code] 或 [code]landscape[/code] 的 [code]orientation[/code]、数值形式的 [code]margin[/code]、[code]Vector4(left, top, right, bottom)[/code] 或按边指定值的字典，以及用于命名 [code]@page[/code] 规则的 [code]page_name[/code]。显式选项优先于 CSS。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Exports the paginated layout to a PDF file. Returns [constant OK] on success. PDF export requires a build with the PDFium writer backend."
msgstr "将分页布局导出为 PDF 文件。成功时返回 [constant OK]。PDF 导出要求构建中包含 PDFium 写入后端。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns print layout, resource, and PDF export limitations collected so far."
msgstr "返回目前收集到的打印布局、资源和 PDF 导出限制。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns the printable content rectangle within a page in CSS pixels."
msgstr "以 CSS 像素返回页面内的可打印内容矩形。"

#. doc_classes/HTMLPrintLayout.xml
msgid "The print layout waits for remote stylesheets and images before emitting [signal ready]. Page sizes and content rectangles are expressed in CSS pixels. Pagination honors [code]break-before[/code], [code]break-after[/code], and legacy [code]page-break-before[/code] and [code]page-break-after[/code] values that force a page break. It currently does not apply [code]break-inside[/code], column break values, [code]orphans[/code], or [code]widows[/code]. Page-specific content widths share one text reflow width. PDF export writes basic text, rectangular fills, circles, and images as PDF objects. Text is written with PDF standard Helvetica; glyphs it cannot encode, including CJK glyphs, are omitted. Some CSS transforms, overflow clips, and compositing effects are reported in [method get_diagnostics] and are not preserved."
msgstr "打印布局会等待远程样式表和图像处理完成后再发出 [signal ready]。页面尺寸和内容矩形均以 CSS 像素表示。分页会遵循用于强制分页的 [code]break-before[/code]、[code]break-after[/code] 以及旧式 [code]page-break-before[/code] 和 [code]page-break-after[/code] 值。目前尚未应用 [code]break-inside[/code]、分栏断点值、[code]orphans[/code] 或 [code]widows[/code]。不同页面的内容宽度共用同一个文字重排宽度。PDF 导出会将基础文字、矩形填充、圆形和图像写为 PDF 对象。文字使用 PDF 标准 Helvetica 字体；该字体无法编码的字形（包括中日韩字形）会被省略。部分 CSS 变换、溢出裁剪和合成效果会通过 [method get_diagnostics] 报告，但不会保留。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Additional CSS for [member text]. The rules share the document stylesheets' author origin and "
"follow them in source order. See [method HTMLLayout.parse]."
msgstr ""
"[member text] 的附加 CSS。它与文档样式表同属作者来源，源码顺序排在文档样式表之后。参见 [method HTMLLayout.parse]。"

#. doc_classes/HTMLDocument.xml
msgid ""
"Additional CSS for this document. The rules share the document stylesheets' author origin and "
"follow them in source order. See [method HTMLLayout.parse]."
msgstr "此文档的附加 CSS。它与文档样式表同属作者来源，源码顺序排在文档样式表之后。参见 [method HTMLLayout.parse]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Emitted when an enabled [code]<button type=\"button\">[/code] is activated by a mouse click, "
"Enter, Space, or [method activate_element]. Pressing and releasing over different descendants of "
"the same button can activate it. The signal passes an [HTMLButtonElement] handle."
msgstr ""
"已启用的 [code]<button type=\"button\">[/code] 通过鼠标点击、Enter、空格键或 [method activate_element] "
"激活时发出。在同一个按钮的不同后代上按下和松开也可以激活按钮。信号传入 [HTMLButtonElement] 句柄。"

#. doc_classes/HTMLLabel.xml
msgid "Clears the text selection."
msgstr "清除文本选区。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the selected plain text, or an empty string if nothing is selected."
msgstr "返回选中的纯文本。没有选区时返回空字符串。"

#. doc_classes/HTMLLabel.xml
msgid "If [code]true[/code], the caret in a focused text field blinks. If [code]false[/code], it stays visible while the field is focused."
msgstr "如果为 [code]true[/code]，聚焦的文本字段会显示闪烁的插入光标。如果为 [code]false[/code]，聚焦时插入光标常亮。"

#. doc_classes/HTMLLabel.xml
msgid "The time in seconds between changes in caret visibility when [member caret_blink] is enabled."
msgstr "启用 [member caret_blink] 时，插入光标每次切换显示状态的间隔，单位为秒。"

msgid "Chooses when CSS animations and transitions advance. Idle uses the idle frame delta, Physics uses the physics frame delta, and Manual uses calls to [method advance_animation]. Switching modes preserves the current progress and any remaining delay."
msgstr "选择 CSS 动画和过渡的推进方式。Idle 使用空闲帧的时间增量，Physics 使用物理帧的时间增量，Manual 通过调用 [method advance_animation] 推进。切换模式时保留当前进度和剩余延迟。"

msgid "Applies pending layout changes and advances CSS animations and transitions by [param delta] seconds while this label is in the scene tree. The delta must be finite and non-negative. Pass [code]0.0[/code] to apply pending changes at the current time. In Idle or Physics mode, this step adds to automatic updates."
msgstr "控件在场景树中时，应用待处理的布局变更并将 CSS 动画和过渡推进 [param delta] 秒。时间增量必须为有限非负数。传入 [code]0.0[/code] 可在当前时间应用待处理的变更。在 Idle 或 Physics 模式下，本次推进会叠加到自动更新。"

msgid "Advances CSS animations and transitions during idle processing."
msgstr "在空闲处理阶段推进 CSS 动画和过渡。"

msgid "Advances CSS animations and transitions during physics processing."
msgstr "在物理处理阶段推进 CSS 动画和过渡。"

msgid "Advances CSS animations and transitions through calls to [method advance_animation]."
msgstr "通过调用 [method advance_animation] 推进 CSS 动画和过渡。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Shows an editing menu for text inputs and textareas on right-click or with the [code]ui_menu[/code] input action. "
"Opening the menu commits any pending IME text as one undoable edit. Readonly fields offer Copy and Select All. "
"Keyboard editing shortcuts remain available when the menu is disabled."
msgstr ""
"右键点击文本框和多行文本框，或触发 [code]ui_menu[/code] 输入动作时，显示编辑菜单。"
"打开菜单会提交当前输入法预编辑文字，整段文字可以一次撤销。只读字段提供复制和全选。关闭菜单后，仍可使用键盘编辑快捷键。"

#. doc_classes/HTMLLabel.xml
msgid "Enables text selection. Disabling it clears the current selection."
msgstr "启用文本选择。关闭时清除当前选区。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the laid-out text in document order, using the original characters for the "
"[code]text-transform[/code] CSS property. Block boundaries and explicit line breaks are "
"represented by newlines. Preserved tab characters stay as tabs, and table cells are separated by tabs. Soft wrapping does not add "
"newlines. Returns an empty string before layout."
msgstr "按文档顺序返回排版后的文本。CSS 的 [code]text-transform[/code] 只改变字形，返回值保留原始字符。块边界和显式换行以换行符表示。保留的制表符仍为制表符，表格单元格也以制表符分隔。自动折行不会添加换行符。排版前返回空字符串。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns axis-aligned bounds in document coordinates for the visible highlights of the character range from [param from] "
"up to [param to]. These bounds account for CSS transforms and overflow clipping. Offsets refer to [method get_plain_text] and are clamped to its length."
msgstr "以文档坐标返回从 [param from] 到 [param to]（不含）的可见高亮区域的轴对齐外接矩形，包含 CSS 变换和溢出裁剪的影响。偏移量基于 [method get_plain_text]，并限制在文本长度内。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the nearest caret offset in [method get_plain_text] for a point in document coordinates. "
"Returns [code]0[/code] when there is no text."
msgstr "返回文档坐标中指定点在 [method get_plain_text] 内对应的最近光标偏移量。没有文本时返回 [code]0[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"If [code]true[/code], renders raw HTML blocks using [HTMLLayout], including blocks inside quotes "
"and list items. Supports inline bold, italic, strikethrough, code, highlights, line breaks, "
"links, and [code]span[/code] styles for text color and background color. Selection, copying, and "
"search include rendered HTML text alongside Markdown text. Clicking a link in HTML emits [signal "
"link_pressed]. The editor's Markdown preview enables this property.\n"
"HTML blocks use the theme's [code]text_font[/code], [code]text_font_color[/code], "
"[code]text_font_size[/code] (including [member extra_font_size]), and [code]link_color[/code] as "
"defaults. The theme's [code]bold_font[/code], [code]italic_font[/code], "
"[code]bold_italic_font[/code], [code]code_text_font[/code], and [code]code_block_font[/code] are "
"used for matching text styles when configured. CSS still controls the text style.\n"
"CSS transforms can extend an HTML block's height. Content extending sideways is clipped to the block's column width.\n"
"A linked stylesheet applies to the HTML block that includes it. Put the link and its styled elements in the same block. "
"When exporting raw Markdown that links to stylesheets, include the local [code].css[/code] files in the export preset.\n"
"Inline [code]<img>[/code] uses the same project image paths and formats as [HTMLLayout]. It "
"supports [code]src[/code], [code]alt[/code], [code]title[/code], and positive integer "
"[code]width[/code] and [code]height[/code] in pixels. With a single dimension, the image keeps "
"its aspect ratio."
msgstr ""
"为 [code]true[/code] 时，使用 [HTMLLayout] 渲染原始 HTML 块，包括引用和列表项内的 HTML 块。支持行内粗体、斜体、删除线、代码、高亮、换行、链接和 "
"[code]span[/code] 的文字颜色及背景色样式。渲染后的 HTML 文字和 Markdown 文字都支持选择、复制和搜索。点击 HTML 链接会发出 [signal "
"link_pressed]。编辑器的 Markdown 预览会开启此属性。\n"
"HTML 块默认使用主题的 [code]text_font[/code]、[code]text_font_color[/code]、[code]text_font_size[/code]（含 [member "
"extra_font_size]）和 [code]link_color[/code]。配置 [code]bold_font[/code]、[code]italic_font[/code]、"
"[code]bold_italic_font[/code]、[code]code_text_font[/code] 和 [code]code_block_font[/code] 后，对应的文字样式会使用这些字体。"
"文字样式仍由 CSS 控制。\n"
"CSS 变换可以增加 HTML 块的高度，横向内容会在块的列宽处裁剪。\n"
"链接的样式表作用于包含它的 HTML 块。请将链接和应用样式的元素放在同一个块中。"
"导出引用外部样式表的原始 Markdown 文件时，将本地 [code].css[/code] 文件加入导出预设。\n"
"行内 [code]<img>[/code] 与 [HTMLLayout] 支持相同的项目图片路径和格式。支持 "
"[code]src[/code]、[code]alt[/code]、[code]title[/code]，以及以像素为单位的正整数 [code]width[/code] 和 "
"[code]height[/code]。只指定一个尺寸时，图片会保持宽高比。"

#. doc_classes/HTMLDocument.xml
msgid ""
"Parses a snapshot of this resource into a new [HTMLLayout]. Call [method HTMLLayout.layout] with "
"the target viewport size, then [method HTMLLayout.draw] to display it. See [method "
"HTMLLayout.get_render_error] for parse or layout errors."
msgstr ""
"将此资源的快照解析为新的 [HTMLLayout]。使用目标视口尺寸调用 [method HTMLLayout.layout]，再用 [method HTMLLayout.draw] "
"显示。解析或布局错误见 [method HTMLLayout.get_render_error]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"The base directory in [code]res://[/code] or [code]user://[/code] for relative asset paths in "
"[member text]. See [method HTMLLayout.parse] for the supported paths and image formats."
msgstr ""
"用于解析 [member text] 相对资源路径的 [code]res://[/code] 或 [code]user://[/code] 基目录。支持的路径和图片格式见 [method "
"HTMLLayout.parse]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"The HTML resource to display. Its source and styles take priority over the local properties. Set "
"this to [code]null[/code] to use [member text], [member base_dir], and [member stylesheet]."
msgstr ""
"要显示的 HTML 资源。资源的源内容和样式优先于本地属性。设为 [code]null[/code] 时使用 [member text]、[member base_dir] 和 [member "
"stylesheet]。"

#. doc_classes/HTMLDocument.xml
msgid ""
"The base directory in [code]res://[/code] or [code]user://[/code] used for relative asset paths. "
"Imported resources use the source file's directory."
msgstr "用于解析相对资源路径的 [code]res://[/code] 或 [code]user://[/code] 基目录。导入资源使用源文件目录。"

#. doc_classes/HTMLDocument.xml
msgid "The source HTML document or fragment."
msgstr "HTML 源文档或片段。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the visual bounds of the first laid-out element with the given case-sensitive HTML "
"[code]id[/code], in document coordinates. Pass the ID without [code]#[/code]. Returns an empty "
"rectangle if the element has no layout or the ID is absent."
msgstr "返回第一个具有指定 HTML [code]id[/code] 的已排版元素的视觉边界，使用文档坐标。ID 区分大小写，传入时省略 [code]#[/code]。"
"元素尚未排版或 ID 不存在时返回空矩形。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Scrolls to a laid-out element by its case-sensitive HTML ID. Pass the ID without [code]#[/code]. "
"Alignment follows [method scroll_to_element], including CSS scroll padding and margins. "
"Each scroll container uses its own [code]scroll-behavior[/code]. "
"Returns [code]false[/code] if the ID is absent or the layout is pending."
msgstr "按区分大小写的 HTML ID 滚动到已排版的元素，传入 ID 时省略 [code]#[/code]。"
"对齐方式沿用 [method scroll_to_element]，包括 CSS 滚动内边距和外边距。"
"各滚动容器分别使用自身的 [code]scroll-behavior[/code]。"
"ID 不存在或布局尚未完成时返回 [code]false[/code]。"

#. doc_classes/HTMLElement.xml
msgid "A handle to an element in a parsed HTML layout."
msgstr "指向已解析 HTML 布局中某个元素的句柄。"

#. doc_classes/HTMLElement.xml
msgid ""
"Adds a case-sensitive class name if it is absent. The name must be a single non-empty token "
"without ASCII whitespace."
msgstr "添加尚未存在的区分大小写的类名。类名必须是单个非空名称，且不能含有 ASCII 空白字符。"

#. doc_classes/HTMLElement.xml
msgid ""
"Adds or updates the named HTML attribute. The value is stored as literal text. An empty value "
"leaves the attribute present."
msgstr "添加或更新指定的 HTML 属性。属性值按原文保存，空值也会保留该属性。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Emitted after a deferred layout update, when the new content size and scroll range can be "
"queried. Multiple element edits before the update are combined. The signal also reports a cleared"
" or failed layout and reflow caused by hover styles."
msgstr "延迟排版完成，且新内容尺寸和滚动范围可查询时发出。排版前的多次元素修改会合并。清空布局、排版失败或悬停样式触发重排时也会发出。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Emitted when a left mouse press and release hit the same visible HTML element without dragging or"
" scrolling. Use [method HTMLElement.closest] to find an ancestor with an action attribute. For a "
"link, the built-in anchor scroll and [signal link_pressed] run first. The element signal is "
"emitted if the target still belongs to the current document."
msgstr ""
"鼠标左键在同一个可见 HTML 元素上按下并松开且期间未拖动或滚动时发出。可用 [method HTMLElement.closest] "
"查找带有动作属性的祖先元素。点击链接时，先执行内置锚点滚动并发出 [signal link_pressed]。目标仍属于当前文档时才发出元素点击信号。"

#. doc_classes/HTMLElement.xml
msgid ""
"Appends [param child] to the end of this element's children and preserves the subtree's handles. "
"Accepts both unattached elements from [method HTMLLayout.create_element] and existing elements from the same layout. "
"Cycles, moving the document root, and inserting elements into tags that cannot contain them are rejected."
msgstr "将 [param child] 追加到当前元素的子元素末尾，并保留子树的句柄。接受同一布局中通过 [method HTMLLayout.create_element] 创建的新元素或已有元素。形成循环、移动文档根元素或插入到不能容纳元素的标签时会返回错误。"

#. doc_classes/HTMLElement.xml
msgid ""
"Obtain a handle from [method HTMLLayout.query_selector] or [method HTMLLabel.query_selector]. A "
"handle belongs to one layout at a time and stays valid across viewport resizes. It follows the element "
"when moved with [method HTMLLayout.adopt_node]. While a handle is held, "
"querying or hitting the same element in its current layout returns the same object. Parsing again, "
"clearing the owning layout, or freeing its owner invalidates it. An invalid handle returns empty results"
" or the supplied attribute default. Use these methods on the main thread.\n"
"Edits affect this layout only. Other views of the same [HTMLDocument] and the source resource are"
" unaffected. Queries and attribute reads see edits immediately. Geometry is available after the "
"next layout pass. [HTMLLabel] batches edits and emits [signal HTMLLabel.layout_changed] when the "
"new layout is ready. A standalone [HTMLLayout] with a previous viewport reflows on a deferred "
"call, or can be laid out immediately with [method HTMLLayout.layout].\n"
"Editing methods return [constant OK] on success and [constant ERR_INVALID_PARAMETER] for an "
"invalid handle or invalid arguments."
msgstr ""
"通过 [method HTMLLayout.query_selector] 或 [method HTMLLabel.query_selector] "
"获取句柄。句柄同一时间归一个布局所有，调整视口尺寸后仍然有效。通过 [method HTMLLayout.adopt_node] 迁移时，句柄会跟随元素。持有句柄期间，在当前布局中查询或命中同一个元素会返回同一对象。重新解析、清空所属布局或释放它后，句柄会失效。无效句柄返回空结果或传入的属性默认值。请在主线程调用这些方法。"
"\n"
"修改只作用于当前布局。同一 [HTMLDocument] 的其他视图及源资源保持原状。查询和属性读取会立即反映修改，几何信息在下次排版后可用。[HTMLLabel] 会合并修改，新布局就绪后发出"
" [signal HTMLLabel.layout_changed]。已有视口的独立 [HTMLLayout] 会延迟重排，也可调用 [method HTMLLayout.layout] "
"立即重排。\n"
"编辑成功时返回 [constant OK]。句柄或参数无效时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Parses [param html] in the context of this element and replaces its children. The replaced "
"descendants' handles become invalid. Empty HTML clears the children. Use [method "
"set_text_content] to insert literal text."
msgstr "在当前元素的上下文中解析 [param html] 并替换子内容。被替换的后代元素句柄会失效。空 HTML 会清空子内容。用 [method set_text_content] 插入纯文本。"

#. doc_classes/HTMLElement.xml
msgid "Removes the given class name if present. See [method add_class] for the name rules."
msgstr "移除已存在的指定类名。名称规则见 [method add_class]。"

#. doc_classes/HTMLElement.xml
msgid "Removes the named HTML attribute, if present. Attribute names are ASCII case-insensitive."
msgstr "移除已存在的指定 HTML 属性。属性名不区分 ASCII 大小写。"

#. doc_classes/HTMLElement.xml
msgid ""
"Removes this element and its subtree from their parent and invalidates their handles. Calling this method on an unattached element with no parent leaves it available for insertion. The document root cannot be removed."
msgstr "从父元素移除当前元素及其子树，并使其句柄失效。对尚未插入且没有父元素的元素调用此方法后，该元素仍可插入。文档根元素不能移除。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Creates an element owned by this layout after a successful [method parse]. Pass a tag name such as [code]li[/code] or [code]quest-card[/code]. ASCII letters in the name are lowercased. Returns [code]null[/code] if the name is invalid or there is no parsed document.\n"
"The new element has no parent. Set its attributes and content, then insert it using [method HTMLElement.append_child] on a parent from the same layout. Unattached elements are outside document queries and have no layout rectangles. On an empty document, the first creation also makes [code]html[/code], [code]head[/code], and [code]body[/code] available to queries."
msgstr ""
"[method parse] 成功后，创建归当前布局所有的元素。传入 [code]li[/code] 或 [code]quest-card[/code] 等标签名，名称中的 ASCII 字母会转换为小写。标签名无效或文档尚未解析时返回 [code]null[/code]。\n"
"新元素没有父元素。可以先设置属性和内容，再调用同一布局中父元素的 [method HTMLElement.append_child] 将其插入。未插入的元素不会出现在文档查询中，也没有布局矩形。在空文档中首次创建元素后，可以查询 [code]html[/code]、[code]head[/code] 和 [code]body[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Creates an unattached element in this label's layout. Parses any pending source first, so the new element and its parent can be prepared before the first layout update. Returns [code]null[/code] for an invalid name or a source that could not be parsed. See [method HTMLLayout.create_element].\n"
"[codeblock]\n"
"var item: HTMLElement = label.create_element(\"li\")\n"
"var list: HTMLElement = label.query_selector(\"#quests\")\n"
"if item != null and list != null:\n"
"\titem.set_attribute(\"data-quest\", \"intro\")\n"
"\titem.set_text_content(\"Find the entrance\")\n"
"\tlist.append_child(item)\n"
"[/codeblock]"
msgstr ""
"在当前控件的布局中创建尚未插入的元素。若源文档等待解析，会先完成解析，因此可以在首次排版前准备新元素并查询其父元素。标签名无效或源文档解析失败时返回 [code]null[/code]。参见 [method HTMLLayout.create_element]。\n"
"[codeblock]\n"
"var item: HTMLElement = label.create_element(\"li\")\n"
"var list: HTMLElement = label.query_selector(\"#quests\")\n"
"if item != null and list != null:\n"
"\titem.set_attribute(\"data-quest\", \"intro\")\n"
"\titem.set_text_content(\"Find the entrance\")\n"
"\tlist.append_child(item)\n"
"[/codeblock]"

#. doc_classes/HTMLElement.xml
msgid ""
"Replaces the children with literal text and invalidates the replaced descendants' handles. Empty "
"text clears the children."
msgstr "将子内容替换为纯文本，并使被替换的后代元素句柄失效。空文本会清空子内容。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns a snapshot of the element's HTML attributes. Keys and values are strings. An explicitly "
"empty attribute has an empty string value."
msgstr "返回元素 HTML 属性的快照，键和值均为字符串。显式指定的空属性值为空字符串。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns a snapshot of the element's [code]data-*[/code] attributes, using the same key conversion"
" as HTML dataset. For example, [code]data-item-id[/code] becomes [code]itemId[/code]."
msgstr ""
"返回元素 [code]data-*[/code] 属性的快照，键名沿用 HTML dataset 的转换规则。例如 [code]data-item-id[/code] 对应 "
"[code]itemId[/code]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns a snapshot of the matching descendants in document order, with each element included "
"once. [code]:scope[/code] refers to this element. Use [code]:scope > .title[/code] to select "
"direct children with the given class. See [method HTMLLayout.query_selector_all] for selector "
"syntax."
msgstr ""
"按文档顺序返回匹配的后代元素快照，每个元素只出现一次。[code]:scope[/code] 指当前元素。可用 [code]:scope > .title[/code] "
"选择带指定类名的直接子元素。选择器语法见 [method HTMLLayout.query_selector_all]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns the class names in attribute order. Class names are case-sensitive and appear once in the"
" result."
msgstr "按属性中出现的顺序返回类名。类名区分大小写，重复的类名只出现一次。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns the closest matching ancestor, starting with this element. [code]:scope[/code] refers to "
"this element. Returns [code]null[/code] if nothing matches."
msgstr "从当前元素开始向父级查找，返回最近的匹配项。[code]:scope[/code] 指当前元素。无匹配时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns the first matching descendant in document order, or [code]null[/code]. See [method "
"query_selector_all] for the query scope."
msgstr "按文档顺序返回第一个匹配的后代元素。无匹配时返回 [code]null[/code]。查询范围见 [method query_selector_all]。"

#. doc_classes/HTMLElement.xml
msgid "Returns whether the element has the given case-sensitive class name."
msgstr "返回元素是否包含指定的类名，区分大小写。"

#. doc_classes/HTMLElement.xml
msgid "Returns whether this element matches the selector. [code]:scope[/code] refers to this element."
msgstr "返回当前元素是否匹配选择器。[code]:scope[/code] 指当前元素。"

#. doc_classes/HTMLElement.xml
msgid ""
"Serializes the current children as HTML, including text and comments. CSS-generated content is "
"excluded. Escaping and attribute order can differ from the original source."
msgstr "将当前子内容序列化为 HTML，包含文本和注释，跳过 CSS 生成的内容。转义形式和属性顺序可能与源文本不同。"

#. doc_classes/HTMLElement.xml
msgid ""
"Toggles the given class name when [param force] is [code]null[/code]. Pass [code]true[/code] to "
"add it or [code]false[/code] to remove it. Use [method has_class] to read the resulting state."
msgstr ""
"[param force] 为 [code]null[/code] 时切换指定类名。传入 [code]true[/code] 添加类名，传入 [code]false[/code] 移除类名。用 "
"[method has_class] 查询操作后的状态。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns a copy of the CSS diagnostics collected during the latest style calculation. Each dictionary "
"contains [code]kind[/code], [code]property[/code], [code]value[/code], [code]source[/code], and [code]path[/code].\n"
"[code]kind[/code] is [code]unknown_property[/code], [code]unsupported_value[/code], or [code]not_rendered[/code]. "
"[code]source[/code] is [code]inline_style[/code], [code]style_element[/code], [code]stylesheet[/code], "
"[code]local_stylesheet[/code], or [code]remote_stylesheet[/code]. External stylesheets include a resource path or response URL in [code]path[/code]."
msgstr ""
"返回最近一轮样式计算收集的 CSS 诊断副本。每个字典包含 [code]kind[/code]、[code]property[/code]、"
"[code]value[/code]、[code]source[/code] 和 [code]path[/code]。\n"
"[code]kind[/code] 为 [code]unknown_property[/code]、[code]unsupported_value[/code] 或 [code]not_rendered[/code]。"
"[code]source[/code] 为 [code]inline_style[/code]、[code]style_element[/code]、[code]stylesheet[/code]、"
"[code]local_stylesheet[/code] 或 [code]remote_stylesheet[/code]。外部样式表的 [code]path[/code] 包含资源路径或响应 URL。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Collects CSS declaration diagnostics and outlines affected elements when drawing. Enable this before [method parse] to collect initial results, or "
"call [method layout] after enabling it on an existing document. Disabling it clears the results immediately. "
"See [method get_css_diagnostics]."
msgstr ""
"收集 CSS 声明诊断，并在绘制时标出受影响的元素。在 [method parse] 前启用可以收集初次解析的结果。对已有文档启用后，可调用 [method layout]。"
"关闭后立即清空结果。见 [method get_css_diagnostics]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns a copy of the CSS diagnostics for the current layout. See [method HTMLLayout.get_css_diagnostics] for the dictionary fields."
msgstr "返回当前布局的 CSS 诊断副本。字典字段见 [method HTMLLayout.get_css_diagnostics]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Outlines visible elements with CSS declaration diagnostics. Hover over an outlined element to read its diagnostics in an HTML tooltip. "
"Disabling this clears the outlines and results."
msgstr "为存在 CSS 声明诊断的可见元素绘制边框。悬停在标出的元素上，可在 HTML 提示面板中查看详情。关闭后清除边框和结果。"

#. doc_classes/HTMLElement.xml
msgid "Returns the CSS declaration diagnostics associated with this element in the current layout. See [method HTMLLayout.get_css_diagnostics] for the dictionary fields."
msgstr "返回当前布局中与本元素关联的 CSS 声明诊断。字典字段见 [method HTMLLayout.get_css_diagnostics]。"

#. doc_classes/HTMLTextAreaElement.xml
msgid "A handle to an HTML multiline text field."
msgstr "HTML 多行文本字段的句柄。"

#. doc_classes/HTMLTextAreaElement.xml
msgid "Returns the selection start, or [code]-1[/code] for an invalid textarea handle."
msgstr "返回选区起点。句柄无效时返回 [code]-1[/code]。"

#. doc_classes/HTMLTextAreaElement.xml
msgid "Returns the selection end, or [code]-1[/code] for an invalid textarea handle."
msgstr "返回选区终点。句柄无效时返回 [code]-1[/code]。"

#. doc_classes/HTMLTextAreaElement.xml
msgid ""
"Sets a multi-line selection using Godot string character indices. Indices snap to grapheme "
"boundaries. Visual line breaks do not change the indices."
msgstr "使用 Godot 字符串索引设置跨行选区。索引对齐到字素边界，视觉换行不会改变索引。"

#. doc_classes/HTMLTextAreaElement.xml
msgid "The child text used as the initial value."
msgstr "用作初始值的子文本。"

#. doc_classes/HTMLTextAreaElement.xml
msgid ""
"The current value with LF line endings. Setting it from script does not emit a user editing "
"signal."
msgstr "当前值使用 LF 换行。从脚本设置时不发出用户编辑信号。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when the user changes the value of a multiline text field."
msgstr "用户修改多行文本字段的值时发出。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when a multiline text field loses focus after a user edit."
msgstr "用户编辑多行文本字段后将焦点移出时发出。"

#. doc_classes/HTMLTextAreaElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<textarea>[/code]. Edit the "
"current value with [member value] and the source text with [member default_value]. A changed "
"value belongs to the current layout. Fields render in [HTMLLayout] and can be edited in "
"[HTMLLabel].\n"
"The default size uses [code]rows[/code] and [code]cols[/code]. CSS can override the size, "
"wrapping and [code]resize[/code] behavior. In [HTMLLabel], Enter inserts a newline and Tab moves "
"to the next focusable element. Drag the bottom-right handle to resize a field that allows it."
msgstr ""
"查询 [code]<textarea>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。使用 [member value] "
"编辑当前值，使用 [member default_value] 编辑源文本。修改后的当前值归当前布局所有。字段在 [HTMLLayout] 中绘制，在 [HTMLLabel] 中可以编辑。\n"
"默认尺寸由 [code]rows[/code] 和 [code]cols[/code] 决定。CSS 可以覆盖尺寸、换行和 [code]resize[/code] 行为。在 "
"[HTMLLabel] 中按 Enter 插入换行，按 Tab 移至下一个可聚焦元素。允许缩放时可拖动字段右下角的缩放柄。"

#. doc_classes/HTMLDivElement.xml
msgid "A handle to an HTML division element."
msgstr "HTML 容器元素的句柄。"

#. doc_classes/HTMLDivElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<div>[/code]. Use the "
"inherited [HTMLElement] methods to access its children, attributes, and layout geometry."
msgstr ""
"查询 [code]<div>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。"
"使用继承自 [HTMLElement] 的方法访问子元素、属性和排版几何。"

#. doc_classes/HTMLPreElement.xml
msgid "A handle to an HTML preformatted text element."
msgstr "HTML 预格式化文本元素的句柄。"

#. doc_classes/HTMLPreElement.xml
msgid "Represents a [code]<pre>[/code] element. Its default CSS preserves spaces and line breaks."
msgstr "表示 [code]<pre>[/code] 元素。默认 CSS 保留空格和换行。"

#. doc_classes/HTMLOListElement.xml
msgid "A handle to an HTML ordered list."
msgstr "HTML 有序列表的句柄。"

#. doc_classes/HTMLOListElement.xml
msgid "Represents an [code]<ol>[/code] element. Changing its reflected attributes updates the markers on the next layout."
msgstr "表示 [code]<ol>[/code] 元素。修改映射的 HTML 属性后，列表标记将在下一次排版时更新。"

#. doc_classes/HTMLOListElement.xml
msgid "If [code]true[/code], the [code]reversed[/code] attribute is present and numbering counts down."
msgstr "为 [code]true[/code] 时存在 [code]reversed[/code] 属性，编号按降序排列。"

#. doc_classes/HTMLOListElement.xml
msgid "The first item number. Reading a missing or invalid [code]start[/code] attribute returns [code]1[/code]. A reversed list with no explicit start counts down from its number of items when rendered."
msgstr "首项编号。[code]start[/code] 属性缺失或无效时读取为 [code]1[/code]。未指定起始值的倒序列表在渲染时从项目总数开始递减。"

#. doc_classes/HTMLOListElement.xml
msgid "The reflected marker type. Values [code]1[/code], [code]a[/code], [code]A[/code], [code]i[/code], and [code]I[/code] set the default numbering style. CSS can override it."
msgstr "映射的列表标记类型。[code]1[/code]、[code]a[/code]、[code]A[/code]、[code]i[/code] 和 [code]I[/code] 用于设置默认编号样式。CSS 可覆盖该样式。"

#. doc_classes/HTMLUListElement.xml
msgid "A handle to an HTML unordered list."
msgstr "HTML 无序列表的句柄。"

#. doc_classes/HTMLUListElement.xml
msgid "Represents a [code]<ul>[/code] element. Use the inherited [method HTMLElement.get_children] method to access its list items."
msgstr "表示 [code]<ul>[/code] 元素。通过继承的 [method HTMLElement.get_children] 方法访问列表项。"

#. doc_classes/HTMLLIElement.xml
msgid "A handle to an HTML list item."
msgstr "HTML 列表项的句柄。"

#. doc_classes/HTMLLIElement.xml
msgid "Represents a [code]<li>[/code] element in a list."
msgstr "表示列表中的 [code]<li>[/code] 元素。"

#. doc_classes/HTMLLIElement.xml
msgid "The reflected legacy marker type for this item. CSS can override it."
msgstr "映射的旧版列表项标记类型。CSS 可覆盖该样式。"

#. doc_classes/HTMLLIElement.xml
msgid "The explicit item number in an ordered list. Reading a missing or invalid [code]value[/code] attribute returns [code]0[/code]. Use [method HTMLElement.remove_attribute] to resume automatic numbering."
msgstr "有序列表中此项的显式编号。[code]value[/code] 属性缺失或无效时读取为 [code]0[/code]。调用 [method HTMLElement.remove_attribute] 恢复自动编号。"

#. doc_classes/HTMLParagraphElement.xml
msgid "A handle to an HTML paragraph element."
msgstr "HTML 段落元素的句柄。"

#. doc_classes/HTMLParagraphElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<p>[/code]. Use [method "
"HTMLElement.get_text_content] to read the paragraph's text."
msgstr ""
"查询 [code]<p>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。"
"使用 [method HTMLElement.get_text_content] 读取段落文字。"

#. doc_classes/HTMLSpanElement.xml
msgid "A handle to an HTML span element."
msgstr "HTML 行内容器元素的句柄。"

#. doc_classes/HTMLSpanElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<span>[/code]. Use the "
"inherited [HTMLElement] methods to read or modify its content, classes, and attributes."
msgstr ""
"查询 [code]<span>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。"
"使用继承自 [HTMLElement] 的方法读取或修改其内容、类名和属性。"

#. doc_classes/HTMLHeadingElement.xml
msgid "A handle to an HTML heading element."
msgstr "HTML 标题元素的句柄。"

#. doc_classes/HTMLHeadingElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<h1>[/code] through "
"[code]<h6>[/code]. Use [method get_level] to read its heading level."
msgstr ""
"查询 [code]<h1>[/code] 到 [code]<h6>[/code] 或通过 [method HTMLLayout.create_element] 创建它们时返回此句柄。"
"使用 [method get_level] 读取标题级别。"

#. doc_classes/HTMLHeadingElement.xml
msgid ""
"Returns the heading level from [code]1[/code] through [code]6[/code], or [code]0[/code] if the "
"handle is invalid."
msgstr "返回 [code]1[/code] 到 [code]6[/code] 之间的标题级别，句柄失效时返回 [code]0[/code]。"

#. doc_classes/HTMLAnchorElement.xml
msgid "A handle to an HTML anchor element."
msgstr "HTML 链接元素的句柄。"

#. doc_classes/HTMLAnchorElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<a>[/code]. Use [method "
"HTMLLabel.activate_element] to activate a link from script."
msgstr ""
"查询 [code]<a>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。使用 [method "
"HTMLLabel.activate_element] 从脚本激活链接。"

#. doc_classes/HTMLAnchorElement.xml
msgid "The original [code]href[/code] attribute. An empty or missing value cannot be activated."
msgstr "原始 [code]href[/code] 属性。值为空或缺失时无法激活链接。"

#. doc_classes/HTMLAnchorElement.xml
msgid "The descendant text content. Assigning a value replaces the children with plain text."
msgstr "后代文本内容。赋值时用纯文本替换所有子节点。"

#. doc_classes/HTMLButtonElement.xml
msgid "A handle to an HTML button element."
msgstr "HTML 按钮元素的句柄。"

#. doc_classes/HTMLButtonElement.xml
msgid ""
"Whether the [code]disabled[/code] attribute is present. Setting this to [code]false[/code] "
"removes the attribute."
msgstr "是否存在 [code]disabled[/code] 属性。设为 [code]false[/code] 时移除此属性。"

#. doc_classes/HTMLButtonElement.xml
msgid "The button's source [code]name[/code] attribute."
msgstr "按钮的源 [code]name[/code] 属性。"

#. doc_classes/HTMLButtonElement.xml
msgid "The button's source [code]type[/code] attribute. An absent attribute returns an empty string."
msgstr "按钮的源 [code]type[/code] 属性。属性缺失时返回空字符串。"

#. doc_classes/HTMLButtonElement.xml
msgid "The button's source [code]value[/code] attribute."
msgstr "按钮的源 [code]value[/code] 属性。"

#. doc_classes/HTMLImageElement.xml
msgid "A handle to an HTML image element."
msgstr "HTML 图片元素的句柄。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"Returns the intrinsic size in CSS pixels used by the current layout, including the effects of "
"image orientation, resolution, and source fragments. Returns [constant Vector2.ZERO] if layout is"
" pending, the handle is invalid or detached, or the image is unavailable."
msgstr "返回当前排版采用的固有尺寸，以 CSS 像素计，包含图片方向、分辨率与源片段的影响。排版尚未就绪、句柄失效、元素未插入或图片不可用时返回 [constant Vector2.ZERO]。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The source [code]alt[/code] attribute. If the selected texture is unavailable, nonempty "
"alternative text is drawn inside the image box. Text can wrap and determine automatic dimensions."
msgstr "源 [code]alt[/code] 属性。选中的纹理不可用时，非空替代文字会绘制在图片盒内。文字可以换行并决定自动尺寸。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The nonnegative integer pixel hint from the HTML [code]height[/code] attribute, or [code]0[/code]"
" if it is absent or invalid as an integer. CSS can override the hint."
msgstr "HTML [code]height[/code] 属性中的非负整数像素提示。属性缺失或值无效时返回 [code]0[/code]。CSS 可以覆盖该提示。"

#. doc_classes/HTMLImageElement.xml
msgid "The original [code]src[/code] attribute. Relative paths use the document's resource directory. Absolute HTTP(S) image URLs load asynchronously."
msgstr "原始 [code]src[/code] 属性。相对路径基于文档的资源目录解析。HTTP(S) 绝对图片地址会异步加载。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The nonnegative integer pixel hint from the HTML [code]width[/code] attribute, or [code]0[/code] "
"if it is absent or invalid as an integer. CSS can override the hint."
msgstr "HTML [code]width[/code] 属性中的非负整数像素提示。属性缺失或值无效时返回 [code]0[/code]。CSS 可以覆盖该提示。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<img>[/code]. Use [method "
"get_intrinsic_size] for the image's intrinsic dimensions and [method "
"HTMLElement.get_bounding_rect] for its visual rectangle.\n"
"Responsive images support [member srcset], [member sizes], and preceding [code]<source>[/code] "
"elements in a [code]<picture>[/code]. Selections use the layout viewport and the renderer's "
"[code]1x[/code] output density."
msgstr ""
"查询 [code]<img>[/code] 或通过 [method HTMLLayout.create_element] 创建它时返回此句柄。用 [method "
"get_intrinsic_size] 获取图片的固有尺寸，用 [method HTMLElement.get_bounding_rect] 获取视觉矩形。\n"
"响应式图片支持 [member srcset]、[member sizes]，以及 [code]<picture>[/code] 中位于图片之前的 [code]<source>[/code] "
"元素。选图使用排版视口和渲染器的 [code]1x[/code] 输出密度。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The selected resource path or HTTP(S) URL, including any fragment, from the last successful layout. "
"Empty before the first selection, when no source is selected, or for invalid or detached handles. "
"The selected source can still be loading or unavailable."
msgstr "最近一次成功排版选中的资源路径或 HTTP(S) URL，包含图片片段。首次选图前、未选中来源、句柄失效或元素未插入时返回空字符串。选中的图片可能仍在加载或不可用。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The source [code]sizes[/code] attribute used to evaluate width descriptors. Uses the first "
"matching source size and defaults to [code]100vw[/code]. An [code]auto[/code] entry is skipped."
msgstr "用于求值宽度描述符的源 [code]sizes[/code] 属性。采用第一条匹配的来源尺寸，默认值为 [code]100vw[/code]，并跳过 [code]auto[/code] 项。"

#. doc_classes/HTMLImageElement.xml
msgid ""
"The source [code]srcset[/code] attribute. Candidates accept width or pixel-density descriptors. "
"URLs follow the rules for [member src]."
msgstr "源 [code]srcset[/code] 属性。候选支持宽度或像素密度描述符。URL 沿用 [member src] 的规则。"

#. doc_classes/HTMLElement.xml
msgid ""
"Detaches this element from its parent and preserves existing handles to the whole subtree. Any "
"one of those handles keeps the detached subtree available for editing and reinsertion in the same"
" layout. Returns [constant OK] if already detached with no parent, or [constant "
"ERR_INVALID_PARAMETER] for the document root or an invalid handle."
msgstr ""
"将此元素从父元素分离，并保留整棵子树的已有句柄。持有其中任意一个句柄，即可继续在同一布局中编辑和重新插入该子树。元素已分离且没有父元素时返回 [constant OK]，文档根元素或无效句柄返回"
" [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Moves [param child] before the direct child [param reference]. If [param reference] is [code]null[/code], "
"appends the child. The moved subtree keeps its handles. See [method append_child] for insertion constraints."
msgstr ""
"将 [param child] 移到直接子元素 [param reference] 前面。如果 [param reference] 为 [code]null[/code]，"
"则追加到末尾。移动的子树保留其句柄。插入约束见 [method append_child]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Detaches the direct child [param child] while preserving the subtree's handles. See [method detach] "
"for the lifetime of a detached subtree."
msgstr ""
"分离直接子元素 [param child] 并保留其子树的句柄。分离子树的生命周期见 [method detach]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Moves [param new_child] into the position of the direct child [param old_child], then detaches the remaining "
"subtree of [param old_child]. Both subtrees keep their handles. Passing the same element for both arguments "
"leaves the tree unchanged."
msgstr ""
"将 [param new_child] 移到直接子元素 [param old_child] 的位置，再分离 [param old_child] 的剩余子树。"
"两棵子树均保留原有句柄。两个参数为同一元素时保持原有树结构。"

#. doc_classes/HTMLElement.xml
msgid ""
"Returns a detached copy in the same layout with a new handle. Attributes are copied as written, "
"including IDs. If [param deep] is [code]true[/code], copies descendants, including text and comments, "
"in their original order. Style and geometry are computed when the copy is inserted and laid out.\n"
"Inputs and text areas keep their current values and whether those values have been edited. Checkboxes "
"also keep their checked state and whether it has been edited. Text selection starts at offset zero. "
"A shallow text area copy retains its current value with empty default text.\n"
"Returns [code]null[/code] for an invalid handle."
msgstr ""
"返回同一布局中的分离副本，该副本拥有新句柄。属性按原样复制，包括 ID。如果 [param deep] 为 "
"[code]true[/code]，则按原顺序复制后代、文本和注释。副本插入并排版时会计算样式和几何信息。\n"
"输入框和文本区保留当前值及其修改标记。复选框也保留当前勾选状态及其修改标记。文本选区从偏移零开始。"
"文本区的浅拷贝保留当前值，且默认文本为空。\n"
"句柄无效时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Copies [param element] into this layout as a detached element with a new handle. The source can "
"belong to any layout. See [method HTMLElement.clone_node] for what [param deep] copies and how form "
"controls retain their state. The copy remains valid if the source layout is cleared.\n"
"Insert the copy under a parent in this layout to lay it out. Relative resource paths resolve from "
"this layout's base directory. On an empty document, the first import also makes [code]html[/code], "
"[code]head[/code], and [code]body[/code] available to queries.\n"
"Returns [code]null[/code] if the source handle is invalid or this layout has no successful [method parse]."
msgstr ""
"将 [param element] 复制到当前布局，得到拥有新句柄的分离元素。来源可以属于任意布局。"
"[param deep] 的复制范围和表单控件的状态保留规则见 [method HTMLElement.clone_node]。源布局清空后副本仍然有效。\n"
"将副本插入当前布局的父元素后即可排版。相对资源路径以当前布局的基目录解析。"
"空文档首次导入后也可以查询 [code]html[/code]、[code]head[/code] 和 [code]body[/code]。\n"
"来源句柄无效或当前布局尚未成功调用 [method parse] 时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Moves [param element] and its descendants to this layout and returns the same handle. Existing descendant "
"handles also follow the move. The subtree is detached and can be inserted under a parent in this layout. "
"Adopting within the same layout detaches the subtree.\n"
"Form controls keep their current values, modified flags, checked state, and selection. The source ends "
"focus and input method composition for the moved subtree and discards its pending input commit signals.\n"
"Moving a connected subtree schedules reflow in the source. The target lays it out when it is inserted "
"into the target document tree.\n"
"Returns [code]null[/code] if the handle is invalid, the element is the source document root, or the target "
"has no successful [method parse]."
msgstr ""
"将 [param element] 及其后代迁到当前布局，并返回同一个句柄。已有的后代句柄也会随之迁移。"
"子树处于分离状态，可插入当前布局中的父元素下。在同一布局中调用时会分离该子树。\n"
"表单控件保留当前值、修改标记、勾选状态和选区。源控件结束被迁移子树的焦点与输入法预编辑，并丢弃其待发出的输入提交信号。\n"
"移出已连接的子树会调度源布局重排。将子树插入目标文档树后，目标布局会对其排版。\n"
"句柄无效、元素是源文档根节点，或目标尚未成功调用 [method parse] 时返回 [code]null[/code]。"

#. doc_classes/HTMLDocumentFragment.xml
msgid "A detached collection of HTML elements for batch insertion."
msgstr "用于批量插入的分离 HTML 元素集合。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Create a fragment with [method HTMLLayout.create_document_fragment] or [method HTMLLabel.create_document_fragment]. "
"Add elements from the same layout with [method append_child]. Insert them through [method HTMLElement.append_fragment] "
"or [method HTMLElement.insert_fragment_before]. A successful insertion preserves the element handles and empties the "
"fragment for reuse.\n"
"Direct children are detached from the document and return [code]null[/code] from [method HTMLElement.get_parent] "
"while in the fragment. Clearing or reparsing the layout invalidates the fragment and the handles it still holds."
msgstr ""
"通过 [method HTMLLayout.create_document_fragment] 或 [method HTMLLabel.create_document_fragment] 创建片段。"
"使用 [method append_child] 添加同一布局中的元素，再用 [method HTMLElement.append_fragment] 或 "
"[method HTMLElement.insert_fragment_before] 插入。成功插入后保留元素句柄，并清空片段以供复用。\n"
"片段中的直接子元素与文档分离，调用 [method HTMLElement.get_parent] 返回 [code]null[/code]。"
"清空或重新解析布局时，片段及它仍持有的句柄会失效。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Moves [param child] to the end of the fragment. If the child was connected, its removal schedules a document update. "
"Returns [constant ERR_INVALID_PARAMETER] for an invalid fragment or child, a child from a different layout, or the document root."
msgstr ""
"将 [param child] 移到片段末尾。如果该子元素原先已连接到文档，移出时会调度文档更新。"
"片段或子元素无效、子元素来自其他布局，或子元素是文档根节点时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLDocumentFragment.xml
msgid "Returns a snapshot of the direct children in order, or an empty array if the fragment is invalid."
msgstr "按顺序返回直接子元素的快照。片段无效时返回空数组。"

#. doc_classes/HTMLLayout.xml
msgid "Creates an empty fragment owned by this layout. Returns [code]null[/code] if the layout has no successful [method parse]."
msgstr "创建属于当前布局的空片段。布局尚未成功调用 [method parse] 时返回 [code]null[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "Creates an empty fragment owned by this control's layout. See [method HTMLLayout.create_document_fragment]."
msgstr "创建属于当前控件布局的空片段。参见 [method HTMLLayout.create_document_fragment]。"

#. doc_classes/HTMLElement.xml
msgid "Appends all children of [param fragment] to this element. See [method insert_fragment_before]."
msgstr "将 [param fragment] 的全部子元素追加到当前元素。参见 [method insert_fragment_before]。"

#. doc_classes/HTMLElement.xml
msgid ""
"Moves all children of [param fragment] before the direct child [param reference]. If [param reference] is [code]null[/code], "
"appends them. The fragment must belong to this layout.\n"
"On success, the fragment is emptied and all moved handles are preserved. Moving a nonempty fragment into the document "
"schedules one layout update. Invalid arguments leave both trees unchanged and return [constant ERR_INVALID_PARAMETER]."
msgstr ""
"将 [param fragment] 的全部子元素移到直接子元素 [param reference] 前面。"
"如果 [param reference] 为 [code]null[/code]，则追加到末尾。片段必须属于当前布局。\n"
"成功后清空片段并保留所有移出的句柄。将非空片段插入文档会调度一次布局更新。"
"参数无效时两棵树保持原状，并返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLTemplateElement.xml
msgid "An HTML template that holds reusable content in a detached fragment."
msgstr "在分离片段中保存可复用内容的 HTML 模板。"

#. doc_classes/HTMLTemplateElement.xml
msgid ""
"Query a [code]<template>[/code] element or create one with [method HTMLLayout.create_element]. "
"Its content stays outside document queries and layout until inserted. To reuse a template, call "
"[method HTMLDocumentFragment.clone_node] with [code]true[/code] on [member content] and pass the "
"result to [method HTMLElement.append_fragment]. Each insertion empties the supplied fragment.\n"
"Use [method HTMLElement.get_inner_html] and [method HTMLElement.set_inner_html] to read or "
"replace the fragment's markup. Use [member content] for tree edits. The template itself accepts "
"no direct children. A shallow copy of the template has empty content. A deep copy includes its "
"content and any nested templates.\n"
"[method HTMLLayout.adopt_node] transfers the content fragment and its existing handles with the "
"template. Like the template, the fragment follows the lifetime of its owning layout."
msgstr "查询 [code]<template>[/code] 元素，或使用 [method HTMLLayout.create_element] 创建。插入前，模板内容不参与文档查询和布局。要复用模板，请在 [member content] 上以 [code]true[/code] 调用 [method HTMLDocumentFragment.clone_node]，再将返回的片段传给 [method HTMLElement.append_fragment]。每次插入都会清空传入的片段。\n使用 [method HTMLElement.get_inner_html] 和 [method HTMLElement.set_inner_html] 读取或替换片段标记。通过 [member content] 编辑元素树。模板元素本身不接受直接子节点。浅拷贝的模板内容为空，深拷贝包含内容及嵌套模板。\n[method HTMLLayout.adopt_node] 会连同片段及其已有句柄一起迁移模板。片段与模板都遵循所属布局的生命周期。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Returns a new detached fragment in the same layout. A deep copy includes all content in order, "
"including text and comments from a template. A shallow copy is empty. Returns [code]null[/code] "
"if this fragment is invalid."
msgstr "返回同一布局中的新分离片段。深拷贝按顺序复制全部内容，包括模板中的文本和注释。浅拷贝为空。片段无效时返回 [code]null[/code]。"

#. doc_classes/HTMLTemplateElement.xml
msgid ""
"The template's persistent content fragment. Returns [code]null[/code] if the template handle is "
"invalid."
msgstr "模板持有的内容片段。模板句柄无效时返回 [code]null[/code]。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Returns the first element in tree order with the given case-sensitive HTML ID. Supply the raw ID "
"without [code]#[/code]. Returns [code]null[/code] if the ID is absent, the ID is empty, or the "
"fragment is invalid. Nested template contents are searched through their own fragments."
msgstr ""
"按树顺序返回第一个具有指定 HTML ID 的元素，区分大小写。传入原始 ID，不带 [code]#[/code]。ID 缺失、为空或片段无效时返回 "
"[code]null[/code]。通过嵌套模板自己的片段查询其内容。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Returns the first matching element in tree order, or [code]null[/code] when nothing matches or "
"the fragment is invalid. See [method query_selector_all] for selector scope and syntax."
msgstr "按树顺序返回第一个匹配的元素。无匹配项或片段无效时返回 [code]null[/code]。选择器的作用域和语法见 [method query_selector_all]。"

#. doc_classes/HTMLDocumentFragment.xml
msgid ""
"Returns a snapshot of matching elements in tree order, with each element included once. "
"[code]:scope > .row[/code] selects direct children with the [code]row[/code] class. A query for "
"[code]:scope[/code] alone returns an empty array because the fragment root has no element handle."
"\n"
"A nested template can match as an element. Query its [member HTMLTemplateElement.content] "
"separately to find its contents. Invalid or unsupported selectors report a Godot error. An "
"invalid fragment or a selector with no matches returns an empty array. See [method "
"HTMLLayout.query_selector_all] for supported syntax."
msgstr ""
"按树顺序返回匹配元素的快照，每个元素只出现一次。[code]:scope > .row[/code] 选择具有 [code]row[/code] 类的直接子元素。单独查询 "
"[code]:scope[/code] 时返回空数组，因为片段根没有元素句柄。\n"
"嵌套模板元素可以匹配。通过它的 [member HTMLTemplateElement.content] 单独查询其内容。无效或不支持的选择器会报告 Godot "
"错误。片段无效或没有匹配项时返回空数组。支持的语法见 [method HTMLLayout.query_selector_all]。"

#. doc_classes/HTMLFormElement.xml
msgid "An HTML form with ordered form data."
msgstr "提供有序表单数据的 HTML 表单。"

#. doc_classes/HTMLFormElement.xml
msgid ""
"Use [method get_controls] to inspect associations and [method HTMLLabel.submit_form] to validate "
"and submit through Godot signals."
msgstr "使用 [method get_controls] 查看关联关系，使用 [method HTMLLabel.submit_form] 校验并通过 Godot 信号提交。"

#. doc_classes/HTMLFormElement.xml
msgid "Returns a tree-order snapshot of the associated controls."
msgstr "按树顺序返回关联控件的快照。"

#. doc_classes/HTMLFormElement.xml
msgid ""
"Restores all associated controls to their markup defaults, clears edit state, and schedules one "
"layout update when connected."
msgstr "将所有关联控件恢复到标记中的默认值，清除编辑状态，并在表单已连接时调度一次布局更新。"

#. doc_classes/HTMLLabelElement.xml
msgid "An HTML label for a form control."
msgstr "为表单控件提供标签的 HTML 元素。"

#. doc_classes/HTMLLabelElement.xml
msgid ""
"An explicit [code]for[/code] ID is resolved in the label's tree. An implicit label uses the first"
" labelable descendant."
msgstr "在标签所在的树中解析显式 [code]for[/code] ID。隐式标签使用第一个可标记后代。"

#. doc_classes/HTMLLabelElement.xml
msgid "Returns the labeled control or [code]null[/code]."
msgstr "返回关联的控件或 [code]null[/code]。"

#. doc_classes/HTMLLabelElement.xml
msgid "The raw [code]for[/code] attribute."
msgstr "原始的 [code]for[/code] 属性。"

#. doc_classes/HTMLFieldSetElement.xml
msgid "A group of HTML form controls."
msgstr "一组 HTML 表单控件。"

#. doc_classes/HTMLFieldSetElement.xml
msgid ""
"When disabled, the fieldset disables its controls except those inside its first direct "
"[HTMLLegendElement]."
msgstr "禁用分组时，分组中的控件也会禁用，但第一个直接 [HTMLLegendElement] 内的控件除外。"

#. doc_classes/HTMLButtonElement.xml
#. doc_classes/HTMLFieldSetElement.xml
#. doc_classes/HTMLInputElement.xml
#. doc_classes/HTMLSelectElement.xml
#. doc_classes/HTMLTextAreaElement.xml
msgid "Returns the associated form or [code]null[/code]."
msgstr "返回所属表单或 [code]null[/code]。"

#. doc_classes/HTMLFieldSetElement.xml
#. doc_classes/HTMLOptGroupElement.xml
#. doc_classes/HTMLOptionElement.xml
#. doc_classes/HTMLSelectElement.xml
msgid "Reflects the disabled attribute."
msgstr "反映源标记中的禁用属性。"

#. doc_classes/HTMLLegendElement.xml
msgid "The caption of an HTML fieldset."
msgstr "HTML 表单分组的标题。"

#. doc_classes/HTMLLegendElement.xml
msgid "The first direct legend in a fieldset defines the disabled-control exception."
msgstr "表单分组的第一个直接标题定义禁用例外。"

#. doc_classes/HTMLLegendElement.xml
msgid "Returns the enclosing fieldset's form or [code]null[/code]."
msgstr "返回所在分组的表单或 [code]null[/code]。"

#. doc_classes/HTMLSelectElement.xml
msgid "Returns the options as a tree-order snapshot of [HTMLOptionElement] handles."
msgstr "按树顺序返回 [HTMLOptionElement] 选项句柄的快照。"

#. doc_classes/HTMLSelectElement.xml
msgid "The name used for the form entry."
msgstr "表单条目使用的名称。"

#. doc_classes/HTMLSelectElement.xml
msgid "Whether submission requires a selection other than the placeholder."
msgstr "是否必须选择占位项以外的选项才能提交。"

#. doc_classes/HTMLSelectElement.xml
msgid "Zero-based selected index. [code]-1[/code] means no selection."
msgstr "从零开始的选中索引。[code]-1[/code] 表示未选择。"

#. doc_classes/HTMLOptionElement.xml
msgid "An option in an HTML dropdown."
msgstr "HTML 下拉框中的选项。"

#. doc_classes/HTMLOptionElement.xml
msgid "The current selection is independent of the default selection attribute."
msgstr "当前选中状态与默认选中属性独立。"

#. doc_classes/HTMLOptionElement.xml
msgid "The value attribute, falling back to normalized option text."
msgstr "值属性，缺省时使用规范化后的选项文本。"

#. doc_classes/HTMLOptionElement.xml
msgid "The display label, falling back to normalized option text."
msgstr "显示标签，缺省时使用规范化后的选项文本。"

#. doc_classes/HTMLOptionElement.xml
msgid "The current selected state."
msgstr "当前选中状态。"

#. doc_classes/HTMLOptionElement.xml
msgid "Reflects the selected attribute used when resetting the form."
msgstr "反映重置表单时使用的默认选中属性。"

#. doc_classes/HTMLOptGroupElement.xml
msgid "A labeled group of HTML dropdown options."
msgstr "带标题的 HTML 下拉选项组。"

#. doc_classes/HTMLOptGroupElement.xml
msgid "Disabling the group prevents users from selecting its options."
msgstr "禁用分组后，用户无法选择其中的选项。"

#. doc_classes/HTMLOptGroupElement.xml
msgid "The heading shown for the option group."
msgstr "选项分组显示的标题。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Submits a connected form in this label and emits [signal form_submitted] on success. An optional "
"submitter must be an enabled submit button associated with the form. Returns [constant "
"ERR_INVALID_DATA] on failed validation or [constant ERR_INVALID_PARAMETER] for an invalid "
"argument. The submitter's [code]formmethod[/code] overrides the form's [code]method[/code]. "
"With the [code]dialog[/code] method, a successful submission closes the form's nearest ancestor "
"[HTMLDialogElement]. A supplied submitter [code]value[/code], including an empty string, replaces "
"[member HTMLDialogElement.return_value]. Omit the attribute or the submitter to preserve the existing value."
msgstr ""
"提交此控件中已连接的表单，成功时发出 [signal form_submitted]。可选的提交按钮必须可用并关联到该表单。校验失败时返回 [constant "
"ERR_INVALID_DATA]，参数无效时返回 [constant ERR_INVALID_PARAMETER]。提交控件的 [code]formmethod[/code] 覆盖表单的 [code]method[/code]。"
"使用 [code]dialog[/code] 方法时，成功提交会关闭表单最近的祖先 [HTMLDialogElement]。提交控件存在 [code]value[/code] 属性时，会用该值替换 "
"[member HTMLDialogElement.return_value]，空字符串也会替换。省略该属性或提交控件时保留原值。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted after a reset button restores the form's default values."
msgstr "重置按钮恢复表单默认值后发出。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted with the first control that fails form validation."
msgstr "表单验证失败时发出，并传入第一个未通过验证的控件。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when a user selects a different option in a dropdown."
msgstr "用户在下拉框中选择其他选项时发出。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Activates a visible link or a form control in this label. A fragment link requests an anchor scroll "
"before emitting [signal link_pressed]. A command button emits [signal button_pressed]. Form buttons, labels, "
"toggles, and dropdowns perform their corresponding actions. Returns [code]true[/code] if "
"activation was dispatched."
msgstr ""
"激活此控件内可见的链接或表单控件。片段链接先请求锚点滚动，再发出 [signal link_pressed]。命令按钮发出 [signal "
"button_pressed]。表单按钮、标签、开关和下拉框执行各自的操作。已派发激活时返回 [code]true[/code]。"

#. doc_classes/HTMLButtonElement.xml
msgid ""
"Returned by queries and [method HTMLLayout.create_element] for [code]<button>[/code]. In "
"[HTMLLabel], an enabled button can run a command, submit its associated form, or reset it "
"according to its type."
msgstr ""
"查询和 [method HTMLLayout.create_element] 会为 [code]<button>[/code] 返回此类型。在 [HTMLLabel] "
"中，可用的按钮根据类型运行命令、提交所属表单或重置表单。"

#. doc_classes/HTMLTableSectionElement.xml
msgid "A row group in an HTML table."
msgstr "HTML 表格的行组。"

#. doc_classes/HTMLTableRowElement.xml
msgid "A row in an HTML table."
msgstr "HTML 表格的一行。"

#. doc_classes/HTMLTableColElement.xml
msgid "An HTML table column or column group."
msgstr "HTML 表格的列或列组。"

#. doc_classes/HTMLTableCellElement.xml
msgid "An HTML table data cell or header cell."
msgstr "HTML 表格的数据单元格或表头单元格。"

#. doc_classes/HTMLTableElement.xml
msgid "An HTML table with row and section editing."
msgstr "支持编辑行和行组的 HTML 表格。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Cell queries use the immediate children and return stable element handles."
msgstr "单元格查询使用直属子元素并返回稳定的元素句柄。"

#. doc_classes/HTMLTableElement.xml
msgid "Create tables with [method HTMLLayout.create_element] or query them by selector. Table edits operate on the current layout. Collections are typed array snapshots. Removed sections and rows retain their handles."
msgstr "使用 [method HTMLLayout.create_element] 创建表格，或通过选择器查询。表格编辑作用于当前布局。集合以类型化数组快照返回。移出的行组和行保留原有句柄。"

#. doc_classes/HTMLTableElement.xml
msgid "Creates a table body after the last existing body, or appends it if there are no bodies."
msgstr "在最后一个表体之后创建新表体。没有表体时追加到末尾。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Detaches a cell and keeps its handle valid. Pass [code]-1[/code] to detach the last cell. Returns [constant ERR_INVALID_PARAMETER] for an invalid index."
msgstr "分离单元格并保留句柄。[code]-1[/code] 表示分离最后一个单元格。索引无效时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLTableElement.xml
msgid "Detaches the first direct caption, if present."
msgstr "存在直属标题时分离第一个。"

#. doc_classes/HTMLTableElement.xml
msgid "Detaches the first direct table foot, if present."
msgstr "存在直属表尾时分离第一个。"

#. doc_classes/HTMLTableElement.xml
msgid "Detaches the first direct table head, if present."
msgstr "存在直属表头时分离第一个。"

#. doc_classes/HTMLTableElement.xml
#. doc_classes/HTMLTableSectionElement.xml
msgid "Detaches the row at the given index and preserves its handle. Pass [code]-1[/code] to detach the last row. Returns [constant OK] if the list is empty and the index is [code]-1[/code]."
msgstr "分离指定索引的行并保留其句柄。[code]-1[/code] 表示分离最后一行。当列表为空且索引为 [code]-1[/code] 时返回 [constant OK]。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Inserts a data cell at the given index. Pass [code]-1[/code] to append. Returns [code]null[/code] for an invalid index."
msgstr "在给定索引插入数据单元格。[code]-1[/code] 表示追加。索引无效时返回 [code]null[/code]。"

#. doc_classes/HTMLTableSectionElement.xml
msgid "Inserts a row at the given index. Pass [code]-1[/code] to append. Returns [code]null[/code] for an invalid index."
msgstr "在给定索引插入一行。[code]-1[/code] 表示追加。索引无效时返回 [code]null[/code]。"

#. doc_classes/HTMLTableElement.xml
msgid "Inserts a row in the target row's parent. An empty table uses its last body or creates one. Pass [code]-1[/code] to append. Returns [code]null[/code] for an invalid index."
msgstr "在目标行的父元素中插入新行。空表使用最后一个表体，或新建表体。[code]-1[/code] 表示追加。索引无效时返回 [code]null[/code]。"

#. doc_classes/HTMLTableColElement.xml
msgid "Represents a [code]<col>[/code] or [code]<colgroup>[/code] element."
msgstr "表示 [code]<col>[/code] 或 [code]<colgroup>[/code] 元素。"

#. doc_classes/HTMLTableCellElement.xml
msgid "Represents a [code]<td>[/code] or [code]<th>[/code] element."
msgstr "表示 [code]<td>[/code] 或 [code]<th>[/code] 元素。"

#. doc_classes/HTMLTableSectionElement.xml
msgid "Represents the table head, a table body, or the table foot. Row operations address immediate child rows."
msgstr "表示表头、表体或表尾。行操作以直属行作为对象。"

#. doc_classes/HTMLTableSectionElement.xml
msgid "Returns a snapshot of the rows."
msgstr "返回行数组的快照。"

#. doc_classes/HTMLTableElement.xml
msgid "Returns a snapshot with head rows first, followed by body and direct rows, then foot rows."
msgstr "返回行数组快照，先列出表头行，再列出表体行与直属行，最后列出表尾行。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Returns a tree-order snapshot of the immediate header and data cells."
msgstr "按树顺序返回直属表头单元格和数据单元格的快照。"

#. doc_classes/HTMLTableElement.xml
msgid "Returns a tree-order snapshot of the immediate table bodies."
msgstr "按树顺序返回直属表体的快照。"

#. doc_classes/HTMLTableElement.xml
msgid "Returns the existing caption or creates it."
msgstr "返回现有标题，缺少时创建。"

#. doc_classes/HTMLTableElement.xml
msgid "Returns the existing table foot or creates it."
msgstr "返回现有表尾，缺少时创建。"

#. doc_classes/HTMLTableElement.xml
msgid "Returns the existing table head or creates it."
msgstr "返回现有表头，缺少时创建。"

#. doc_classes/HTMLTableCellElement.xml
msgid "The canonical header scope keyword. Missing and unknown values read as an empty string."
msgstr "规范化的表头作用范围关键字。未设置或未知时返回空字符串。"

#. doc_classes/HTMLTableCaptionElement.xml
msgid "The caption of an HTML table."
msgstr "HTML 表格的标题。"

#. doc_classes/HTMLTableElement.xml
msgid "The first direct caption. Setting this to [code]null[/code] detaches it."
msgstr "第一个直属标题。设为 [code]null[/code] 会将其分离。"

#. doc_classes/HTMLTableElement.xml
msgid "The first direct table foot. Assign a [code]<tfoot>[/code] handle from the same layout or [code]null[/code]."
msgstr "第一个直属表尾。可赋值同一布局的 [code]<tfoot>[/code] 句柄或 [code]null[/code]。"

#. doc_classes/HTMLTableElement.xml
msgid "The first direct table head. Assign a [code]<thead>[/code] handle from the same layout or [code]null[/code]."
msgstr "第一个直属表头。可赋值同一布局的 [code]<thead>[/code] 句柄或 [code]null[/code]。"

#. doc_classes/HTMLTableCellElement.xml
msgid "The reflected column span. Reads are limited to 1 through 1000."
msgstr "反射跨列属性，读取范围为 1 到 1000。"

#. doc_classes/HTMLTableCellElement.xml
msgid "The reflected row span. Reads are limited to 0 through 65534. Zero spans the remaining rows in the row group."
msgstr "反射跨行属性，读取范围为 0 到 65534。零表示跨到当前行组的最后一行。"

#. doc_classes/HTMLTableColElement.xml
msgid "The reflected span. Reads are limited to 1 through 1000."
msgstr "反射跨度属性，读取范围为 1 到 1000。"

#. doc_classes/HTMLTableCellElement.xml
msgid "The short label of a header cell."
msgstr "表头单元格的简称。"

#. doc_classes/HTMLTableCellElement.xml
msgid "The source attribute listing header IDs."
msgstr "列出表头 ID 的源属性。"

#. doc_classes/HTMLTableCaptionElement.xml
msgid "Use the inherited element methods to edit the caption contents."
msgstr "使用继承的元素方法编辑表格标题内容。"

#. doc_classes/HTMLTableCellElement.xml
msgid "Zero-based position in the parent row or [code]-1[/code] without a row parent."
msgstr "在父行中的零基索引。没有行父元素时为 [code]-1[/code]。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Zero-based position in the parent section or table. Returns [code]-1[/code] without either parent."
msgstr "在父行组或父表格中的零基索引。没有对应父元素时返回 [code]-1[/code]。"

#. doc_classes/HTMLTableRowElement.xml
msgid "Zero-based position in the table or [code]-1[/code] when outside a table."
msgstr "在表格中的零基索引。没有所属表格时为 [code]-1[/code]。"

#. doc_classes/HTMLArticleElement.xml
msgid "An HTML article element."
msgstr "HTML 文章元素。"

#. doc_classes/HTMLArticleElement.xml
msgid "Dockit's typed handle for [code]<article>[/code]. The element uses the shared [HTMLElement] API and normal block layout."
msgstr "Dockit 为 [code]<article>[/code] 提供的专用句柄。该元素使用 [HTMLElement] 的公共接口和普通块布局。"

#. doc_classes/HTMLBRElement.xml
msgid "An HTML line break."
msgstr "HTML 换行符。"

#. doc_classes/HTMLBRElement.xml
msgid "Represents the [code]<br>[/code] element."
msgstr "表示 [code]<br>[/code] 元素。"

#. doc_classes/HTMLBRElement.xml
msgid "Reflects the legacy clear attribute."
msgstr "映射旧式清除浮动属性。"

#. doc_classes/HTMLDataListElement.xml
msgid "An HTML list of input suggestions."
msgstr "HTML 输入建议列表。"

#. doc_classes/HTMLDataListElement.xml
msgid "Represents [code]<datalist>[/code]. An input associates it through the list attribute."
msgstr "表示 [code]<datalist>[/code]。输入控件通过 list 属性关联它。"

#. doc_classes/HTMLDataListElement.xml
msgid "Returns candidate [HTMLOptionElement] handles in tree order."
msgstr "按树顺序返回候选 [HTMLOptionElement] 句柄。"

#. doc_classes/HTMLDetailsElement.xml
msgid "An HTML disclosure widget."
msgstr "HTML 折叠控件。"

#. doc_classes/HTMLDetailsElement.xml
msgid "Whether the disclosure is open."
msgstr "折叠控件是否展开。"

#. doc_classes/HTMLDetailsElement.xml
msgid "The name of the mutually exclusive disclosure group."
msgstr "互斥折叠组的名称。"

#. doc_classes/HTMLDetailsElement.xml
msgid "Emitted after the open state changes. Successive changes in the same frame are combined."
msgstr "展开状态改变后发出。同一帧内的多次变更会合并。"

#. doc_classes/HTMLDListElement.xml
msgid "An HTML description list."
msgstr "HTML 描述列表。"

#. doc_classes/HTMLDListElement.xml
msgid "Represents the [code]<dl>[/code] element."
msgstr "表示 [code]<dl>[/code] 元素。"

#. doc_classes/HTMLMenuElement.xml
msgid "Reflects the legacy compact attribute."
msgstr "映射旧式紧凑显示属性。"

#. doc_classes/HTMLHRElement.xml
msgid "An HTML thematic break."
msgstr "HTML 主题分隔线。"

#. doc_classes/HTMLHRElement.xml
msgid "Represents the [code]<hr>[/code] element."
msgstr "表示 [code]<hr>[/code] 元素。"

#. doc_classes/HTMLHRElement.xml
msgid "Reflects the legacy align attribute."
msgstr "映射旧式 align 属性。"

#. doc_classes/HTMLHRElement.xml
msgid "Reflects the legacy color attribute."
msgstr "映射旧式 color 属性。"

#. doc_classes/HTMLHRElement.xml
msgid "Reflects the legacy size attribute."
msgstr "映射旧式 size 属性。"

#. doc_classes/HTMLHRElement.xml
msgid "Reflects the legacy width attribute."
msgstr "映射旧式 width 属性。"

#. doc_classes/HTMLHRElement.xml
msgid "Reflects the legacy noshade attribute."
msgstr "映射旧式 noshade 属性。"

#. doc_classes/HTMLInputElement.xml
msgid "The normalized HTML input type."
msgstr "规范化后的 HTML 输入类型。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Emitted for a valid submission with ordered entries and the submitter. The submitter is an "
"[HTMLButtonElement], an [HTMLInputElement], or [code]null[/code]. If the submission closes a "
"dialog, this signal is emitted before [signal HTMLDialogElement.closed]."
msgstr ""
"验证通过并提交时发出，参数包含按序排列的条目和提交控件。提交控件为 [HTMLButtonElement]、[HTMLInputElement] 或 "
"[code]null[/code]。如果提交关闭了对话框，该信号在 [signal HTMLDialogElement.closed] 之前发出。"

#. doc_classes/HTMLMenuElement.xml
msgid "An HTML menu list."
msgstr "HTML 菜单列表。"

#. doc_classes/HTMLMenuElement.xml
msgid "Represents the [code]<menu>[/code] element."
msgstr "表示 [code]<menu>[/code] 元素。"

#. doc_classes/HTMLMeterElement.xml
msgid "An HTML measurement gauge."
msgstr "HTML 数值计量器。"

#. doc_classes/HTMLMeterElement.xml
msgid "Represents [code]<meter>[/code]. The fill reflects the normalized value and its proximity to the optimum range."
msgstr "表示 [code]<meter>[/code]。填充显示规范化后的数值及其所在区间。"

#. doc_classes/HTMLOutputElement.xml
msgid "Returns associated [HTMLLabelElement] handles in tree order."
msgstr "按树顺序返回关联的 [HTMLLabelElement] 句柄。"

#. doc_classes/HTMLMeterElement.xml
msgid "The effective lower bound."
msgstr "有效下限。"

#. doc_classes/HTMLMeterElement.xml
msgid "The effective upper bound."
msgstr "有效上限。"

#. doc_classes/HTMLMeterElement.xml
msgid "The current value clamped to the effective range."
msgstr "限制在有效范围内的当前值。"

#. doc_classes/HTMLMeterElement.xml
msgid "The normalized low threshold."
msgstr "规范化后的低阈值。"

#. doc_classes/HTMLMeterElement.xml
msgid "The normalized high threshold."
msgstr "规范化后的高阈值。"

#. doc_classes/HTMLMeterElement.xml
msgid "The normalized optimum value."
msgstr "规范化后的最佳值。"

#. doc_classes/HTMLOutputElement.xml
msgid "An HTML form result."
msgstr "HTML 表单结果。"

#. doc_classes/HTMLOutputElement.xml
msgid "Represents [code]<output>[/code]. Form reset restores its default text."
msgstr "表示 [code]<output>[/code]。表单重置时恢复默认文本。"

#. doc_classes/HTMLOutputElement.xml
msgid "Restores the default text."
msgstr "恢复默认文本。"

#. doc_classes/HTMLOutputElement.xml
msgid "The displayed result."
msgstr "显示的结果。"

#. doc_classes/HTMLOutputElement.xml
msgid "The text restored on reset."
msgstr "重置时恢复的文本。"

#. doc_classes/HTMLOutputElement.xml
msgid "The reflected name attribute."
msgstr "映射名称属性。"

#. doc_classes/HTMLOutputElement.xml
msgid "The reflected space-separated list of control IDs."
msgstr "映射以空格分隔的控件 ID 列表。"

#. doc_classes/HTMLProgressElement.xml
msgid "An HTML progress indicator."
msgstr "HTML 进度条。"

#. doc_classes/HTMLProgressElement.xml
msgid "Represents [code]<progress>[/code]. Remove the value attribute for indeterminate progress."
msgstr "表示 [code]<progress>[/code]。移除 value 属性可进入不确定进度模式。"

#. doc_classes/HTMLProgressElement.xml
msgid "The positive maximum. Missing and invalid values use 1."
msgstr "正数上限。缺失或无效时使用 1。"

#. doc_classes/HTMLProgressElement.xml
msgid "The fraction completed, or -1 for indeterminate progress."
msgstr "已完成的比例。不确定进度返回 -1。"

#. doc_classes/HTMLQuoteElement.xml
msgid "An HTML quotation."
msgstr "HTML 引文。"

#. doc_classes/HTMLQuoteElement.xml
msgid "Represents [code]<q>[/code] and [code]<blockquote>[/code]."
msgstr "表示 [code]<q>[/code] 和 [code]<blockquote>[/code]。"

#. doc_classes/HTMLQuoteElement.xml
msgid "The reflected quotation source."
msgstr "映射引文来源属性。"

#. doc_classes/HTMLSectionElement.xml
msgid "An HTML section element."
msgstr "HTML 章节元素。"

#. doc_classes/HTMLSectionElement.xml
msgid "Dockit's typed handle for [code]<section>[/code]. The element uses the shared [HTMLElement] API and normal block layout."
msgstr "Dockit 为 [code]<section>[/code] 提供的专用句柄。该元素使用 [HTMLElement] 的公共接口和普通块布局。"

#. doc_classes/HTMLSelectElement.xml
msgid "An HTML select control."
msgstr "HTML 选择控件。"

#. doc_classes/HTMLSelectElement.xml
msgid "[HTMLLabel] draws a dropdown or list box and emits [signal HTMLLabel.select_changed] for user changes. Script assignments update selection silently."
msgstr "[HTMLLabel] 绘制下拉菜单或列表框，并在用户修改时发出 [signal HTMLLabel.select_changed]。脚本赋值直接更新选中状态。"

#. doc_classes/HTMLSelectElement.xml
msgid "Returns the selected options in tree order."
msgstr "按树顺序返回选中项。"

#. doc_classes/HTMLSelectElement.xml
msgid "The first selected option value. Assigning a matching value selects only that option. An unmatched assignment clears the selection."
msgstr "首个选中项的值。赋予匹配的值时只选中对应项，赋予不匹配的值会清空选中状态。"

#. doc_classes/HTMLSelectElement.xml
msgid "Whether the list accepts multiple selections."
msgstr "列表是否允许多选。"

#. doc_classes/HTMLSelectElement.xml
msgid "The requested visible row count. The default value is 0."
msgstr "指定的可见行数。默认值为 0。"

#. doc_classes/HTMLLabel.xml
msgid "If [code]true[/code], the default canvas is transparent. Authored CSS backgrounds still paint over the scene."
msgstr "为 [code]true[/code] 时，默认画布透明。CSS 指定的背景仍会绘制在场景上。"

#. doc_classes/HTMLNode.xml
msgid "A live DOM node owned by an HTML layout."
msgstr "由 HTML 布局拥有的实时 DOM 节点。"

#. doc_classes/HTMLNode.xml
msgid "Returns the node's type, including for an invalidated handle."
msgstr "返回节点类型，句柄失效后仍可查询。"

#. doc_classes/HTMLNode.xml
msgid "Returns whether the handle still refers to a node in its current layout."
msgstr "返回句柄是否仍指向当前布局中的节点。"

#. doc_classes/HTMLNode.xml
msgid "Returns whether the node is connected to its document tree. A detached node can stay valid."
msgstr "返回节点是否连接到所属文档树。分离的节点仍可有效。"

#. doc_classes/HTMLNode.xml
msgid "Returns the parent node, including a document or fragment. Returns [code]null[/code] for a root."
msgstr "返回父节点，包括文档或片段。根节点返回 [code]null[/code]。"

#. doc_classes/HTMLNode.xml
msgid "Returns a snapshot of the direct child nodes in tree order, including text and comments."
msgstr "按树顺序返回直接子节点的快照，包括文本和注释。"

#. doc_classes/HTMLNode.xml
msgid "Returns the first direct child node, or [code]null[/code]."
msgstr "返回首个直接子节点，无子节点时返回 [code]null[/code]。"

#. doc_classes/HTMLNode.xml
msgid "Returns the next sibling node, or [code]null[/code]."
msgstr "返回下一个同父节点，无后续节点时返回 [code]null[/code]。"

#. doc_classes/HTMLNode.xml
msgid "Returns the root of the current tree. A detached node may be its own root."
msgstr "返回当前树的根节点。分离节点可以是自己的根节点。"

#. doc_classes/HTMLNode.xml
msgid "Returns whether [param node] is this node or one of its descendants."
msgstr "返回 [param node] 是否是自身或其后代节点。"

#. doc_classes/HTMLNode.xml
msgid "Returns an OR of [enum DocumentPosition] flags describing the position of [param node] relative to this node."
msgstr "返回 [enum DocumentPosition] 标志的按位或，描述 [param node] 相对本节点的位置。"

#. doc_classes/HTMLNode.xml
msgid "Compares node types, attributes, character data, and child nodes recursively."
msgstr "递归比较节点类型、属性、字符数据和子节点。"

#. doc_classes/HTMLNode.xml
msgid "Merges adjacent text nodes and detaches empty text nodes. The first nonempty text node retains its identity."
msgstr "合并相邻文本节点并分离空文本。第一个非空文本节点保留句柄。"

#. doc_classes/HTMLNode.xml
msgid "An element node."
msgstr "元素节点。"

#. doc_classes/HTMLNode.xml
msgid "A text node."
msgstr "文本节点。"

#. doc_classes/HTMLNode.xml
msgid "A comment node."
msgstr "注释节点。"

#. doc_classes/HTMLNode.xml
msgid "The live document node."
msgstr "实时文档节点。"

#. doc_classes/HTMLNode.xml
msgid "A detached document fragment."
msgstr "分离的文档片段。"

#. doc_classes/HTMLNode.xml
msgid "The nodes belong to separate trees."
msgstr "节点属于不同的树。"

#. doc_classes/HTMLNode.xml
msgid "The other node comes before this one."
msgstr "对方节点排在本节点之前。"

#. doc_classes/HTMLNode.xml
msgid "The other node comes after this one."
msgstr "对方节点排在本节点之后。"

#. doc_classes/HTMLNode.xml
msgid "The other node contains this one."
msgstr "对方节点包含本节点。"

#. doc_classes/HTMLNode.xml
msgid "The other node is contained by this one."
msgstr "对方节点被本节点包含。"

#. doc_classes/HTMLNode.xml
msgid "The relative order depends on the implementation."
msgstr "相对顺序由实现决定。"

#. doc_classes/HTMLDocumentNode.xml
msgid "The root node of a live HTMLLayout document."
msgstr "HTMLLayout 实时文档的根节点。"

#. doc_classes/HTMLTextNode.xml
msgid "A DOM text node."
msgstr "DOM 文本节点。"

#. doc_classes/HTMLTextNode.xml
msgid "Returns the node's character data."
msgstr "返回节点的字符数据。"

#. doc_classes/HTMLTextNode.xml
msgid "Replaces the node's character data and retains the handle."
msgstr "替换节点的字符数据并保留句柄。"

#. doc_classes/HTMLCommentNode.xml
msgid "A DOM comment node."
msgstr "DOM 注释节点。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the live document node, or [code]null[/code] before a document exists."
msgstr "返回实时文档节点。文档尚未创建时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the root element of the live document."
msgstr "返回实时文档的根元素。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the document's head element, if present."
msgstr "返回文档的 head 元素。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the document's body or frameset element, if present."
msgstr "返回文档的 body 或 frameset 元素。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the HTML document title with runs of ASCII whitespace collapsed."
msgstr "返回 HTML 文档标题，合并连续的 ASCII 空白。"

#. doc_classes/HTMLLayout.xml
msgid "Edits the title of this layout's live document."
msgstr "编辑当前布局的实时文档标题。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a snapshot of elements with the given tag name in tree order. Pass [code]*[/code] for all elements."
msgstr "按树顺序返回指定标签名的元素快照。传入 [code]*[/code] 可取全部元素。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a snapshot of elements matching all of the whitespace-separated class names."
msgstr "返回匹配全部空白分隔类名的元素快照。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a snapshot of elements whose HTML [code]name[/code] attribute matches exactly."
msgstr "返回 HTML [code]name[/code] 属性完全匹配的元素快照。"

#. doc_classes/HTMLLayout.xml
msgid "Creates a detached text node in this layout."
msgstr "在当前布局中创建分离的文本节点。"

#. doc_classes/HTMLLayout.xml
msgid "Creates a detached comment in this layout."
msgstr "在当前布局中创建分离的注释。"

#. doc_classes/HTMLLayout.xml
msgid "Parses a detached fragment in the specified element's context. The default context is [code]body[/code]."
msgstr "按指定元素的上下文解析分离片段。默认上下文为 [code]body[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Deep-copies the source fragment into this layout."
msgstr "将源片段深复制到当前布局。"

#. doc_classes/HTMLLayout.xml
msgid "Transfers an independent fragment and its existing handles into this layout. A fragment owned by a template can be transferred with its template element."
msgstr "将独立片段和现有句柄迁移到当前布局。模板拥有的片段可以随模板元素迁移。"

#. doc_classes/HTMLElement.xml
msgid "Returns the first direct element child, or [code]null[/code]."
msgstr "返回首个直接子元素，无匹配时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the last direct element child, or [code]null[/code]."
msgstr "返回最后一个直接子元素，无匹配时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the number of direct element children."
msgstr "返回直接子元素的数量。"

#. doc_classes/HTMLElement.xml
msgid "Replaces the child nodes with the given nodes, plain strings, and fragments. Removed nodes retain their handles."
msgstr "用传入的节点、纯文本字符串和片段替换子节点。移出的节点保留句柄。"

#. doc_classes/HTMLElement.xml
msgid "Returns the preceding sibling element, or [code]null[/code]."
msgstr "返回上一个同父元素，无匹配时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the following sibling element, or [code]null[/code]."
msgstr "返回下一个同父元素，无匹配时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the descendant elements with the given tag name as a snapshot."
msgstr "返回指定标签名的后代元素快照。"

#. doc_classes/HTMLElement.xml
msgid "Returns descendants matching all of the whitespace-separated class names."
msgstr "返回匹配全部空白分隔类名的后代元素。"

#. doc_classes/HTMLElement.xml
msgid "Returns a snapshot of source attribute names."
msgstr "返回源属性名称的快照。"

#. doc_classes/HTMLElement.xml
msgid "Returns whether the element has any source attributes."
msgstr "返回元素是否具有源属性。"

#. doc_classes/HTMLElement.xml
msgid "Toggles an attribute, or sets its presence to [param force]. Returns whether the attribute is now present."
msgstr "切换属性或通过 [param force] 指定其存在状态。返回更新后属性是否存在。"

#. doc_classes/HTMLElement.xml
msgid "Replaces a class token while preserving token order. Returns whether the replacement was applied."
msgstr "替换类名并保留顺序。返回是否完成替换。"

#. doc_classes/HTMLElement.xml
msgid "Sets a [code]data-*[/code] attribute from a dataset key."
msgstr "按 dataset 键设置 [code]data-*[/code] 属性。"

#. doc_classes/HTMLElement.xml
msgid "Removes the attribute for the given dataset key."
msgstr "移除指定 dataset 键对应的属性。"

#. doc_classes/HTMLElement.xml
msgid "Inserts an element at [code]beforebegin[/code], [code]afterbegin[/code], [code]beforeend[/code], or [code]afterend[/code]."
msgstr "在 [code]beforebegin[/code]、[code]afterbegin[/code]、[code]beforeend[/code] 或 [code]afterend[/code] 位置插入元素。"

#. doc_classes/HTMLElement.xml
msgid "Inserts plain text at a position accepted by [method insert_adjacent_element]."
msgstr "在 [method insert_adjacent_element] 支持的位置插入纯文本。"

#. doc_classes/HTMLElement.xml
msgid "Parses and inserts markup at a position accepted by [method insert_adjacent_element]."
msgstr "在 [method insert_adjacent_element] 支持的位置解析并插入标记。"

#. doc_classes/HTMLElement.xml
msgid "Serializes the element and its contents as HTML."
msgstr "将元素及其内容序列化为 HTML。"

#. doc_classes/HTMLElement.xml
msgid "Replaces the element with parsed markup and retains this handle as a detached element."
msgstr "用解析后的标记替换当前元素，保留分离后的元素句柄。"

#. doc_classes/HTMLElement.xml
msgid "Returns text with CSS visibility, casing, whitespace, and structural line breaks applied. Without a rendered element, returns the source text content."
msgstr "返回考虑 CSS 可见性、大小写、空白和结构换行的文本。元素未渲染时返回源文本。"

#. doc_classes/HTMLElement.xml
msgid "Replaces the child nodes with plain text, converting line endings to HTML line breaks where allowed."
msgstr "用纯文本替换子节点，并在允许的位置将换行符转换为 HTML 换行元素。"

#. doc_classes/HTMLElement.xml
msgid "Appends the items at the end of this element. The array accepts nodes, plain strings, and fragments."
msgstr "将项目追加到元素末尾。数组接受节点、纯文本和片段。"

#. doc_classes/HTMLElement.xml
msgid "Inserts the items at the beginning of this element. The array accepts nodes, plain strings, and fragments."
msgstr "将项目插入元素开头。数组接受节点、纯文本和片段。"

#. doc_classes/HTMLElement.xml
msgid "Inserts the items directly before this element. The array accepts nodes, plain strings, and fragments."
msgstr "将项目直接插入元素之前。数组接受节点、纯文本和片段。"

#. doc_classes/HTMLElement.xml
msgid "Inserts the items directly after this element. The array accepts nodes, plain strings, and fragments."
msgstr "将项目直接插入元素之后。数组接受节点、纯文本和片段。"

#. doc_classes/HTMLElement.xml
msgid "Replaces this element with the given items and retains this handle as a detached element. The array accepts nodes, plain strings, and fragments."
msgstr "用传入项目替换当前元素，并保留分离后的元素句柄。数组接受节点、纯文本和片段。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the HTML ID."
msgstr "反射 HTML ID。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the raw HTML class attribute."
msgstr "反射原始 HTML 类名属性。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the element's own HTML language attribute."
msgstr "反射元素自身的 HTML 语言属性。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the HTML direction attribute."
msgstr "反射 HTML 方向属性。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the HTML title attribute."
msgstr "反射 HTML 标题属性。"

#. doc_classes/HTMLElement.xml
msgid "Reflects whether the hidden attribute is present."
msgstr "反射隐藏属性是否存在。"

#. doc_classes/HTMLElement.xml
msgid "Reflects whether the inert attribute is present."
msgstr "反射惰性属性是否存在。"

#. doc_classes/HTMLElement.xml
msgid "Reflects the explicit tab index, or returns the default for the element type."
msgstr "反射显式 Tab 索引，或返回该元素类型的默认值。"

#. doc_classes/HTMLDocumentFragment.xml
msgid "Moves a node or fragment before the reference child, or appends it if the reference is [code]null[/code]."
msgstr "将节点或片段移到参照子节点之前。参照为 [code]null[/code] 时追加到末尾。"

#. doc_classes/HTMLDocumentFragment.xml
msgid "Detaches a direct child and retains its handle."
msgstr "分离直接子节点并保留其句柄。"

#. doc_classes/HTMLDocumentFragment.xml
msgid "Replaces a direct child and retains the outgoing handle."
msgstr "替换直接子节点并保留移出的句柄。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the elements at the given document position in front-to-back hit order, with each element included once."
msgstr "按从前到后的命中顺序返回文档坐标处的元素，每个元素只返回一次。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the elements under a label-local point in front-to-back hit order. Scrollbars and points outside the visible document are skipped."
msgstr "按从前到后的命中顺序返回控件局部坐标处的元素，跳过滚动条和文档可见区域之外的位置。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the indexed document text used for selection and search."
msgstr "返回用于选择和搜索的文档索引文本。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the ordered selection endpoints as offsets into [method get_plain_text]."
msgstr "返回按从小到大排列的选区端点，以 [method get_plain_text] 的字符偏移表示。"

#. doc_classes/HTMLLabel.xml
msgid "Sets the document selection using character offsets. Endpoints are clamped to the document text length."
msgstr "按字符偏移设置文档选区。端点限制在文档文字长度内。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the visible selection rectangles in document coordinates."
msgstr "返回文档坐标下的可见选区矩形。"

#. doc_classes/HTMLLabel.xml
msgid "Copies selectable text to the system clipboard. Returns whether there was text to copy."
msgstr "将可选文本复制到系统剪贴板，返回是否有文字可复制。"

#. doc_classes/HTMLLabel.xml
msgid "Searches document text from the given offset and returns the matching range, or [code]Vector2i(-1, -1)[/code] when absent."
msgstr "从指定偏移搜索文档文本并返回匹配范围，无匹配时返回 [code]Vector2i(-1, -1)[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the untransformed padding box size. The root uses the viewport size."
msgstr "返回未变换的内边距盒尺寸。根元素返回视口尺寸。"

#. doc_classes/HTMLElement.xml
msgid "Returns the left and top border widths in layout pixels."
msgstr "返回左侧和顶部边框宽度，单位为布局像素。"

#. doc_classes/HTMLElement.xml
msgid "Returns the reference element for [method get_offset_rect], or [code]null[/code]."
msgstr "返回 [method get_offset_rect] 的参照元素，无参照元素时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the first border box position and the combined border box size in layout pixels. Position is relative to the offset parent's padding box. CSS transforms and scroll offsets are excluded."
msgstr "以布局像素返回首个边框盒的位置及合并后的边框盒尺寸。位置相对参照元素的内边距盒。计算排除 CSS 变换和滚动偏移。"

#. doc_classes/HTMLElement.xml
msgid "Returns the extent of the scrollable content, including padding."
msgstr "返回可滚动内容的范围，包括内边距。"

#. doc_classes/HTMLElement.xml
msgid "Returns the current scroll offset of this inner scroll container in CSS pixels."
msgstr "返回该内层滚动容器的当前偏移，单位为 CSS 像素。"

#. doc_classes/HTMLElement.xml
msgid "Sets the inner scroll offset immediately, clamped to the scrollable extent. Use [method HTMLLabel.set_scroll_offset] for the outer viewport."
msgstr "立即设置内层滚动偏移，限制在可滚动范围内。外层视口使用 [method HTMLLabel.set_scroll_offset]。"

#. doc_classes/HTMLElement.xml
msgid "Sets the inner scroll position to the specified offset."
msgstr "将内层滚动位置设为指定偏移。"

#. doc_classes/HTMLElement.xml
msgid "Adds the specified delta to the current inner scroll position."
msgstr "在当前内层滚动位置上增加指定距离。"

#. doc_classes/HTMLLabel.xml
msgid "Scrolls inner containers and the viewport to reveal an element. Options are [code]block[/code], [code]inline[/code], and [code]behavior[/code]. The alignment values are [code]start[/code], [code]center[/code], [code]end[/code], and [code]nearest[/code]. Behavior accepts [code]auto[/code], [code]instant[/code], or [code]smooth[/code]. The defaults are [code]start[/code], [code]nearest[/code], and [code]auto[/code]."
msgstr "滚动内层容器和视口以显示元素。选项有 [code]block[/code]、[code]inline[/code] 和 [code]behavior[/code]。对齐接受 [code]start[/code]、[code]center[/code]、[code]end[/code] 和 [code]nearest[/code]。行为接受 [code]auto[/code]、[code]instant[/code] 或 [code]smooth[/code]。三个选项分别默认为 [code]start[/code]、[code]nearest[/code] 和 [code]auto[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "Scrolls the viewport to the first available selection rectangle for character offsets [param from] and [param to]. Returns [code]false[/code] if the range has no visible rectangle in the laid-out document."
msgstr "将视口滚动到字符偏移 [param from] 和 [param to] 对应的首个可用选区矩形。范围在已排版文档中没有可见矩形时返回 [code]false[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns text in document order for assistive technologies. CSS alternatives specified after the slash in [code]content[/code] replace the spoken content, including explicit empty alternatives. Image [code]alt[/code] attributes supply text when no CSS alternative applies. Returns an empty string before layout."
msgstr "按文档顺序返回供辅助技术使用的文本。[code]content[/code] 斜杠后的 CSS 替代文本用于朗读，包括显式空字符串。未指定 CSS 替代文本的图片使用 [code]alt[/code] 属性。布局前返回空字符串。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the document text published as this control's accessibility text value. CSS alternatives in [code]content[/code] are applied. See [method HTMLLayout.get_accessible_text]."
msgstr "返回此控件发布的无障碍文本值，应用 [code]content[/code] 中的 CSS 替代文本。另请参见 [method HTMLLayout.get_accessible_text]。"

#. doc_classes/HTMLRange.xml
msgid "A live range of nodes in an HTML layout."
msgstr "HTML 布局中的实时节点范围。"

#. doc_classes/HTMLRange.xml
msgid "Create a range with [method HTMLLayout.create_range] or [method HTMLLabel.create_range]. Endpoints use Godot character offsets for text and comments and logical child indices for other nodes. DOM edits update endpoints. Clearing or reparsing the layout invalidates the range."
msgstr "使用 [method HTMLLayout.create_range] 或 [method HTMLLabel.create_range] 创建范围。文本和注释的端点使用 Godot 字符偏移，其他节点使用逻辑子节点索引。DOM 编辑会更新端点。清空或重新解析布局会使范围失效。"

#. doc_classes/HTMLRange.xml
msgid "Returns whether the range still belongs to a live layout and its endpoints belong to that layout."
msgstr "返回范围是否仍属于有效布局，且两个端点是否都属于该布局。"

#. doc_classes/HTMLRange.xml
msgid "Returns whether the range's endpoints are equal."
msgstr "返回范围的两个端点是否相同。"

#. doc_classes/HTMLRange.xml
msgid "Returns the node containing the start boundary."
msgstr "返回起点所在的节点。"

#. doc_classes/HTMLRange.xml
msgid "Returns the node containing the end boundary."
msgstr "返回终点所在的节点。"

#. doc_classes/HTMLRange.xml
msgid "Returns the start offset in its container."
msgstr "返回起点在其容器内的偏移。"

#. doc_classes/HTMLRange.xml
msgid "Returns the end offset in its container."
msgstr "返回终点在其容器内的偏移。"

#. doc_classes/HTMLRange.xml
msgid "Sets the start boundary. If it follows the end or has a different tree root, both endpoints move to the new boundary."
msgstr "设置起点。如果起点位于终点之后或属于不同树根，两个端点都移动到新位置。"

#. doc_classes/HTMLRange.xml
msgid "Sets the end boundary. If it precedes the start or has a different tree root, both endpoints move to the new boundary."
msgstr "设置终点。如果终点位于起点之前或属于不同树根，两个端点都移动到新位置。"

#. doc_classes/HTMLRange.xml
msgid "Collapses the range to its end by default. Pass [code]true[/code] to collapse to the start."
msgstr "默认将范围折叠到终点。传入 [code]true[/code] 可折叠到起点。"

#. doc_classes/HTMLRange.xml
msgid "Selects the node by setting the endpoints immediately before and after it in its parent."
msgstr "将端点设置在父节点内该节点的前后，从而选中整个节点。"

#. doc_classes/HTMLRange.xml
msgid "Selects the entire character data or all child nodes of the given node."
msgstr "选择指定节点的全部字符数据或所有子节点。"

#. doc_classes/HTMLRange.xml
msgid "Returns the DOM text within the range, excluding comments and generated content."
msgstr "返回范围内的 DOM 文本，排除注释和生成内容。"

#. doc_classes/HTMLRange.xml
msgid "Returns the visible text-selection rectangles in document coordinates from the last layout."
msgstr "返回上次排版中文本选区的可见矩形，使用文档坐标。"

#. doc_classes/HTMLRange.xml
msgid "Returns a detached copy of the selected contents, preserving the shells of partially selected elements."
msgstr "返回选中内容的分离副本，保留部分选中元素的外壳。"

#. doc_classes/HTMLRange.xml
msgid "Moves the selected contents to a detached fragment and collapses the range. Fully selected nodes retain their handles."
msgstr "将选中内容移动到分离片段并折叠范围。完整选中的节点保留句柄。"

#. doc_classes/HTMLRange.xml
msgid "Removes the selected contents and collapses the range."
msgstr "移除选中内容并折叠范围。"

#. doc_classes/HTMLRange.xml
msgid "Inserts a same-layout node or fragment at the start. A text start container is split at its offset."
msgstr "在起点插入同布局的节点或片段。文本起点容器会在指定偏移处拆分。"

#. doc_classes/HTMLRange.xml
msgid "Moves the selected contents into the given element and selects that element. A partially selected non-text node rejects the operation."
msgstr "将选中内容移入指定元素并选中该元素。部分选中的非文本节点会使操作失败。"

#. doc_classes/HTMLSelection.xml
msgid "The live node selection of an HTML layout."
msgstr "HTML 布局的实时节点选区。"

#. doc_classes/HTMLSelection.xml
msgid "Get the selection with [method HTMLLayout.get_selection] or [method HTMLLabel.get_selection]. It holds at most one [HTMLRange]. The anchor can follow the focus in document order. In [HTMLLabel], this selection also controls rendered highlighting and copying."
msgstr "通过 [method HTMLLayout.get_selection] 或 [method HTMLLabel.get_selection] 获取选区。它最多持有一个 [HTMLRange]。锚点可以位于焦点之后。在 [HTMLLabel] 中，该选区也用于渲染高亮和复制。"

#. doc_classes/HTMLSelection.xml
msgid "Returns whether the selection still belongs to a live layout."
msgstr "返回选区是否仍属于有效布局。"

#. doc_classes/HTMLSelection.xml
msgid "Returns whether the selection is empty or its anchor and focus are the same."
msgstr "返回选区是否为空，或锚点与焦点是否重合。"

#. doc_classes/HTMLSelection.xml
msgid "Returns zero for an empty selection or one when a live range is attached."
msgstr "选区为空时返回零，关联实时范围时返回一。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the attached range for index zero, or [code]null[/code] when there is no such range."
msgstr "索引为零时返回关联的范围，没有对应范围时返回 [code]null[/code]。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the selection's anchor node."
msgstr "返回选区的锚点节点。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the offset of the selection's anchor."
msgstr "返回选区锚点的偏移。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the selection's focus node."
msgstr "返回选区的焦点节点。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the offset of the selection's focus."
msgstr "返回选区焦点的偏移。"

#. doc_classes/HTMLSelection.xml
msgid "Attaches a live range from the same document when the selection is empty."
msgstr "选区为空时关联同一文档中的实时范围。"

#. doc_classes/HTMLSelection.xml
msgid "Clears the selection."
msgstr "清除选区。"

#. doc_classes/HTMLSelection.xml
msgid "Moves the anchor and focus to the same boundary. Passing [code]null[/code] clears the selection."
msgstr "将锚点和焦点移动到同一位置。传入 [code]null[/code] 清除选区。"

#. doc_classes/HTMLSelection.xml
msgid "Moves the focus while keeping the anchor fixed."
msgstr "移动焦点并保持锚点位置。"

#. doc_classes/HTMLSelection.xml
msgid "Sets both ends of the selection and preserves their direction."
msgstr "设置选区的两个端点，并保留选择方向。"

#. doc_classes/HTMLSelection.xml
msgid "Selects the contents of the given node."
msgstr "选择给定节点的内容。"

#. doc_classes/HTMLSelection.xml
msgid "Returns the source text in the selection's live range."
msgstr "返回选区实时范围内的源文本。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Emitted with a snapshot of the layout's pending records. Each record has the keys type, target, added_nodes, removed_nodes, previous_sibling, next_sibling, attribute_name, and old_value."
msgstr "延迟发出该布局待交付记录的快照。记录包含 type、target、added_nodes、removed_nodes、previous_sibling、next_sibling、attribute_name 和 old_value 字段。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Observes DOM changes in one or more HTML layouts."
msgstr "观察一个或多个 HTML 布局中的 DOM 变更。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Call [method observe] for each target. Use [signal mutations_delivered] for deferred batches or [method take_records] for synchronous polling. Callback edits enter a later delivery. Clearing a layout drops its registered observations and undelivered records."
msgstr "对每个目标调用 [method observe]。通过 [signal mutations_delivered] 延迟接收记录，或使用 [method take_records] 同步取出。回调造成的编辑会进入后续批次。清空布局会移除其观察注册和待交付记录。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Observes the target using the boolean options child_list, attributes, character_data, subtree, attribute_old_value, and character_data_old_value. The attribute_filter option accepts an array of attribute names. At least one mutation category must be enabled."
msgstr "使用 child_list、attributes、character_data、subtree、attribute_old_value 和 character_data_old_value 布尔选项观察目标。attribute_filter 接受属性名数组。至少需要启用一种变更类别。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Removes all registrations and discards pending records."
msgstr "解除所有观察注册并丢弃待交付记录。"

#. doc_classes/HTMLMutationObserver.xml
msgid "Returns the queued record dictionaries in order and drains the queue."
msgstr "按顺序返回排队的记录字典，并清空记录队列。"

#. doc_classes/HTMLLayout.xml
msgid "Creates a live range with both endpoints at the start of the DOM document."
msgstr "创建实时范围，两个端点初始位于 DOM 文档起点。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the live document selection, or [code]null[/code] if the document is unavailable."
msgstr "返回实时文档选区，文档不可用时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a snapshot of serialized computed CSS properties. Lengths that depend on a layout box can retain percentages. See [method HTMLElement.get_bounding_rect] for geometry."
msgstr "返回序列化后的计算样式快照。依赖布局盒的长度可以保留百分比。几何信息见 [method HTMLElement.get_bounding_rect]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a serialized computed value for a connected element, including sampled animation values. Pass [code]::before[/code], [code]::after[/code], [code]::marker[/code], [code]::placeholder[/code], [code]::selection[/code], or [code]::backdrop[/code] to inspect a supported pseudo-element. Returns an empty string if the value is unavailable."
msgstr "返回已连接元素的序列化计算值，包括当前动画采样值。传入 [code]::before[/code]、[code]::after[/code]、[code]::marker[/code]、[code]::placeholder[/code]、[code]::selection[/code] 或 [code]::backdrop[/code] 查询受支持的伪元素。值不可用时返回空字符串。"

#. doc_classes/HTMLLabel.xml
#. doc_classes/HTMLLayout.xml
msgid "Returns the author stylesheets in source order. Each dictionary includes [code]id[/code], [code]owner[/code], [code]source[/code], [code]path[/code], [code]media[/code], and [code]disabled[/code]. The additional stylesheet is last. IDs apply to the current layout generation."
msgstr "按源码顺序返回作者样式表。每个字典包含 [code]id[/code]、[code]owner[/code]、[code]source[/code]、[code]path[/code]、[code]media[/code] 和 [code]disabled[/code]。附加样式表位于末尾。ID 仅适用于当前布局版本。"

#. doc_classes/HTMLLinkElement.xml
msgid "A link to an external document resource."
msgstr "指向文档外部资源的链接。"

#. doc_classes/HTMLLinkElement.xml
msgid "Represents [code]<link>[/code]. Dockit loads local and absolute HTTP(S) stylesheets for [code]rel=\"stylesheet\"[/code]. Local stylesheet text and dependencies can be baked into an imported [HTMLDocument]. HTTP(S) stylesheets load asynchronously and [member sheet] becomes available after a successful response. Changing [member href] discards previously edited CSSOM rules. Changing [member media] or [member disabled] preserves the associated stylesheet ID and rules."
msgstr "代表 [code]<link>[/code] 元素。Dockit 为 [code]rel=\"stylesheet\"[/code] 加载本地样式表和绝对 HTTP(S) 地址上的样式表。导入的 [HTMLDocument] 可内嵌本地样式表文本及依赖。HTTP(S) 样式表异步加载，收到有效响应后即可获取 [member sheet]。修改 [member href] 会清除之前编辑的 CSSOM 规则。修改 [member media] 或 [member disabled] 会保留关联样式表的 ID 和规则。"

#. doc_classes/HTMLLinkElement.xml
msgid "Resolves [member href] against the current document base URL."
msgstr "以当前文档的基准 URL 解析 [member href]。"

#. doc_classes/HTMLLinkElement.xml
#. doc_classes/HTMLStyleElement.xml
msgid "Returns the layout's CSSOM ID for the associated stylesheet, or [code]0[/code] if there is no associated sheet. Use the ID with [method HTMLLayout.get_css_rules], [method HTMLLayout.insert_rule], and [method HTMLLayout.delete_rule]."
msgstr "返回关联样式表在此布局中的 CSSOM ID。没有关联样式表时返回 [code]0[/code]。该 ID 可用于 [method HTMLLayout.get_css_rules]、[method HTMLLayout.insert_rule] 和 [method HTMLLayout.delete_rule]。"

#. doc_classes/HTMLLinkElement.xml
msgid "Reflects the boolean [code]disabled[/code] attribute. An initially disabled link loads its stylesheet when enabled for the first time."
msgstr "反映布尔属性 [code]disabled[/code]。初始禁用的链接在首次启用时加载样式表。"

#. doc_classes/HTMLLinkElement.xml
msgid "The original resource address."
msgstr "资源的原始地址。"

#. doc_classes/HTMLLinkElement.xml
#. doc_classes/HTMLStyleElement.xml
msgid "The media query list that controls when the stylesheet applies."
msgstr "控制样式表何时生效的媒体查询列表。"

#. doc_classes/HTMLLinkElement.xml
msgid "The raw list of link relationship tokens."
msgstr "链接关系标记的原始列表。"

#. doc_classes/HTMLLinkElement.xml
msgid "The declared MIME type of the linked resource."
msgstr "链接资源声明的 MIME 类型。"

#. doc_classes/HTMLStyleElement.xml
msgid "A stylesheet written directly in the document."
msgstr "直接写在文档中的样式表。"

#. doc_classes/HTMLStyleElement.xml
msgid "Represents [code]<style>[/code]. Changing its text discards previously edited CSSOM rules and resets the sheet's runtime disabled state. Changing [member media] or [member disabled] preserves the associated stylesheet ID and rules."
msgstr "代表 [code]<style>[/code] 元素。修改文本会清除之前编辑的 CSSOM 规则，并重置样式表的运行时禁用状态。修改 [member media] 或 [member disabled] 会保留关联样式表的 ID 和规则。"

#. doc_classes/HTMLStyleElement.xml
msgid "Disables the associated sheet at runtime. With no associated sheet, this property reads [code]false[/code] and writes have no effect."
msgstr "在运行时禁用关联的样式表。没有关联样式表时，读取返回 [code]false[/code]，赋值无效。"

#. doc_classes/HTMLStyleElement.xml
msgid "The original CSS text of the element. Read edited CSSOM rules using [method get_stylesheet_id] and [method HTMLLayout.get_css_rules]."
msgstr "元素的原始 CSS 文本。使用 [method get_stylesheet_id] 和 [method HTMLLayout.get_css_rules] 读取编辑后的 CSSOM 规则。"

#. doc_classes/HTMLStyleElement.xml
msgid "The declared MIME type of the inline stylesheet. An empty value defaults to [code]text/css[/code]."
msgstr "内联样式表声明的 MIME 类型。留空时默认为 [code]text/css[/code]。"

#. doc_classes/HTMLLinkElement.xml
#. doc_classes/HTMLStyleElement.xml
msgid "The associated stylesheet, or [code]null[/code] when no stylesheet is associated."
msgstr "关联的样式表。没有关联的样式表时返回 [code]null[/code]。"

#. doc_classes/HTMLStyleSheet.xml
msgid "A handle to an element's stylesheet in an HTML layout."
msgstr "HTML 布局中元素的样式表句柄。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Read [member HTMLLinkElement.sheet] or [member HTMLStyleElement.sheet] to get the stylesheet. It shares its rules with the layout's numeric CSSOM API. Changing the media condition or disabled state keeps the handle valid. Replacing the source, removing the owner from the document, or clearing or replacing the layout invalidates the handle."
msgstr "通过 [member HTMLLinkElement.sheet] 或 [member HTMLStyleElement.sheet] 获取样式表。它与布局的数字 ID CSSOM 接口共用规则。修改媒体条件或禁用状态时，句柄继续有效。替换来源、将所属元素移出文档、清空或替换布局时，句柄失效。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Deletes the top-level rule at the given zero-based [param index]. Returns [constant ERR_INVALID_PARAMETER] for a stale handle or invalid index."
msgstr "删除给定零基 [param index] 处的顶层规则。句柄或索引无效时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Returns a snapshot of the serialized top-level rules. A stale handle returns an empty array."
msgstr "返回序列化的顶层规则快照。句柄失效时返回空数组。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Inserts one CSS [param rule] at the given zero-based [param index]. Uses the same validation as [method HTMLLayout.insert_rule]. A stale handle returns [constant ERR_INVALID_PARAMETER]."
msgstr "在给定的零基 [param index] 处插入一条 CSS 规则 [param rule]。复用 [method HTMLLayout.insert_rule] 的校验逻辑。句柄失效时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Returns whether the handle still refers to the associated stylesheet."
msgstr "返回句柄是否仍指向关联的样式表。"

#. doc_classes/HTMLStyleSheet.xml
msgid "Whether the associated stylesheet is disabled. Set the owning element's disabled property to change this state."
msgstr "关联的样式表是否已禁用。设置所属元素的 disabled 属性可修改此状态。"

#. doc_classes/HTMLStyleSheet.xml
msgid "The resolved resource path or final response URL of an external stylesheet. Inline stylesheets return an empty string."
msgstr "外部样式表解析后的资源路径或最终响应 URL。内联样式表返回空字符串。"

#. doc_classes/HTMLStyleSheet.xml
msgid "The ID used by the layout's numeric CSSOM methods. A stale handle returns [code]0[/code]."
msgstr "布局的数字 ID CSSOM 方法使用的 ID。句柄失效时返回 [code]0[/code]。"

#. doc_classes/HTMLStyleSheet.xml
msgid "The owning element's current media query list."
msgstr "样式表所属元素当前的媒体查询列表。"

#. doc_classes/HTMLStyleSheet.xml
msgid "The element that owns the associated stylesheet. A stale handle returns [code]null[/code]."
msgstr "关联样式表的所属元素。句柄失效时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid "Returns a serialized snapshot of the top-level rules in the stylesheet identified by [param stylesheet]. Grouped and imported rules retain their place in the list."
msgstr "返回由 [param stylesheet] 指定的样式表顶层规则快照。分组规则和导入规则保留其在列表中的位置。"

#. doc_classes/HTMLLayout.xml
msgid "Inserts one CSS rule at the given zero-based index. The edit applies to this layout. Invalid rules or indices leave the stylesheet as it was."
msgstr "在给定的零基索引处插入一条 CSS 规则。编辑仅作用于此布局。规则或索引无效时保留原样式表。"

#. doc_classes/HTMLLayout.xml
msgid "Deletes the top-level rule at the given zero-based index in this layout."
msgstr "删除此布局样式表中给定零基索引处的顶层规则。"

#. doc_classes/HTMLLayout.xml
msgid "Tests a CSS property and value, or a [code]@supports[/code] condition when [param value] is empty."
msgstr "测试一组 CSS 属性和值；[param value] 为空时测试 [code]@supports[/code] 条件。"

#. doc_classes/HTMLLayout.xml
msgid "Tests whether the selector is accepted by the CSS selector parser."
msgstr "测试 CSS 选择器解析器是否接受该选择器。"

#. doc_classes/HTMLLayout.xml
msgid "Tests the media query against the current CSS viewport and preferences."
msgstr "按当前 CSS 视口和首选项测试媒体查询。"

#. doc_classes/HTMLLayout.xml
msgid "Returns CSS animations, CSS transitions, and scripted animations. Pass an element to restrict the snapshot to that target."
msgstr "返回 CSS 动画、CSS 过渡和脚本动画。传入元素时快照只包含以它为目标的动画。"

#. doc_classes/HTMLLayout.xml
msgid "Creates a scripted animation on the current layout clock. Keyframe dictionaries contain CSS property values and optional [code]offset[/code] and [code]easing[/code]. Options include [code]duration[/code], [code]delay[/code], [code]iterations[/code], [code]easing[/code], [code]direction[/code], and [code]fill[/code]. Times are in seconds. Returns [code]null[/code] for invalid input or an empty effect."
msgstr "在当前布局时钟上创建脚本动画。关键帧字典包含 CSS 属性值，以及可选的 [code]offset[/code] 和 [code]easing[/code]。选项包括 [code]duration[/code]、[code]delay[/code]、[code]iterations[/code]、[code]easing[/code]、[code]direction[/code] 和 [code]fill[/code]。时间以秒为单位。输入无效或没有动画效果时返回 [code]null[/code]。"

#. doc_classes/HTMLElement.xml
msgid "Returns the inline CSS value, or an empty string if the property has no serializable inline value."
msgstr "返回内联 CSS 值。属性没有可序列化的内联值时返回空字符串。"

#. doc_classes/HTMLElement.xml
msgid "Returns [code]important[/code] for an important inline property, or an empty string otherwise."
msgstr "内联属性带有优先级时返回 [code]important[/code]，其余情况返回空字符串。"

#. doc_classes/HTMLElement.xml
msgid "Returns a snapshot of inline property names and their serialized values."
msgstr "返回内联属性名及其序列化值的快照。"

#. doc_classes/HTMLElement.xml
msgid "Sets one inline CSS property. Pass [code]important[/code] separately for high priority. An empty value removes the property. Invalid inputs preserve existing declarations."
msgstr "设置一条内联 CSS 属性。通过单独传入 [code]important[/code] 指定高优先级。空值删除该属性。输入无效时保留现有声明。"

#. doc_classes/HTMLElement.xml
msgid "Removes the inline property and returns its previous value. A longhand can be removed from a shorthand when the remaining declarations can be represented separately."
msgstr "删除该内联属性并返回它的旧值。简写剩余声明可以分别表达时，可从简写中删除长属性。"

#. doc_classes/HTMLElement.xml
msgid "Returns the animation handles for this element, including its generated pseudo-elements."
msgstr "返回此元素及其生成伪元素的动画句柄。"

#. doc_classes/HTMLElement.xml
msgid "Creates a scripted animation on this element. See [method HTMLLayout.animate] for keyframes and timing options."
msgstr "在此元素上创建脚本动画。关键帧和时间选项见 [method HTMLLayout.animate]。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns whether the playback handle still belongs to its active layout and target."
msgstr "返回播放句柄是否仍关联有效布局和目标。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns the target element of the animation."
msgstr "返回动画的目标元素。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns [code]animation[/code], [code]transition[/code], or [code]script[/code]."
msgstr "返回 [code]animation[/code]、[code]transition[/code] 或 [code]script[/code]。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns the CSS animation name or the CSS transition property."
msgstr "返回 CSS 动画名称或 CSS 过渡属性。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns the target pseudo-element name, or an empty string for an element target."
msgstr "返回目标伪元素名称，以普通元素为目标时返回空字符串。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns [code]idle[/code], [code]running[/code], [code]paused[/code], or [code]finished[/code]."
msgstr "返回 [code]idle[/code]、[code]running[/code]、[code]paused[/code] 或 [code]finished[/code]。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns the total active duration in seconds, including iterations."
msgstr "返回有效区间的总秒数，包括所有迭代。"

#. doc_classes/HTMLAnimation.xml
msgid "Returns the playback position in seconds relative to the start of the animation clock."
msgstr "返回相对本动画时钟起点的播放秒数。"

#. doc_classes/HTMLAnimation.xml
msgid "Seeks to the given time in seconds and samples the effect."
msgstr "跳转到指定秒数并立即采样效果。"

#. doc_classes/HTMLAnimation.xml
msgid "Plays or resumes the current animation."
msgstr "播放或继续当前动画。"

#. doc_classes/HTMLAnimation.xml
msgid "Pauses at the current playback position."
msgstr "在当前播放位置暂停。"

#. doc_classes/HTMLAnimation.xml
msgid "Clears the effect and resets playback to idle."
msgstr "清除动画效果并将播放状态重置为空闲。"

#. doc_classes/HTMLAnimation.xml
msgid "Seeks to the end in the current playback direction. An infinite forward animation cannot be finished."
msgstr "跳转到当前播放方向的结束位置。无限循环的正向动画无法完成。"

#. doc_classes/HTMLAnimation.xml
msgid "Reverses the playback direction on the same layout clock."
msgstr "在同一布局时钟上反向播放。"

#. doc_classes/HTMLAnimation.xml
msgid "Playback control for a CSS or scripted HTML animation."
msgstr "CSS 或脚本 HTML 动画的播放控制。"

#. doc_classes/HTMLAnimation.xml
msgid "Use [method HTMLLayout.get_animations] or [method HTMLElement.animate] to obtain a handle. Animation time uses the owning layout clock. [HTMLLabel] drives that clock using its [member HTMLLabel.animation_process_mode]."
msgstr "通过 [method HTMLLayout.get_animations] 或 [method HTMLElement.animate] 获得句柄。动画时间由所属布局的时钟提供。[HTMLLabel] 使用 [member HTMLLabel.animation_process_mode] 推进该时钟。"

#. doc_classes/HTMLAudioElement.xml
msgid "An audio element with optional media controls."
msgstr "带有可选媒体控件的音频元素。"

#. doc_classes/HTMLAudioElement.xml
msgid "An [HTMLLabel] owns the audio player for a connected element. Use [member src] or child [code]<source>[/code] elements to select an imported project audio resource."
msgstr "由 [HTMLLabel] 持有已连接元素的音频播放器。使用 [member src] 或 [code]<source>[/code] 子元素选择已导入的项目音频资源。"

#. doc_classes/HTMLAudioElement.xml
msgid "Pauses playback at the current position."
msgstr "在当前位置暂停播放。"

#. doc_classes/HTMLAudioElement.xml
msgid "Starts or resumes playback. Returns an error if the element has no playback host or no source can be loaded by the selected backend."
msgstr "开始或继续播放。元素没有播放宿主或所选后端无法加载任何音频源时返回错误。"

#. doc_classes/HTMLAudioElement.xml
msgid "Starts playback automatically at runtime. Editor previews start on user input."
msgstr "在游戏运行时自动播放。编辑器预览由用户交互启动。"

#. doc_classes/HTMLAudioElement.xml
msgid "Shows the playback controls for the audio element."
msgstr "显示音频元素的播放控件。"

#. doc_classes/HTMLAudioElement.xml
msgid "Returns the project resource path of the selected audio source."
msgstr "返回所选音频源的项目资源路径。"

#. doc_classes/HTMLAudioElement.xml
msgid "The playback position, in seconds. Assigning a value seeks within the loaded audio stream."
msgstr "播放位置，以秒为单位。赋值后跳转到已加载音频流的相应位置。"

#. doc_classes/HTMLAudioElement.xml
msgid "The duration of the loaded audio, in seconds."
msgstr "已加载音频的时长，以秒为单位。"

#. doc_classes/HTMLAudioElement.xml
msgid "Restarts playback when the audio stream ends."
msgstr "音频流结束后重新播放。"

#. doc_classes/HTMLAudioElement.xml
msgid "Whether the audio output is muted. The HTML attribute provides the initial value."
msgstr "音频输出是否静音。HTML 属性提供初始值。"

#. doc_classes/HTMLAudioElement.xml
msgid "Whether playback is paused or stopped."
msgstr "播放是否处于暂停或停止状态。"

#. doc_classes/HTMLAudioElement.xml
msgid ""
"The audio source URL, relative to the HTML document or using [code]res://[/code], "
"[code]user://[/code], or [code]uid://[/code]. When the attribute is omitted, sources are tried in"
" child order."
msgstr ""
"音频源 URL，可相对于 HTML 文档，也可使用 [code]res://[/code]、[code]user://[/code] 或 "
"[code]uid://[/code]。省略属性时按子元素顺序尝试音频源。"

#. doc_classes/HTMLAudioElement.xml
msgid "The linear playback volume from [code]0.0[/code] to [code]1.0[/code]."
msgstr "线性播放音量，范围为 [code]0.0[/code] 到 [code]1.0[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "The audio bus used by audio elements. An unavailable bus name uses the current backend's Master bus."
msgstr "音频元素使用的总线。指定总线不可用时使用当前后端的 Master 总线。"

#. doc_classes/HTMLLabel.xml
msgid "Uses the FMOD audio player and bus list when the optional FMOD plugin is available."
msgstr "可选 FMOD 插件可用时，使用 FMOD 播放器和总线列表。"

#. doc_classes/HTMLVideoElement.xml
msgid "A video element with optional playback and fullscreen controls."
msgstr "带可选播放与全屏控件的视频元素。"

#. doc_classes/HTMLVideoElement.xml
msgid "An [HTMLLabel] owns the playback session for a connected video. Projects can install compatible VLC or FFmpeg add-ons to decode local video."
msgstr "由 [HTMLLabel] 管理已连接视频的播放。项目可安装兼容的 VLC 或 FFmpeg 插件来解码本地视频。"

#. doc_classes/HTMLVideoElement.xml
msgid "Closes the video fullscreen presentation and keeps the current playback session."
msgstr "关闭视频全屏界面，保留当前播放会话。"

#. doc_classes/HTMLVideoElement.xml
msgid "Returns whether the video is presented in fullscreen."
msgstr "返回视频当前是否全屏显示。"

#. doc_classes/HTMLVideoElement.xml
msgid "Pauses video playback at the current position."
msgstr "在当前位置暂停视频播放。"

#. doc_classes/HTMLVideoElement.xml
msgid "Requests playback. Returns [constant ERR_UNAVAILABLE] when the requested backend is missing."
msgstr "请求播放。所需的后端缺失时，返回 [constant ERR_UNAVAILABLE]。"

#. doc_classes/HTMLVideoElement.xml
msgid "Opens a separate fullscreen window on a supported desktop or fills the host viewport. Returns [constant ERR_BUSY] if another video is fullscreen in the same host window."
msgstr "在支持的桌面上打开独立全屏窗口，或铺满宿主视口。同一宿主窗口已有全屏视频时，返回 [constant ERR_BUSY]。"

#. doc_classes/HTMLVideoElement.xml
msgid "Requests a seek to [param seconds]. The target is clamped to the video duration. Returns [constant ERR_UNAVAILABLE] when seeking is unavailable."
msgstr "请求跳转到 [param seconds] 秒，目标时间限制在视频时长内。无法跳转时返回 [constant ERR_UNAVAILABLE]。"

#. doc_classes/HTMLVideoElement.xml
msgid "Starts playback automatically at runtime. Editor previews require user input."
msgstr "在游戏运行时自动播放。编辑器预览需手动播放。"

#. doc_classes/HTMLVideoElement.xml
msgid "Requests built-in controls. The video prepares its intrinsic size before playback, including in the editor. The video is drawn black and its controls are disabled when no selected backend is available."
msgstr "启用内置控件。运行时和编辑器中都会在播放前读取视频的固有尺寸。所选后端均不可用时，视频内容区显示黑色，内置控件禁用。"

#. doc_classes/HTMLVideoElement.xml
msgid "The original local resource path of the selected video."
msgstr "当前视频源原有的本地资源路径。"

#. doc_classes/HTMLVideoElement.xml
msgid "The current playback position in seconds. Use [method seek] to change it."
msgstr "当前播放位置，单位为秒。使用 [method seek] 修改。"

#. doc_classes/HTMLVideoElement.xml
msgid "The video duration in seconds, or zero while unknown."
msgstr "视频时长，单位为秒。时长未知时为零。"

#. doc_classes/HTMLVideoElement.xml
msgid "The HTML height attribute in CSS pixels."
msgstr "HTML 高度属性，单位为 CSS 像素。"

#. doc_classes/HTMLVideoElement.xml
msgid "Restarts the video when it reaches the end."
msgstr "视频播放结束时重新播放。"

#. doc_classes/HTMLVideoElement.xml
msgid "Whether video audio is muted. The HTML attribute supplies the initial state."
msgstr "视频音轨是否静音。HTML 属性提供初始值。"

#. doc_classes/HTMLVideoElement.xml
msgid "Whether video playback is paused or stopped."
msgstr "视频是否暂停或停止。"

#. doc_classes/HTMLVideoElement.xml
msgid "The local poster image displayed before a video frame is available."
msgstr "解码画面尚未可用时显示的本地海报图片。"

#. doc_classes/HTMLVideoElement.xml
msgid "The local video source. If omitted, the player tries the child [code]<source>[/code] elements in order."
msgstr "本地视频源。省略时按顺序尝试 [code]<source>[/code] 子元素。"

#. doc_classes/HTMLVideoElement.xml
msgid "The intrinsic video height in pixels, or zero while unknown."
msgstr "视频的固有高度，单位为像素。高度未知时为零。"

#. doc_classes/HTMLVideoElement.xml
msgid "The intrinsic video width in pixels, or zero while unknown."
msgstr "视频的固有宽度，单位为像素。宽度未知时为零。"

#. doc_classes/HTMLVideoElement.xml
msgid "Linear video audio volume from [code]0.0[/code] to [code]1.0[/code]."
msgstr "视频的线性音量，范围为 [code]0.0[/code] 到 [code]1.0[/code]。"

#. doc_classes/HTMLVideoElement.xml
msgid "The HTML width attribute in CSS pixels."
msgstr "HTML 宽度属性，单位为 CSS 像素。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the current fullscreen video owned by this label, if any."
msgstr "返回此控件当前管理的全屏视频，没有时为空。"

#. doc_classes/HTMLLabel.xml
msgid "The video decoder. Auto tries the available FFmpeg and VLC add-ons in that order for each source."
msgstr "视频解码后端。自动模式对每个来源依次尝试可用的 FFmpeg 和 VLC 插件。"

#. doc_classes/HTMLLabel.xml
msgid "The Godot audio bus for video playback."
msgstr "用于视频播放的 Godot 音频总线。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when a video cannot open any of its sources."
msgstr "视频的所有候选来源打开失败时发出。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when the video enters or exits fullscreen."
msgstr "视频进入或退出全屏时发出。"

#. doc_classes/HTMLLabel.xml
msgid "Selects an available video decoder automatically."
msgstr "自动选择可用的视频解码后端。"

#. doc_classes/HTMLLabel.xml
msgid "Uses the optional EIRTeam.FFmpeg add-on."
msgstr "使用可选的 EIRTeam.FFmpeg 插件。"

#. doc_classes/HTMLLabel.xml
msgid "Uses the optional godot-vlc add-on."
msgstr "使用可选的 godot-vlc 插件。"

#. doc_classes/HTMLDialogElement.xml
msgid "An HTML dialog that can open in the document or in the modal top layer."
msgstr "可在文档内或模态顶层中打开的 HTML 对话框。"

#. doc_classes/HTMLDialogElement.xml
msgid "Emitted after [method close] closes an open dialog and [HTMLLabel] processes focus restoration."
msgstr "[method close] 关闭已打开的对话框，并且 [HTMLLabel] 处理完焦点恢复后发出。"

#. doc_classes/HTMLDialogElement.xml
msgid ""
"Opens a connected dialog in the modal top layer. Returns [constant ERR_INVALID_PARAMETER] if it "
"is detached or already open as a non-modal dialog."
msgstr "在模态顶层打开已连接的对话框。如果对话框已分离，或已作为非模态对话框打开，则返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLDialogElement.xml
msgid ""
"Opens the dialog in the document. Returns [constant ERR_INVALID_PARAMETER] if it is already open "
"as a modal."
msgstr "在文档内打开对话框。如果已作为模态对话框打开，则返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLDialogElement.xml
msgid ""
"Reflects the HTML [code]open[/code] attribute. Setting this property to [code]true[/code] opens a"
" regular dialog. Setting it to [code]false[/code] removes the attribute and leaves the top layer "
"if needed."
msgstr "反映 HTML 的 [code]open[/code] 属性。设为 [code]true[/code] 会打开普通对话框。设为 [code]false[/code] 会移除该属性，并在需要时退出模态顶层。"

#. doc_classes/HTMLDialogElement.xml
msgid "Represents [code]<dialog>[/code]. A modal dialog and its CSS [code]::backdrop[/code] render above the document. In [HTMLLabel], only the topmost modal accepts interaction. Tab cycles through its focusable elements. After menus and IME handle Escape, [member closed_by] determines whether to request a close."
msgstr "表示 [code]<dialog>[/code]。模态对话框与 CSS [code]::backdrop[/code] 绘制在文档上方。在 [HTMLLabel] 中，只有栈顶模态对话框接收交互。Tab 在其中的可聚焦元素间循环。菜单和输入法处理 Escape 后，[member closed_by] 决定是否发起关闭请求。"

#. doc_classes/HTMLDialogElement.xml
msgid "Returns whether this dialog is in its layout's modal top layer."
msgstr "返回此对话框是否位于其布局的模态顶层。"

#. doc_classes/HTMLDialogElement.xml
msgid "The result associated with this dialog. The initial value is an empty string."
msgstr "此对话框关联的结果，初始值为空字符串。"

#. doc_classes/HTMLDialogElement.xml
msgid "The effective policy for user dismissal. [code]any[/code] allows Escape and clicks outside the dialog within the label. [code]closerequest[/code] allows Escape. [code]none[/code] disables both. A missing or invalid [code]closedby[/code] attribute acts as [code]closerequest[/code] for a modal dialog and [code]none[/code] otherwise. The raw attribute is available through [method HTMLElement.get_attribute]."
msgstr "用户关闭对话框的生效策略。[code]any[/code] 允许 Escape 和在控件内点击对话框外部。[code]closerequest[/code] 允许 Escape。[code]none[/code] 禁用两者。[code]closedby[/code] 属性缺失或无效时，模态对话框按 [code]closerequest[/code] 处理，其他对话框按 [code]none[/code] 处理。可通过 [method HTMLElement.get_attribute] 读取原始属性。"

#. doc_classes/HTMLDialogElement.xml
msgid "Emitted synchronously when a script, Escape, or an outside click requests dismissal. Call [method HTMLDialogCloseRequest.prevent_default] in the callback to keep the dialog open. Calls to [method close] and [code]method=\"dialog\"[/code] submissions close directly."
msgstr "脚本、Escape 或点击对话框外部发起关闭请求时同步发出。在回调内调用 [method HTMLDialogCloseRequest.prevent_default] 可以保持对话框打开。调用 [method close] 或提交 [code]method=\"dialog\"[/code] 表单会直接关闭对话框。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "A synchronous request to close an HTML dialog."
msgstr "用于关闭 HTML 对话框的同步请求。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "Emitted by [signal HTMLDialogElement.close_requested]. Connect directly to the signal and call [method prevent_default] during the callback to keep the dialog open."
msgstr "由 [signal HTMLDialogElement.close_requested] 发出。直接连接信号并在回调内调用 [method prevent_default] 可以保持对话框打开。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "Returns whether a listener canceled this request."
msgstr "返回监听器是否已取消此请求。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "Cancels the default close action during synchronous signal delivery. Deferred calls have no effect."
msgstr "在同步信号派发期间取消默认关闭操作。延迟调用没有效果。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "The source of this close request."
msgstr "此关闭请求的来源。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "The proposed result. A [code]null[/code] value preserves [member HTMLDialogElement.return_value]."
msgstr "拟写入的结果。[code]null[/code] 会保留 [member HTMLDialogElement.return_value] 的原值。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "A GDScript call to [method HTMLDialogElement.request_close]."
msgstr "GDScript 调用了 [method HTMLDialogElement.request_close]。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "A press of the Escape key."
msgstr "按下了 Escape 键。"

#. doc_classes/HTMLDialogCloseRequest.xml
msgid "A primary pointer click outside the active dialog."
msgstr "主指针点击了当前对话框的外部。"

#. doc_classes/HTMLHtmlElement.xml
msgid "The root element of an HTML document."
msgstr "HTML 文档的根元素。"

#. doc_classes/HTMLHtmlElement.xml
msgid "Represents [code]<html>[/code]. Read shared attributes such as [member HTMLElement.lang] through the inherited API."
msgstr "表示 [code]<html>[/code]。通过继承的接口读取 [member HTMLElement.lang] 等公共属性。"

#. doc_classes/HTMLHeadElement.xml
msgid "The metadata container of an HTML document."
msgstr "HTML 文档的元数据容器。"

#. doc_classes/HTMLHeadElement.xml
msgid "Represents [code]<head>[/code]. Its children can be queried and edited through [HTMLElement]."
msgstr "表示 [code]<head>[/code]。通过 [HTMLElement] 查询和编辑子节点。"

#. doc_classes/HTMLBodyElement.xml
msgid "The body element of an HTML document."
msgstr "HTML 文档的正文元素。"

#. doc_classes/HTMLBodyElement.xml
msgid "Represents [code]<body>[/code]. Use the inherited API to read and edit its contents."
msgstr "表示 [code]<body>[/code]。通过继承的接口读取和编辑内容。"

#. doc_classes/HTMLTitleElement.xml
msgid "The title element of an HTML document."
msgstr "HTML 文档的标题元素。"

#. doc_classes/HTMLTitleElement.xml
msgid "Represents [code]<title>[/code]. [method HTMLLayout.get_title] returns the document title with normalized ASCII whitespace."
msgstr "表示 [code]<title>[/code]。[method HTMLLayout.get_title] 返回规范化 ASCII 空白后的文档标题。"

#. doc_classes/HTMLTitleElement.xml
msgid "The original text of the title."
msgstr "标题的原始文字。"

#. doc_classes/HTMLMetaElement.xml
msgid "An HTML metadata declaration."
msgstr "HTML 元数据声明。"

#. doc_classes/HTMLMetaElement.xml
msgid "Represents [code]<meta>[/code]. These properties reflect metadata attributes. Documents are read as UTF-8."
msgstr "表示 [code]<meta>[/code]。这些属性反映元数据声明。文档以 UTF-8 读取。"

#. doc_classes/HTMLMetaElement.xml
msgid "The declared character encoding."
msgstr "声明的字符编码。"

#. doc_classes/HTMLMetaElement.xml
msgid "The metadata content."
msgstr "元数据内容。"

#. doc_classes/HTMLMetaElement.xml
msgid "Reflects the [code]http-equiv[/code] attribute."
msgstr "反映 [code]http-equiv[/code] 属性。"

#. doc_classes/HTMLMetaElement.xml
msgid "The declared media condition."
msgstr "声明的媒体条件。"

#. doc_classes/HTMLMetaElement.xml
msgid "The metadata name."
msgstr "元数据名称。"

#. doc_classes/HTMLBaseElement.xml
msgid "A document base URL or default link target."
msgstr "文档基准 URL 或默认链接目标。"

#. doc_classes/HTMLBaseElement.xml
msgid "Represents [code]<base>[/code]. The first connected base with an [code]href[/code] attribute determines the document's local resource base. Read the effective URL with [method HTMLLayout.get_base_uri]."
msgstr "表示 [code]<base>[/code]。首个已连接且带 [code]href[/code] 属性的基准元素决定文档的本地资源基准。通过 [method HTMLLayout.get_base_uri] 读取生效地址。"

#. doc_classes/HTMLBaseElement.xml
msgid "Resolves the base element's own address against the original document source."
msgstr "相对于原始文档来源解析此基准元素自身的地址。"

#. doc_classes/HTMLBaseElement.xml
msgid "The original base address. A trailing slash denotes a directory."
msgstr "原始基准地址。斜杠结尾表示目录。"

#. doc_classes/HTMLBaseElement.xml
msgid "The declared default target for navigation."
msgstr "声明的默认导航目标。"

#. doc_classes/HTMLScriptElement.xml
msgid "An inert script or data element."
msgstr "惰性的脚本或数据元素。"

#. doc_classes/HTMLScriptElement.xml
msgid "Represents [code]<script>[/code]. Its text and attributes are accessible to GDScript as DOM data. A runtime [HTMLLabel] can use a script with type [code]text/gdscript[/code] to select a project script from [member HTMLLabel.behavior_scripts]."
msgstr "表示 [code]<script>[/code]。GDScript 可以读取其 DOM 文本和属性。运行中的 [HTMLLabel] 可通过类型为 [code]text/gdscript[/code] 的标签选择 [member HTMLLabel.behavior_scripts] 中登记的项目脚本。"

#. doc_classes/HTMLBehavior.xml
msgid "Base class for project scripts attached to an HTML label."
msgstr "挂载到 HTML 控件的项目脚本基类。"

#. doc_classes/HTMLScriptElement.xml
msgid "Reflects the [code]async[/code] attribute."
msgstr "反映 [code]async[/code] 属性。"

#. doc_classes/HTMLScriptElement.xml
msgid "Reflects the [code]defer[/code] attribute."
msgstr "反映 [code]defer[/code] 属性。"

#. doc_classes/HTMLScriptElement.xml
msgid "Reflects the [code]nomodule[/code] attribute."
msgstr "反映 [code]nomodule[/code] 属性。"

#. doc_classes/HTMLScriptElement.xml
msgid "The original source attribute."
msgstr "原始来源属性。"

#. doc_classes/HTMLScriptElement.xml
msgid "The text inside the element."
msgstr "元素中的文字。"

#. doc_classes/HTMLScriptElement.xml
msgid "The declared script or data type."
msgstr "声明的脚本或数据类型。"

#. doc_classes/HTMLAnchorElement.xml
msgid "Returns the link address resolved against the current document base. Activating a link still reports the original [member href]."
msgstr "返回按当前文档基准解析的链接地址。激活链接时仍报告原始 [member href]。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Returns the current base URL of this document."
msgstr "返回此文档当前的基准 URL。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Creates an empty document fragment owned by this document."
msgstr "创建一个属于此文档的空文档片段。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Creates a detached element owned by this document."
msgstr "创建一个属于此文档的分离元素。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Creates a detached text node owned by this document."
msgstr "创建一个属于此文档的分离文本节点。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Returns the first element with the given case-sensitive ID, or [code]null[/code]."
msgstr "返回给定 ID 的首个元素，找不到时返回 [code]null[/code]。ID 区分大小写。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Returns the first element in document order that matches [param selector], or [code]null[/code]."
msgstr "按文档顺序返回首个匹配 [param selector] 的元素，找不到时返回 [code]null[/code]。"

#. doc_classes/HTMLDocumentNode.xml
msgid "Returns a snapshot of all matching elements in document order."
msgstr "按文档顺序返回所有匹配元素的快照。"

#. doc_classes/HTMLDocumentNode.xml
msgid "The document's body or frameset element, if present."
msgstr "文档的 body 或 frameset 元素（如果存在）。"

#. doc_classes/HTMLDocumentNode.xml
msgid "The document's root element."
msgstr "文档的根元素。"

#. doc_classes/HTMLLayout.xml
msgid "Returns the effective base URL for document-relative resources. The first connected [HTMLBaseElement] with an [code]href[/code] attribute can replace the source URL or the configured base directory."
msgstr "返回文档相对资源的生效基准 URL。首个已连接且有 [code]href[/code] 属性的 [HTMLBaseElement] 可以覆盖源文件地址或配置的基准目录。"

#. doc_classes/HTMLLabel.xml
msgid "Returns the effective base URL of the displayed document. See [method HTMLLayout.get_base_uri]."
msgstr "返回所显示文档的生效基准 URL。请参阅 [method HTMLLayout.get_base_uri]。"

#. doc_classes/HTMLInputElement.xml
msgid "Returned by queries and [method HTMLLayout.create_element] for [code]<input>[/code]. [HTMLLabel] supports text, search, tel, url, email, password, number, range, date, month, week, time, datetime-local, color, file, checkbox, radio, button, submit, reset, image, and hidden.\nText and picker values are tracked separately from the markup default. Checkbox and radio values default to [code]on[/code]. A selected file contributes a read-only [HTMLInputFile] to form data. Script assignments emit no user editing signals."
msgstr "查询元素或调用 [method HTMLLayout.create_element] 创建 [code]<input>[/code] 时返回。[HTMLLabel] 支持 text、search、tel、url、email、password、number、range、date、month、week、time、datetime-local、color、file、checkbox、radio、button、submit、reset、image 和 hidden。\n文本和选择器的当前值与标记中的默认值分别保存。复选框和单选按钮的默认值为 [code]on[/code]。用户选择的文件以只读 [HTMLInputFile] 写入表单数据。脚本赋值不会发出用户编辑信号。"

#. doc_classes/HTMLInputElement.xml
msgid "Returns a snapshot of the selected files. Returns an empty array for other input types."
msgstr "返回已选文件的快照。其他输入类型返回空数组。"

#. doc_classes/HTMLInputElement.xml
msgid "Returns the boolean flags [code]will_validate[/code], [code]valid[/code], [code]value_missing[/code], [code]type_mismatch[/code], [code]bad_input[/code], [code]pattern_mismatch[/code], [code]range_underflow[/code], [code]range_overflow[/code], [code]step_mismatch[/code], [code]too_short[/code], and [code]too_long[/code]. The [code]pattern[/code] attribute uses Godot's [RegEx] syntax and matches the full value. ECMAScript Unicode Sets syntax may differ."
msgstr "返回布尔标志 [code]will_validate[/code]、[code]valid[/code]、[code]value_missing[/code]、[code]type_mismatch[/code]、[code]bad_input[/code]、[code]pattern_mismatch[/code]、[code]range_underflow[/code]、[code]range_overflow[/code]、[code]step_mismatch[/code]、[code]too_short[/code] 和 [code]too_long[/code]。[code]pattern[/code] 属性使用 Godot 的 [RegEx] 语法并匹配整个值。ECMAScript Unicode Sets 语法可能有差异。"

#. doc_classes/HTMLInputElement.xml
msgid "Returns [code]year[/code], [code]month[/code], [code]day[/code], [code]hour[/code], [code]minute[/code], [code]second[/code], and [code]millisecond[/code]. A month starts on its first day, a week starts on Monday, and a time uses the date 1970-01-01. Returns an empty dictionary when the value is empty or this operation does not apply, including for datetime-local."
msgstr "返回 [code]year[/code]、[code]month[/code]、[code]day[/code]、[code]hour[/code]、[code]minute[/code]、[code]second[/code] 和 [code]millisecond[/code]。月份取第一天，周取星期一，时间使用日期 1970-01-01。空值和不适用的类型（包括 datetime-local）返回空字典。"

#. doc_classes/HTMLInputElement.xml
msgid "Sets the input from date or time parts. An empty dictionary clears the value. Returns [constant ERR_UNAVAILABLE] for input types without a date getter and [constant ERR_INVALID_PARAMETER] for invalid parts."
msgstr "用日期或时间分量设置输入值。传入空字典将清空值。没有对应日期读取接口时返回 [constant ERR_UNAVAILABLE]，分量无效时返回 [constant ERR_INVALID_PARAMETER]。"

#. doc_classes/HTMLInputElement.xml
msgid "Opens the input picker or suggestions in the owning [HTMLLabel]. The element must be visible, connected, mutable, and within the active dialog if one is modal."
msgstr "在所属 [HTMLLabel] 打开选择器或建议列表。元素必须可见、已连接且可编辑。有模态对话框时，元素还必须位于活动对话框中。"

#. doc_classes/HTMLInputElement.xml
msgid "Increases a numeric or temporal value using its configured step and limits. Returns [constant ERR_UNAVAILABLE] when stepping does not apply or [code]step=\"any\"[/code]."
msgstr "按配置的步长和范围增大数值或日期时间值。步进不适用或设置了 [code]step=\"any\"[/code] 时返回 [constant ERR_UNAVAILABLE]。"

#. doc_classes/HTMLInputElement.xml
msgid "Decreases a numeric or temporal value using its configured step and limits."
msgstr "按配置的步长和范围减小数值或日期时间值。"

#. doc_classes/HTMLInputElement.xml
msgid "The current input value. For a file input, this is an empty string or the first selected file name with the standard fake-path prefix. Only an empty assignment can change a file input's value."
msgstr "当前输入值。文件输入返回空字符串，或带标准虚拟路径前缀的第一个文件名。只有赋空字符串才能修改文件输入的值。"

#. doc_classes/HTMLInputElement.xml
msgid "The mixed state of a checkbox. It changes the appearance and is cleared by user activation. Form data uses [member checked]."
msgstr "复选框的混合状态。它改变外观，并在用户激活时清除。表单数据使用 [member checked]。"

#. doc_classes/HTMLInputElement.xml
msgid "The numeric value, or NaN when unavailable. Months count from January 1970, times use milliseconds since midnight, and other temporal values use milliseconds from the civil epoch without applying a timezone offset."
msgstr "数值，不可用时为 NaN。月份以 1970 年 1 月为起点计数，时间以午夜后的毫秒计数，其他日期时间值以民用纪元以来的毫秒计数，无时区偏移。"

#. doc_classes/HTMLInputFile.xml
msgid "A read-only handle to a file selected through an HTML input."
msgstr "HTML 文件输入中所选文件的只读句柄。"

#. doc_classes/HTMLInputFile.xml
msgid "Returned by [method HTMLInputElement.get_files] and as the value of a file entry in [method HTMLFormElement.get_form_data]. The handle retains access to the selected file while referenced and exposes its base name."
msgstr "由 [method HTMLInputElement.get_files] 返回，也可作为 [method HTMLFormElement.get_form_data] 中的文件值。持有该句柄时可以访问所选文件及其文件名。"

#. doc_classes/HTMLInputFile.xml
msgid "Reads up to [param count] bytes at the zero-based [param offset]. Returns an empty array when the range is empty, invalid, or outside the file."
msgstr "从零基 [param offset] 开始读取至多 [param count] 个字节。范围为空、无效或超出文件时返回空数组。"

#. doc_classes/HTMLInputFile.xml
msgid "The selected file's base name."
msgstr "所选文件的文件名。"

#. doc_classes/HTMLInputFile.xml
msgid "The selected file's size in bytes at selection time."
msgstr "选择时的文件大小，单位为字节。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when the user changes an input value or checked state. Read the new state from the element."
msgstr "当用户更改输入值或勾选状态时发出。可从元素读取新状态。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when the user confirms an edit. Text fields commit with Enter or on focus loss. Toggle controls and confirmed picker selections commit immediately after [signal input_changed]."
msgstr "当用户确认编辑时发出。文本字段通过 Enter 或失焦提交。勾选控件和选择器确认后紧接着 [signal input_changed] 提交。"

#. doc_classes/HTMLFormElement.xml
msgid "Returns ordered dictionaries with [code]name[/code] and [code]value[/code] keys. Repeated names remain separate. File entries hold [HTMLInputFile] values. The optional submitter must be enabled and associated with this form. An image submitter produces two coordinate entries whose values default to [code]0[/code]."
msgstr "返回包含 [code]name[/code] 和 [code]value[/code] 键的有序字典。重复名称各占一项。文件项的值是 [HTMLInputFile]。可选的提交按钮必须已启用并关联该表单。图像提交按钮产生两个坐标条目，默认值为 [code]0[/code]。"

#. doc_classes/HTMLEvent.xml
msgid "A DOM event delivered to element listeners."
msgstr "派发给元素监听器的 DOM 事件。"

#. doc_classes/HTMLEventTarget.xml
msgid "A DOM event target: a node, the document node, or the document window."
msgstr "DOM 事件目标：节点、文档节点或文档窗口。"

#. doc_classes/HTMLFocusEvent.xml
msgid ""
"A focus event for [code]focus[/code], [code]blur[/code], [code]focusin[/code], and "
"[code]focusout[/code]."
msgstr "[code]focus[/code]、[code]blur[/code]、[code]focusin[/code] 和 [code]focusout[/code] 的焦点事件。"

#. doc_classes/HTMLSubmitEvent.xml
msgid "A form event for [code]submit[/code] and [code]reset[/code]."
msgstr "[code]submit[/code] 与 [code]reset[/code] 的表单事件。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "A key event for [code]keydown[/code] and [code]keyup[/code]."
msgstr "[code]keydown[/code] 与 [code]keyup[/code] 的键盘事件。"

#. doc_classes/HTMLPointerEvent.xml
msgid "A pointer event for mouse and touch input."
msgstr "鼠标和触摸输入对应的指针事件。"

#. doc_classes/HTMLWheelEvent.xml
msgid "A cancelable wheel event with pixel deltas."
msgstr "具有像素增量且可取消的滚轮事件。"

#. doc_classes/HTMLCustomEvent.xml
msgid "An event that carries a script-defined payload."
msgstr "携带脚本自定义载荷的事件。"

#. doc_classes/HTMLEvent.xml
msgid ""
"Cancels the built-in action for this event. Has no effect unless [member cancelable] is "
"[code]true[/code], or when the running listener was registered with [code]passive[/code]."
msgstr "取消此事件的默认动作。仅当 [member cancelable] 为 [code]true[/code] 且当前监听器不是以 [code]passive[/code] 注册时才有效。"

#. doc_classes/HTMLMouseEvent.xml
msgid ""
"Carries the pointer position in the host [HTMLLabel]'s local coordinates, modifier state, and "
"[member related_target] during pointer transitions. For clicks on the same target, [member "
"detail] continues when clicks are less than 500 milliseconds apart and less than 5 pixels apart. "
"The second click dispatches [code]dblclick[/code] after the [code]click[/code] default action."
msgstr "携带指针在宿主 [HTMLLabel] 局部坐标中的位置、修饰键状态，以及指针转换期间的 [member related_target]。同一目标上的连续点击间隔小于 500 毫秒且移动距离小于 5 像素时，[member detail] 会递增。第二次点击会在 [code]click[/code] 默认动作之后派发 [code]dblclick[/code]。"

#. doc_classes/HTMLWheelEvent.xml
msgid ""
"Dispatched before the host [HTMLLabel] applies wheel scrolling. Positive [member delta] values "
"move down and right. Each Godot wheel step maps to 36 pixels. Calling [method "
"HTMLEvent.prevent_default] prevents the label's default wheel scrolling. The event uses "
"[constant DELTA_MODE_PIXEL]."
msgstr "宿主 [HTMLLabel] 应用滚轮滚动前会派发此事件。[member delta] 的正值表示向下和向右移动。Godot 的每个滚轮步进对应 36 像素。调用 [method HTMLEvent.prevent_default] 会阻止标签的默认滚轮滚动。此事件使用 [constant DELTA_MODE_PIXEL]。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid ""
"Delivered to the focused element, or to the document body when no element has focus. Cancelling "
"[code]keydown[/code] suppresses the built-in handling for the same press, including focus "
"traversal with Tab, activation with Enter and Space, and text insertion in focused fields. Key "
"events are not delivered while an input method is composing text."
msgstr ""
"派发给获得焦点的元素；没有元素获得焦点时派发给文档 body。取消 [code]keydown[/code] 会抑制本次按键的内置处理，包括 Tab 焦点遍历、Enter "
"与空格激活，以及在聚焦字段中插入文字。输入法组字期间不派发键盘事件。"

#. doc_classes/HTMLEventTarget.xml
msgid ""
"Dispatches [param event] from this target using the capture, target, and bubble phases. Returns "
"[code]false[/code] when a listener cancelled the default action. Events created by scripts report"
" [code]is_trusted[/code] as [code]false[/code]; they still propagate and can be cancelled."
msgstr ""
"从此目标按捕获、目标和冒泡阶段派发 [param event]。监听器取消默认动作时返回 [code]false[/code]。脚本创建的事件 [code]is_trusted[/code] 为"
" [code]false[/code]，但仍会传播并可被取消。"

#. doc_classes/HTMLEvent.xml
msgid ""
"If [code]true[/code], [method prevent_default] can cancel the built-in action. Assignment is "
"ignored while the event is being dispatched."
msgstr "为 [code]true[/code] 时，[method prevent_default] 可取消默认动作。派发期间赋值会被忽略。"

#. doc_classes/HTMLEvent.xml
msgid ""
"If [code]true[/code], the event propagates from the target's parent up to the document node after"
" the target phase. Assignment is ignored while the event is being dispatched."
msgstr "为 [code]true[/code] 时，事件在目标阶段结束后从目标的父节点向文档节点冒泡。派发期间赋值会被忽略。"

#. doc_classes/HTMLEventTarget.xml
msgid ""
"Removes a listener registered with [method add_event_listener]. The [code]capture[/code] entry of"
" [param options] must match the registration."
msgstr "移除通过 [method add_event_listener] 注册的监听器。[param options] 中的 [code]capture[/code] 必须与注册时一致。"

#. doc_classes/HTMLWindow.xml
msgid "Returns the document node this window belongs to, or [code]null[/code] when the window is invalid."
msgstr "返回此窗口所属的文档节点；窗口失效时返回 [code]null[/code]。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns the elements matched by CSS [code]:hover[/code], ordered from the innermost element "
"outward to the document root. The array is empty when the pointer is outside the content, during "
"a selection drag, and while a modal dialog blocks interaction. The chain only updates through "
"[method HTMLLabel] interaction processing."
msgstr ""
"返回匹配 CSS [code]:hover[/code] 的元素，按从最内层元素到文档根的顺序排列。指针在内容之外、拖选过程中以及模态对话框阻塞交互时，数组为空。悬停链仅在 [method "
"HTMLLabel] 的交互处理中更新。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the root node of this control's live document, or [code]null[/code] when the source has "
"not been parsed yet. Register listeners on this node to handle events for all of its descendants,"
" then use [method HTMLElement.closest] on the event's [member HTMLEvent.target] to find the "
"element that owns the action. The handle is invalidated when the source is reparsed."
msgstr ""
"返回此控件实时文档的根节点；源内容尚未解析时返回 [code]null[/code]。在此节点上注册监听器即可处理其所有后代的事件，再用事件 [member HTMLEvent.target] "
"上的 [method HTMLElement.closest] 找到动作所属元素。源内容重新解析后句柄失效。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"Returns the window event target for this document. Listeners registered on it receive events from"
" every connected node."
msgstr "返回此文档的 window 事件目标。注册在其上的监听器会收到所有已连接节点的事件。"

#. doc_classes/HTMLEventTarget.xml
msgid ""
"Returns whether the target still belongs to the current document. Window handles become invalid "
"when their document is replaced."
msgstr "返回目标是否仍属于当前文档。文档被替换后 window 句柄失效。"

#. doc_classes/HTMLEventTarget.xml
msgid "Returns whether this target has at least one listener registered for [param type]."
msgstr "返回此目标是否为 [param type] 注册了至少一个监听器。"

#. doc_classes/HTMLEvent.xml
msgid ""
"Stops the event from reaching later nodes and skips the remaining listeners registered on the "
"current node."
msgstr "阻止事件到达后续节点，并跳过当前节点上剩余的监听器。"

#. doc_classes/HTMLEvent.xml
msgid ""
"Stops the event from reaching later nodes in the propagation path. Listeners already queued on "
"the current node still run."
msgstr "阻止事件到达传播路径中的后续节点。当前节点上已排队的监听器仍会执行。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "The Unicode code point produced by the press, or [code]0[/code] for non-printing keys."
msgstr "按键产生的 Unicode 码点；非打印键为 [code]0[/code]。"

#. doc_classes/HTMLMouseEvent.xml
msgid "The bit mask of buttons held when the event was produced."
msgstr "事件产生时按住的按键位掩码。"

#. doc_classes/HTMLMouseEvent.xml
msgid "The other event target involved in an over, out, enter, or leave transition, or [code]null[/code]."
msgstr "进入、离开等悬停转换中涉及的另一个事件目标；没有目标时为 [code]null[/code]。"

#. doc_classes/HTMLSubmitEvent.xml
msgid ""
"The button that initiated the submission, or [code]null[/code] for a programmatic submit or a "
"reset."
msgstr "触发提交的按钮；脚本提交或重置时为 [code]null[/code]。"

#. doc_classes/HTMLCustomEvent.xml
msgid "The custom payload delivered to listeners."
msgstr "传递给监听器的自定义载荷。"

#. doc_classes/HTMLWindow.xml
msgid "The document node this window belongs to."
msgstr "此窗口所属的文档节点。"

#. doc_classes/HTMLEvent.xml
msgid "The event is at its target."
msgstr "事件处于目标阶段。"

#. doc_classes/HTMLEvent.xml
msgid "The event is not being dispatched."
msgstr "事件未在派发中。"

#. doc_classes/HTMLEvent.xml
msgid "The event is travelling from the document down to the target's parent."
msgstr "事件正从文档向下传递到目标的父节点。"

#. doc_classes/HTMLEvent.xml
msgid "The event is travelling from the target's parent up to the document node."
msgstr "事件正从目标的父节点向上传递到文档节点。"

#. doc_classes/HTMLWindow.xml
msgid "The event target for a live document window."
msgstr "实时文档窗口的事件目标。"

#. doc_classes/HTMLEvent.xml
msgid ""
"The event type, such as [code]click[/code] or [code]keydown[/code]. Assignment is ignored while "
"the event is being dispatched."
msgstr "事件类型，例如 [code]click[/code] 或 [code]keydown[/code]。派发期间赋值会被忽略。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "The label of the key in the user's layout, using the [enum Key] values."
msgstr "按键在用户布局中的标签，使用 [enum Key] 值。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "The layout-dependent key code, using the [enum Key] values, or [code]0[/code] when unavailable."
msgstr "依赖布局的键码，使用 [enum Key] 值；不可用时为 [code]0[/code]。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "The layout-independent physical key code, using the [enum Key] values."
msgstr "与布局无关的物理键码，使用 [enum Key] 值。"

#. doc_classes/HTMLEvent.xml
msgid "The millisecond timestamp taken when the event was first dispatched."
msgstr "事件首次派发时记录的毫秒时间戳。"

#. doc_classes/HTMLMouseEvent.xml
msgid "The mouse button that produced the event, using the [enum MouseButton] values."
msgstr "产生事件的鼠标键，使用 [enum MouseButton] 值。"

#. doc_classes/HTMLFocusEvent.xml
msgid ""
"The node that gains focus for [code]blur[/code] and [code]focusout[/code], or the node that loses"
" it for [code]focus[/code] and [code]focusin[/code]. It is [code]null[/code] when focus enters or"
" leaves the document."
msgstr ""
"对于 [code]blur[/code] 和 [code]focusout[/code]，是获得焦点的节点；对于 [code]focus[/code] 和 "
"[code]focusin[/code]，是失去焦点的节点。焦点进入或离开文档时为 [code]null[/code]。"

#. doc_classes/HTMLMouseEvent.xml
msgid ""
"The consecutive click count for [code]mousedown[/code], [code]mouseup[/code], "
"[code]pointerdown[/code], [code]pointerup[/code], [code]click[/code], and [code]dblclick[/code]. "
"Other event types report [code]0[/code]. A new sequence starts when the target changes, clicks "
"are at least 500 milliseconds apart, or the pointer moves at least 5 pixels."
msgstr "[code]mousedown[/code]、[code]mouseup[/code]、[code]pointerdown[/code]、[code]pointerup[/code]、[code]click[/code] 和 [code]dblclick[/code] 的连续点击次数。其他事件类型为 [code]0[/code]。目标改变、点击间隔达到 500 毫秒或指针移动达到 5 像素时，会开始新的点击序列。"

#. doc_classes/HTMLPointerEvent.xml
msgid "The ID for this pointer. Mouse events use [code]0[/code], while a touch keeps the same ID for its device and touch index pair."
msgstr "此指针的 ID。鼠标事件使用 [code]0[/code]；同一设备和触摸索引对应的触摸输入会保持相同 ID。"

#. doc_classes/HTMLPointerEvent.xml
msgid "The pointer device type: [code]mouse[/code], [code]pen[/code], or [code]touch[/code]."
msgstr "指针设备类型：[code]mouse[/code]、[code]pen[/code] 或 [code]touch[/code]。"

#. doc_classes/HTMLPointerEvent.xml
msgid "Whether this is the primary pointer of its type."
msgstr "此指针是否为其类型中的主指针。"

#. doc_classes/HTMLWheelEvent.xml
msgid "The delta values are measured in pixels."
msgstr "增量值以像素计量。"

#. doc_classes/HTMLWheelEvent.xml
msgid "The wheel delta in pixels. Positive Y scrolls down and positive X scrolls right."
msgstr "以像素计量的滚轮增量。正 Y 向下滚动，正 X 向右滚动。"

#. doc_classes/HTMLWheelEvent.xml
msgid "The units used by [member delta]. This event always uses [constant DELTA_MODE_PIXEL]."
msgstr "[member delta] 使用的单位。此事件始终使用 [constant DELTA_MODE_PIXEL]。"

#. doc_classes/HTMLMouseEvent.xml
msgid "The pointer position in the host control's local coordinates."
msgstr "宿主控件局部坐标中的指针位置。"

#. doc_classes/HTMLEvent.xml
msgid "The propagation phase the event is currently in."
msgstr "事件当前所处的传播阶段。"

#. doc_classes/HTMLEvent.xml
msgid "The target the event was dispatched to. It does not change during propagation."
msgstr "事件派发到的目标。传播过程中不会改变。"

#. doc_classes/HTMLEvent.xml
msgid "The target whose listeners are running. Use it to implement a listener shared by several targets."
msgstr "当前正在执行监听器的目标。可用于实现多个目标共享的监听器。"

#. doc_classes/HTMLDocumentNode.xml
msgid "The window event target for this document."
msgstr "此文档的 window 事件目标。"

#. doc_classes/HTMLCustomEvent.xml
msgid ""
"Use [HTMLCustomEvent] for application-level events. Assign [member detail] before dispatching; "
"listeners read it to receive structured data. Only [Dictionary] payloads are supported, and the "
"payload is not copied, so listeners share the dispatched value. Assignment is ignored while the "
"event is being dispatched."
msgstr ""
"应用级事件使用 [HTMLCustomEvent]。派发前赋值 [member detail]，监听器通过它获取结构化数据。载荷仅支持 "
"[Dictionary]，且不会复制，因此各监听器共享同一个值。派发期间赋值会被忽略。"

#. doc_classes/HTMLKeyboardEvent.xml
#. doc_classes/HTMLMouseEvent.xml
msgid "Whether Alt was held."
msgstr "按下时是否按住 Alt。"

#. doc_classes/HTMLKeyboardEvent.xml
#. doc_classes/HTMLMouseEvent.xml
msgid "Whether Ctrl was held."
msgstr "按下时是否按住 Ctrl。"

#. doc_classes/HTMLKeyboardEvent.xml
#. doc_classes/HTMLMouseEvent.xml
msgid "Whether Meta was held."
msgstr "按下时是否按住 Meta。"

#. doc_classes/HTMLKeyboardEvent.xml
#. doc_classes/HTMLMouseEvent.xml
msgid "Whether Shift was held."
msgstr "按下时是否按住 Shift。"

#. doc_classes/HTMLEvent.xml
msgid "Whether a listener cancelled the built-in action."
msgstr "监听器是否取消了默认动作。"

#. doc_classes/HTMLEvent.xml
msgid ""
"Whether the engine synthesized the event from real input. Events created by scripts report "
"[code]false[/code]."
msgstr "事件是否由引擎根据真实输入合成。脚本创建的事件为 [code]false[/code]。"

#. doc_classes/HTMLKeyboardEvent.xml
msgid "Whether the event repeats because the key is held down."
msgstr "事件是否因按住按键而重复。"

#. doc_classes/HTMLFocusEvent.xml
msgid ""
"[code]focus[/code] and [code]blur[/code] do not bubble. [code]focusin[/code] and "
"[code]focusout[/code] report the same transitions and bubble, which makes them suitable for "
"delegation. When focus moves between elements, the outgoing events run before the incoming ones."
msgstr ""
"[code]focus[/code] 和 [code]blur[/code] 不冒泡。[code]focusin[/code] 和 [code]focusout[/code] "
"报告相同的焦点变化但会冒泡，适合事件委托。焦点在元素之间移动时，离开的事件先于进入的事件执行。"

#. doc_classes/HTMLSubmitEvent.xml
msgid ""
"[code]submit[/code] runs after constraint validation passes and before the entries are collected."
" Cancelling it aborts the submission, so [signal HTMLLabel.form_submitted] is not emitted. "
"[code]reset[/code] runs only for a reset button; calling [method HTMLFormElement.reset] from a "
"script does not dispatch it."
msgstr ""
"[code]submit[/code] 在约束校验通过之后、收集表单条目之前执行。取消它会中止提交，因此不会发出 [signal "
"HTMLLabel.form_submitted]。[code]reset[/code] 仅对重置按钮执行；在脚本中调用 [method HTMLFormElement.reset] "
"不会派发它。"

#. doc_classes/HTMLAnimationEvent.xml
msgid "A CSS animation lifecycle event."
msgstr "CSS 动画生命周期事件。"

#. doc_classes/HTMLTransitionEvent.xml
msgid "A CSS transition lifecycle event."
msgstr "CSS 过渡生命周期事件。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "A GDScript-accessible 2D drawing context for an HTML canvas."
msgstr "可供 GDScript 使用的 HTML canvas 二维绘图上下文。"

#. doc_classes/HTMLLabel.xml
msgid ""
"A [code]Dictionary[StringName, GDScript][/code] of optional [HTMLBehavior] aliases. A script "
"element first selects an exact [code]src[/code] alias; otherwise [code]src[/code] is resolved as "
"a local script path. Reading this property returns a copy. Assign a new dictionary to update the "
"registry and remount behaviors."
msgstr ""
"可选 [HTMLBehavior] 别名构成的 [code]Dictionary[StringName, GDScript][/code]。脚本元素会先按 [code]src[/code] "
"精确查找别名；若无匹配项，则把 [code]src[/code] 解析为本地脚本路径。读取此属性会返回副本。赋入新 Dictionary 会更新登记表并重新挂载行为。"

#. doc_classes/HTMLListenerHandle.xml
msgid "A cancellable registration returned by [method HTMLEventTarget.listen]."
msgstr "由 [method HTMLEventTarget.listen] 返回的可取消监听器注册句柄。"

#. doc_classes/HTMLClipboardEvent.xml
msgid "A copy, cut, or paste event."
msgstr "复制、剪切或粘贴事件。"

#. doc_classes/HTMLErrorEvent.xml
msgid "A description of the failure."
msgstr "对失败情况的说明。"

#. doc_classes/HTMLToggleEvent.xml
msgid "A disclosure state change event."
msgstr "披露组件状态变化事件。"

#. doc_classes/HTMLCanvasElement.xml
msgid "A handle to an HTML canvas element and its intrinsic pixel buffer."
msgstr "HTML canvas 元素及其固有像素缓冲区的句柄。"

#. doc_classes/HTMLCanvasGradient.xml
msgid "A linear color gradient used by an HTML canvas 2D context."
msgstr "HTML canvas 二维绘图上下文使用的线性颜色渐变。"

#. doc_classes/HTMLMouseEvent.xml
msgid ""
"A mouse event for [code]mousedown[/code], [code]mouseup[/code], [code]mousemove[/code], "
"[code]mouseover[/code], [code]mouseout[/code], [code]mouseenter[/code], [code]mouseleave[/code], "
"[code]click[/code], [code]auxclick[/code], [code]dblclick[/code], and [code]contextmenu[/code]."
msgstr ""
"[code]mousedown[/code]、[code]mouseup[/code]、[code]mousemove[/code]、[code]mouseover[/code]、[code]mouseout[/code]、[code]mouseenter[/code]、[code]mouseleave[/code]、[code]click[/code]、[code]auxclick[/code]、[code]dblclick[/code]"
" 和 [code]contextmenu[/code] 对应的鼠标事件。"

#. doc_classes/HTMLCanvasPattern.xml
msgid "A repeated image fill style used by an HTML canvas 2D context."
msgstr "用于 HTML canvas 二维绘图上下文的重复图像填充样式。"

#. doc_classes/HTMLDataTransfer.xml
msgid "A sorted snapshot of the MIME types currently present."
msgstr "当前 MIME 类型的排序快照。"

#. doc_classes/HTMLTouchEvent.xml
msgid "A touch start, move, end, or cancellation event."
msgstr "触摸开始、移动、结束或取消事件。"

#. doc_classes/HTMLTouchEvent.xml
msgid "Active contacts whose initial target matches this event's changed contact."
msgstr "初始目标与本事件中发生变化的触点相同的活动触点。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Adds a rectangle to the current path."
msgstr "向当前路径添加矩形。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Adds a sampled circular arc to the current path. Angles are in radians."
msgstr "向当前路径添加采样圆弧。角度单位为弧度。"

#. doc_classes/HTMLCanvasGradient.xml
msgid ""
"Adds a stop at an offset from [code]0.0[/code] to [code]1.0[/code]. Color may be a Godot [Color] "
"or CSS color string. Returns [constant OK] on success."
msgstr ""
"在 [code]0.0[/code] 到 [code]1.0[/code] 的偏移处添加色标。颜色可以是 Godot [Color] 或 CSS 颜色字符串。成功时返回 [constant "
"OK]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Adds a straight segment to the current path."
msgstr "向当前路径添加直线段。"

#. doc_classes/HTMLTouchEvent.xml
msgid "All active touch contacts."
msgstr "所有活动触点。"

#. doc_classes/HTMLCompositionEvent.xml
msgid "An IME composition lifecycle event."
msgstr "输入法组合生命周期事件。"

#. doc_classes/HTMLMediaEvent.xml
msgid "An audio or video playback lifecycle event."
msgstr "音频或视频播放生命周期事件。"

#. doc_classes/HTMLErrorEvent.xml
msgid "An error event carrying a readable message and error value."
msgstr "携带可读消息和错误值的错误事件。"

#. doc_classes/HTMLInputEvent.xml
msgid "An input edit event such as [code]beforeinput[/code] or [code]input[/code]."
msgstr "输入编辑事件，例如 [code]beforeinput[/code] 或 [code]input[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Applies a supported formatting command to a noncollapsed selection inside the focused editable "
"region. Commands include [code]bold[/code], [code]italic[/code], [code]underline[/code], "
"[code]strikethrough[/code], [code]subscript[/code], [code]superscript[/code], "
"[code]formatBlock[/code], [code]insertOrderedList[/code], [code]insertUnorderedList[/code], "
"[code]createLink[/code], [code]foreColor[/code], and [code]backColor[/code]. Dispatches "
"cancelable [code]beforeinput[/code] and [code]input[/code] events. Returns [code]false[/code] for"
" unsupported commands or an invalid selection."
msgstr ""
"对焦点所在的可编辑区域内非折叠选区应用受支持的格式命令。命令包括 "
"[code]bold[/code]、[code]italic[/code]、[code]underline[/code]、[code]strikethrough[/code]、[code]subscript[/code]、[code]superscript[/code]、[code]formatBlock[/code]、[code]insertOrderedList[/code]、[code]insertUnorderedList[/code]、[code]createLink[/code]、[code]foreColor[/code]"
" 和 [code]backColor[/code]。此操作会派发可取消的 [code]beforeinput[/code] 和 [code]input[/code] "
"事件。命令不受支持或选区无效时返回 [code]false[/code]。"

#. doc_classes/HTMLBehavior.xml
msgid "Called after the host's document has been laid out if [method _attach_document] is not overridden."
msgstr "如果没有重写 [method _attach_document]，则在宿主文档完成布局后调用。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Called after the host's document has been laid out. Use [param document] to query, create, and "
"edit nodes in the live DOM. The host is also available through [member label]. If both attach "
"hooks are overridden, only this hook is called."
msgstr "宿主文档完成布局后调用。可通过 [param document] 查询、创建和编辑实时 DOM 中的节点，并通过 [member label] 访问宿主。如果同时重写两个挂载钩子，只会调用此方法。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Called when the behavior is detached. [member document] and [member label] remain available "
"during this call. Asynchronous work is canceled immediately after the hook returns."
msgstr "行为分离时调用。此回调期间仍可使用 [member document] 和 [member label]。回调返回后会立即取消异步任务。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Calls [param callback] every idle frame with the frame delta in seconds. Returns an ID for "
"[method cancel_frame], or [code]0[/code] if the callback is invalid or the behavior is detached."
msgstr "每个空闲帧都会调用 [param callback]，并传入帧间隔秒数。返回供 [method cancel_frame] 使用的 ID；回调无效或行为已分离时返回 [code]0[/code]。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Calls [param callback] once after [param delay] seconds. Returns an ID for [method clear_timer], "
"or [code]0[/code] if the callback, delay, or attachment is invalid."
msgstr ""
"在 [param delay] 秒后调用一次 [param callback]。返回供 [method clear_timer] 使用的 ID；回调、延迟或挂载状态无效时返回 "
"[code]0[/code]。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Calls [param callback] repeatedly at the given interval in seconds. Returns an ID for [method "
"clear_timer], or [code]0[/code] if the callback, interval, or attachment is invalid."
msgstr "按指定间隔（秒）重复调用 [param callback]。返回供 [method clear_timer] 使用的 ID；回调、间隔或挂载状态无效时返回 [code]0[/code]。"

#. doc_classes/HTMLBehavior.xml
msgid "Cancels a recurring callback created by [method on_frame]."
msgstr "取消由 [method on_frame] 创建的循环回调。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Cancels a request created by [method request]. A canceled request does not call its completion "
"callback."
msgstr "取消由 [method request] 创建的请求。请求取消后不会调用完成回调。"

#. doc_classes/HTMLBehavior.xml
msgid "Cancels a timeout or interval created by [method set_timeout] or [method set_interval]."
msgstr "取消由 [method set_timeout] 或 [method set_interval] 创建的定时器。"

#. doc_classes/HTMLElement.xml
msgid ""
"Captures an active pointer to this connected element. Later pointer events for that pointer "
"target this element until capture is released or the pointer ends."
msgstr "捕获当前已连接元素上的活动指针。在释放捕获或指针结束前，该指针后续事件都会以此元素为目标。"

#. doc_classes/HTMLDataTransfer.xml
msgid ""
"Clears one MIME payload, or all payloads when [param type] is empty. Protected and read-only "
"transfers cannot be changed."
msgstr "清除 [param type] 对应的 MIME 数据；该参数为空时清除全部数据。受保护或只读的数据传输对象无法修改。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Clears the current path."
msgstr "清空当前路径。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Clears the transformed rectangle to transparent pixels."
msgstr "将变换后的矩形清除为透明像素。"

#. doc_classes/HTMLDataTransfer.xml
msgid ""
"Clipboard events currently expose [code]text/plain[/code]. HTML selection drags also expose "
"sanitized [code]text/html[/code]. Drag payloads can use additional MIME types. Clipboard paste "
"data is read-only; drag data is writable during [code]dragstart[/code], read-only during "
"enter/over/drop, and protected during drag and dragend."
msgstr ""
"剪贴板事件目前只提供 [code]text/plain[/code]。HTML 选区拖动还会提供经过净化的 [code]text/html[/code]。拖放数据可使用其他 MIME "
"类型。剪贴板粘贴数据为只读；拖放数据在 [code]dragstart[/code] 期间可写，在进入、悬停和放下期间为只读，在拖动及 dragend 期间受保护。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Closes the current path."
msgstr "闭合当前路径。"

#. doc_classes/HTMLDialogElement.xml
msgid ""
"Closes the dialog. Pass a [String] to replace [member return_value], or leave the argument as "
"[code]null[/code] to keep the current value. The DOM [code]close[/code] event is dispatched after"
" focus restoration, followed by [signal closed]. Returns [constant OK] if the dialog is already "
"closed."
msgstr ""
"关闭对话框。传入 [String] 可替换 [member return_value]；省略参数或传入 [code]null[/code] 则保留当前值。恢复焦点后会派发 DOM "
"[code]close[/code] 事件，随后发出 [signal closed]。对已关闭的对话框调用时返回 [constant OK]。"

#. doc_classes/HTMLCompositionEvent.xml
msgid "Composition events report the current preedit text on a focused editable text control."
msgstr "组合事件会报告当前获得焦点的可编辑文本控件中的预编辑文本。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Copies image pixels at integer coordinates, ignoring the current transform and compositing mode."
msgstr "在整数坐标处复制图像像素，不受当前变换和合成模式影响。"

#. doc_classes/HTMLCanvasGradient.xml
msgid ""
"Created by [method HTMLCanvasRenderingContext2D.create_linear_gradient]. Add color stops in any "
"order; duplicate offsets retain their insertion order."
msgstr "由 [method HTMLCanvasRenderingContext2D.create_linear_gradient] 创建。可按任意顺序添加色标；偏移相同的色标会保留其插入顺序。"

#. doc_classes/HTMLCanvasPattern.xml
msgid ""
"Created by [method HTMLCanvasRenderingContext2D.create_pattern] from an [Image], [Texture2D], or "
"[HTMLCanvasElement]. The pattern retains its source image when created."
msgstr ""
"由 [method HTMLCanvasRenderingContext2D.create_pattern] 使用 [Image]、[Texture2D] 或 "
"[HTMLCanvasElement] 创建。图案会保留创建时使用的源图像。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid ""
"Creates a linear gradient from the first point to the second. Add stops with [method "
"HTMLCanvasGradient.add_color_stop], then assign the result to [member fill_style] or [member "
"stroke_style]."
msgstr ""
"创建从第一个点到第二个点的线性渐变。使用 [method HTMLCanvasGradient.add_color_stop] 添加色标，然后将结果赋给 [member fill_style] "
"或 [member stroke_style]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid ""
"Creates an image pattern from an [Image], [Texture2D], or [HTMLCanvasElement]. Repeat may be "
"[code]repeat[/code], [code]repeat-x[/code], [code]repeat-y[/code], or [code]no-repeat[/code]."
msgstr ""
"使用 [Image]、[Texture2D] 或 [HTMLCanvasElement] 创建图像图案。重复方式可设为 "
"[code]repeat[/code]、[code]repeat-x[/code]、[code]repeat-y[/code] 或 [code]no-repeat[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Detaches and remounts behaviors declared in the current document. Resource-path scripts are "
"reloaded from the resource cache before mounting."
msgstr "卸载并重新挂载当前文档中声明的行为。重新挂载前会从资源缓存重新加载资源路径对应的脚本。"

#. doc_classes/HTMLDialogElement.xml
msgid ""
"Dispatches a cancelable [code]cancel[/code] event and emits [signal close_requested] "
"synchronously for an open, connected dialog, regardless of [member closed_by]. If either handler "
"cancels the request, returns [constant ERR_SKIP]. Otherwise the dialog closes using the same "
"result rules as [method close]. Returns [constant OK] for a closed or detached dialog."
msgstr ""
"对已打开且已连接的对话框同步派发可取消的 [code]cancel[/code] 事件并发出 [signal close_requested]，不受 [member closed_by] "
"限制。任一处理器取消请求时返回 [constant ERR_SKIP]。否则按 [method close] 的结果规则关闭对话框。对已关闭或已分离的对话框调用时返回 [constant "
"OK]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Displays [member document] or inline [member text] using [HTMLLayout]. Give the control a size "
"with anchors, offsets, or a parent [Container]. The document wraps to the available width, and "
"scrollbars appear as needed to reach overflowing content.\n"
"When the active Godot accessibility backend supports it, [code]HTMLLabel[/code] publishes an "
"element tree for headings, landmarks, links, form controls, lists, tables, dialogs, and live "
"regions. Accessible names use [code]aria-label[/code], [code]aria-labelledby[/code], associated "
"[code]<label>[/code] text, image [code]alt[/code], and native text where available. Disabled, "
"required, read-only, checked, selected, invalid, and expanded states are exposed where Godot has "
"a matching state. Focus, click, and scroll actions are routed back to the HTML document. Godot "
"does not provide dedicated heading or landmark roles, so those use static-text or container roles"
" with role descriptions. Elements hidden by [code]hidden[/code], [code]inert[/code], [code]aria-"
"hidden=\"true\"[/code], or computed [code]display:none[/code] are omitted.\n"
"The default canvas follows CSS [code]color-scheme[/code]. Set an HTML background with CSS, or "
"enable [member transparent_canvas] to composite it over the scene.\n"
"Source changes are applied on a deferred update and reset the scroll position. Resizing "
"recalculates the layout and clamps the current scroll offset. Clicking a [code]#id[/code] link "
"scrolls to the matching HTML element. Connect [signal link_pressed] to handle other links.\n"
"Drag to select rendered text. The focused control supports the standard select-all and copy "
"shortcuts. CSS [code]::selection[/code] styles the selection highlight.\n"
"Selection drags and elements with [code]draggable=\"true\"[/code] expose [code]text/plain[/code],"
" serialized [code]text/html[/code], and custom MIME data through [HTMLDataTransfer]. Drop HTML "
"into an editable region in another [HTMLLabel], or drop the plain text into Godot controls such "
"as [LineEdit].\n"
"For rich-text editing, mark a region [code]contenteditable=\"true\"[/code] or "
"[code]contenteditable=\"plaintext-only\"[/code]. The document node also exposes [member "
"HTMLDocumentNode.design_mode] and [member HTMLDocumentNode.active_element]. The focused editable "
"region supports basic text insertion, deletion, line breaks, and [method execute_edit_command] "
"formatting commands. It does not yet provide browser-equivalent IME handling or HTML clipboard "
"paste.\n"
"CSS [code]:hover[/code] matches the element under the mouse and its ancestors. Scrolling updates "
"the hovered element even when the mouse is stationary. During text selection by dragging, hover "
"styles stay fixed until the drag ends.\n"
"Elements also report DOM events. Register a listener with [method "
"HTMLEventTarget.add_event_listener] or [method HTMLEventTarget.listen] on an element, document, "
"or window. Events run before the built-in action they describe, so a listener can call [method "
"HTMLEvent.prevent_default] to cancel following a link, activating a button or label, toggling a "
"checkbox, opening a disclosure or dropdown, editing text, traversing focus with Tab, and "
"submitting or resetting a form. Pointer moves are coalesced per frame; wheel dispatch stays "
"synchronous. Events without listeners change nothing, and the signals below keep reporting the "
"actions that were performed.\n"
"Assign a Callable to an event handler property such as [code]element.onclick[/code], or use an "
"HTML [code]on*[/code] attribute that names a GDScript behavior method as [code]_on_click()[/code]"
" or [code]_on_click(event)[/code]. Callable properties override the corresponding attribute "
"handler. This does not execute JavaScript.\n"
"When a listener cancels an event, the signal that reports the same action is not emitted. For "
"example, cancelling [code]click[/code] on a link suppresses [signal link_pressed].\n"
"CSS [code]cursor[/code] supports [code]default[/code], [code]pointer[/code], [code]text[/code], "
"[code]crosshair[/code], [code]move[/code], [code]wait[/code], [code]progress[/code], "
"[code]help[/code], [code]not-allowed[/code], [code]ew-resize[/code], and [code]ns-resize[/code]. "
"With [code]auto[/code] or unsupported values, the control uses a pointing hand over links, an "
"I-beam when text selection is enabled, and an arrow otherwise. Dragging to select text uses the "
"I-beam.\n"
"[code]<button type=\"button\">[/code] has a default style that author CSS can override. Use "
"[code]:active[/code], [code]:focus[/code], [code]:focus-visible[/code], [code]:enabled[/code], "
"and [code]:disabled[/code] to style its states. Enter and Space activate the focused button even "
"when text selection is disabled.\n"
"Connect [signal button_pressed] to handle commands in GDScript. Read the button's [code]id[/code]"
" or [code]data-*[/code] attributes to identify the command.\n"
"Tab and Shift+Tab traverse visible, enabled inputs, buttons, links with an [code]href[/code], and"
" elements with a valid [code]tabindex[/code]. Positive values are visited in ascending order "
"before the default stops. A negative value allows direct focus. At either end, focus passes to "
"another Godot control when one is available.\n"
"HTML inputs are represented by [HTMLInputElement]. A focused text input handles text editing, its"
" own selection, and system IME composition. A focused checkbox can be toggled with Space. Date, "
"time, color, and file inputs provide pickers.\n"
"Focused text fields support the [code]ui_undo[/code] and [code]ui_redo[/code] input actions. Undo"
" and redo also restore the selection. Each IME commit is grouped into one edit. Assigning a new "
"value from script or resetting the form clears the field's edit history."
msgstr ""
"使用 [HTMLLayout] 显示 [member document] 或内联的 [member text]。通过锚点、偏移或父级 [Container] "
"为控件分配尺寸。文档按可用宽度换行，滚动条按需出现，以便查看溢出的内容。\n"
"当当前 Godot 无障碍后端支持时，[code]HTMLLabel[/code] 会发布包含标题、地标、链接、表单控件、列表、表格、对话框和实时区域的元素树。可访问名称取自 [code"
"]aria-label[/code]、[code]aria-labelledby[/code]、关联的 [code]<label>[/code] 文本、图像 [code]alt[/code] "
"以及可用的原生文本。Godot 能对应的状态会公开禁用、必填、只读、选中、已勾选、无效和展开等信息。焦点、点击和滚动操作会传回 HTML 文档。Godot "
"没有专用的标题或地标角色，因此这些项目使用带角色说明的静态文本或容器角色。[code]hidden[/code]、[code]inert[/code]、[code]aria-"
"hidden=\"true\"[/code] 或计算样式为 [code]display:none[/code] 的元素不会纳入树中。\n"
"默认画布遵循 CSS [code]color-scheme[/code]。可用 CSS 设置 HTML 背景，或启用 [member transparent_canvas] 将页面合成到场景上。"
"\n"
"源内容变更会延迟应用并重置滚动位置。调整尺寸会重新布局，并将当前滚动偏移限制在可滚动范围内。点击 [code]#id[/code] 链接会滚动到对应的 HTML 元素。连接 [signal "
"link_pressed] 可处理其他链接。\n"
"拖动鼠标可选中渲染后的文字。控件获得焦点时支持标准的全选和复制快捷键。CSS [code]::selection[/code] 控制选区高亮。\n"
"拖动选区或设置 [code]draggable=\"true\"[/code] 的元素会通过 [HTMLDataTransfer] 提供 "
"[code]text/plain[/code]、序列化后的 [code]text/html[/code] 和自定义 MIME 数据。可将 HTML 放入另一个 [HTMLLabel] "
"的可编辑区域，也可将纯文本拖入 [LineEdit] 等 Godot 控件。\n"
"如需富文本编辑，可将区域设为 [code]contenteditable=\"true\"[/code] 或 [code]contenteditable=\"plaintext-"
"only\"[/code]。文档节点还提供 [member HTMLDocumentNode.design_mode] 和 [member "
"HTMLDocumentNode.active_element]。获得焦点的可编辑区域支持基本文本插入、删除、换行和 [method execute_edit_command] "
"格式命令；目前尚未提供与浏览器等效的输入法处理或 HTML 剪贴板粘贴。\n"
"CSS [code]:hover[/code] 匹配鼠标下的元素及其祖先。鼠标静止时滚动也会更新悬停目标。拖选文字时保持当前悬停样式，直到拖选结束。\n"
"元素也会派发 DOM 事件。可在元素、文档或 window 上通过 [method HTMLEventTarget.add_event_listener] 或 [method "
"HTMLEventTarget.listen] 注册监听器。事件先于对应的内置动作运行，因此监听器可调用 [method HTMLEvent.prevent_default] "
"取消跟随链接、激活按钮或标签、切换复选框、打开披露组件或下拉菜单、编辑文本、通过 Tab "
"移动焦点，以及提交或重置表单。指针移动事件按帧合并；滚轮事件同步派发。没有监听器时行为不变，下方信号仍会报告已执行的动作。\n"
"可将 Callable 赋给事件处理属性，例如 [code]element.onclick[/code]；也可在 HTML [code]on*[/code] 属性中指定 GDScript "
"行为方法，例如 [code]_on_click()[/code] 或 [code]_on_click(event)[/code]。Callable 属性会覆盖对应的属性处理器。此功能不会执行 "
"JavaScript。\n"
"监听器取消事件后，报告同一动作的信号不会发出。例如在链接上取消 [code]click[/code] 会抑制 [signal link_pressed]。\n"
"CSS [code]cursor[/code] 支持 "
"[code]default[/code]、[code]pointer[/code]、[code]text[/code]、[code]crosshair[/code]、[code]move[/code]、[code]wait[/code]、[code]progress[/code]、[code]help[/code]、[code"
"]not-allowed[/code]、[code]ew-resize[/code] 和 [code]ns-resize[/code]。使用 [code]auto[/code] "
"或未支持的值时，链接上显示手形，启用文字选择时显示工字形，其余情况显示箭头。拖选文字时显示工字形。\n"
"[code]<button type=\"button\">[/code] 有可被作者 CSS 覆盖的默认样式。可使用 "
"[code]:active[/code]、[code]:focus[/code]、[code]:focus-visible[/code]、[code]:enabled[/code] 和 "
"[code]:disabled[/code] 设置各状态的样式。关闭文本选择后，Enter 和空格键仍可激活获得焦点的按钮。\n"
"连接 [signal button_pressed] 即可在 GDScript 中处理命令。通过按钮的 [code]id[/code] 或 [code]data-*[/code] 属性识别命令。"
"\n"
"Tab 和 Shift+Tab 遍历可见且已启用的输入框、按钮、带 [code]href[/code] 的链接以及设置了有效 [code]tabindex[/code] "
"的元素。正值按升序优先访问。负值允许直接聚焦。到达任一边界时，若有其他 Godot 控件可用，就把焦点交给该控件。\n"
"HTML 输入由 [HTMLInputElement] 表示。获得焦点的文本框处理文字编辑、自身选区和系统输入法预编辑。获得焦点的复选框可通过空格键切换。日期、时间、颜色和文件输入提供选择器。\n"
"聚焦的文本字段支持 [code]ui_undo[/code] 和 [code]ui_redo[/code] "
"输入动作。撤销和重做时也会恢复选区。每次输入法提交算作一次编辑。通过脚本赋予新值或重置表单时，会清空字段的编辑历史。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Draws a source rectangle into a destination rectangle."
msgstr "将源矩形绘制到目标矩形。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Draws an [Image], [Texture2D], or [HTMLCanvasElement] at its intrinsic size."
msgstr "按 [Image]、[Texture2D] 或 [HTMLCanvasElement] 的固有尺寸绘制图像。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Draws an image source scaled to the destination size."
msgstr "将图像源缩放到目标尺寸后绘制。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid ""
"Draws into the canvas's intrinsic RGBA pixels. Fill and stroke styles accept a Godot [Color], CSS"
" color string, [HTMLCanvasGradient], or [HTMLCanvasPattern]. A Godot [Font] resource and pixel "
"size can be used with [method fill_text]. Supported operations include rectangles, a simple "
"polygon path, arcs, image drawing, pixel reads and writes, and 2D transforms. Image reads and "
"writes use Godot [Image] resources rather than browser [code]ImageData[/code]."
msgstr ""
"在 canvas 固有像素缓冲区中绘图。填充和描边样式可使用 Godot [Color]、CSS 颜色字符串、[HTMLCanvasGradient] 或 "
"[HTMLCanvasPattern]。也可使用 Godot [Font] 资源和像素字号调用 [method "
"fill_text]。支持的操作包括矩形、简单多边形路径、圆弧、图像绘制、像素读写和二维变换。图像读写使用 Godot [Image] 资源，而不是浏览器的 "
"[code]ImageData[/code]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid ""
"Draws text with the active [member font] and [member font_size]. The position's y coordinate is "
"the text baseline."
msgstr "使用当前 [member font] 和 [member font_size] 绘制文本。位置的 y 坐标表示文本基线。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted after a navigation or history traversal changes the current URL."
msgstr "导航或历史记录跳转更改当前 URL 后发出。"

#. doc_classes/HTMLPrintLayout.xml
msgid ""
"Emitted after layout and remote resource requests have finished. Check [method get_error] and "
"[method get_diagnostics] before exporting."
msgstr "布局和远程资源请求完成后发出。导出前请检查 [method get_error] 和 [method get_diagnostics]。"

#. doc_classes/HTMLLabel.xml
msgid "Emitted when a local or remote page cannot be loaded."
msgstr "本地或远程页面加载失败时发出。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Enables local and registered [HTMLBehavior] scripts at runtime. Network script URLs are rejected."
" Replacing the document, disabling behaviors, or leaving the scene tree detaches current "
"instances and cancels their asynchronous work."
msgstr "启用本地和已登记的 [HTMLBehavior] 脚本。网络脚本 URL 会被拒绝。替换文档、禁用行为或离开场景树会分离当前实例并取消其异步任务。"

#. doc_classes/HTMLCanvasElement.xml
msgid ""
"Encodes the backing image as a base64 data URL. PNG, JPEG, and WebP are supported. Unsupported "
"MIME types fall back to PNG. Quality is clamped to [code]0.0[/code] through [code]1.0[/code] for "
"lossy formats."
msgstr ""
"将 canvas 像素缓冲区编码为 base64 数据 URL。支持 PNG、JPEG 和 WebP；不支持的 MIME 类型会回退为 PNG。有损格式的质量会限制在 "
"[code]0.0[/code] 到 [code]1.0[/code]。"

#. doc_classes/HTMLEvent.xml
msgid "Events are created by the engine for real input and layout activity, and by scripts for synthetic dispatch. Scripts assign [member type], [member bubbles], and [member cancelable] before calling [method HTMLEventTarget.dispatch_event]. [member target], [member current_target], [member event_phase], and [member default_prevented] are read-only and controlled by the dispatcher.\nThe propagation path runs from the window through the document node and the element chain to the target. [method composed_path] returns that path during dispatch and an empty array after dispatch ends. The [member composed] flag controls whether events originating in a shadow tree cross its boundary. Targets are retargeted to the host for listeners outside that tree. Listeners registered with [code]passive[/code] cannot cancel the default action.\n[method prevent_default] cancels the built-in action that follows the event, such as following a link, activating a button, toggling a checkbox, or inserting typed text. [method HTMLNode.dispatch_event] returns [code]false[/code] when the default action was cancelled.\nWhen a listener cancels an event, the [HTMLLabel] signal that reports the same action is not emitted. Events without listeners behave exactly like the documented signal-only API."
msgstr "事件由引擎在真实输入和布局活动期间创建，也可由脚本创建后合成派发。脚本在调用 [method HTMLEventTarget.dispatch_event] 前设置 [member type]、[member bubbles] 和 [member cancelable]。[member target]、[member current_target]、[member event_phase] 与 [member default_prevented] 由派发器控制，只读。\n传播路径从 window 经过文档节点和元素链到达目标。[method composed_path] 返回当前派发的路径；派发完成后返回空数组。[member composed] 控制来自影子树的事件是否跨越边界传播。影子树外监听器看到的目标会重定向为宿主。\n使用 [code]passive[/code] 注册的监听器不能取消默认动作。[method prevent_default] 会取消后续内置动作，例如跟随链接、激活按钮、切换复选框或插入文本。默认动作被取消时，[method HTMLNode.dispatch_event] 返回 [code]false[/code]。\n监听器取消事件后，[HTMLLabel] 中报告同一动作的信号不会发出。没有监听器时，事件不会改变仅使用信号时的行为。"

#. doc_classes/HTMLMediaEvent.xml
msgid ""
"Events such as [code]play[/code], [code]pause[/code], [code]timeupdate[/code], "
"[code]seeked[/code], and [code]ended[/code] are dispatched on their media element. Only states "
"exposed by the active local media backend are reported."
msgstr ""
"媒体元素会派发 [code]play[/code]、[code]pause[/code]、[code]timeupdate[/code]、[code]seeked[/code] 和 "
"[code]ended[/code] 等事件。只报告当前本地媒体后端提供的状态。"

#. doc_classes/HTMLWindow.xml
msgid ""
"Every document exposes one window handle through [method HTMLDocumentNode.get_default_view]. "
"Listeners registered on it run first in the capture phase and last in the bubble phase, which "
"makes it the natural place for shortcuts and document-wide handlers. The first successful layout "
"dispatches [code]DOMContentLoaded[/code] on the document and then [code]load[/code] on the "
"window. A changed HTML viewport dispatches a non-bubbling [code]resize[/code] event after layout;"
" initial layout does not dispatch one. Godot OS window focus notifications dispatch non-bubbling "
"[code]focus[/code] and [code]blur[/code] events. A window becomes invalid when the layout "
"replaces or clears its document. Omitted [code]passive[/code] defaults to [code]true[/code] for "
"[code]wheel[/code], [code]touchstart[/code], and [code]touchmove[/code]."
msgstr ""
"每个文档都可通过 [method HTMLDocumentNode.get_default_view] 获取一个 window "
"句柄。在该对象上注册的监听器会先在捕获阶段运行，最后在冒泡阶段运行，适合处理快捷键和整个文档范围的事件。首次成功布局时，文档会派发 "
"[code]DOMContentLoaded[/code]，随后 window 派发 [code]load[/code]。HTML 视口发生变化并完成布局后会派发不冒泡的 "
"[code]resize[/code] 事件；首次布局不会派发该事件。Godot 操作系统窗口的焦点通知会派发不冒泡的 [code]focus[/code] 和 "
"[code]blur[/code] 事件。布局替换或清除文档后，window 句柄会失效。未指定 [code]passive[/code] "
"时，[code]wheel[/code]、[code]touchstart[/code] 和 [code]touchmove[/code] 默认使用 [code]true[/code]。"

#. doc_classes/HTMLPrintLayout.xml
msgid ""
"Exports the paginated layout to PDF bytes. Returns an empty array when the layout is not ready or"
" PDFium is unavailable."
msgstr "将分页布局导出为 PDF 字节数据。布局尚未就绪或 PDFium 不可用时返回空数组。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Extend this class with a GDScript that can be constructed without arguments. Add it to [member "
"HTMLLabel.behavior_scripts] to register an alias, or refer to a local GDScript path from an HTML "
"[code]<script type=\"text/gdscript\">[/code] element. Enable [member HTMLLabel.behaviors_enabled]"
" to run behaviors. Local [code]res://[/code], [code]user://[/code], [code]uid://[/code], and "
"document-relative script paths are supported; network script URLs are rejected.\n"
"The behavior exposes its host through [member label] while attached. Timers, frame callbacks, and"
" requests started by this instance are canceled when it detaches."
msgstr ""
"继承此类并实现可无参构造的 GDScript。将脚本加入 [member HTMLLabel.behavior_scripts] 以注册别名，或在 HTML [code]<script "
"type=\"text/gdscript\">[/code] 元素中使用本地 GDScript 路径。启用 [member HTMLLabel.behaviors_enabled] "
"后即可运行行为。支持本地 [code]res://[/code]、[code]user://[/code]、[code]uid://[/code] 和相对于文档的脚本路径；不接受网络脚本 "
"URL。\n"
"行为挂载期间可通过 [member label] 访问宿主。此实例分离时会取消其启动的定时器、逐帧回调和请求。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Fills the current path using [member fill_style]."
msgstr "使用 [member fill_style] 填充当前路径。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Fills the transformed rectangle using [member fill_style]."
msgstr "使用 [member fill_style] 填充变换后的矩形。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Loads a local HTML file or an HTTP(S) HTML page and adds it to this label's navigation history. "
"Set [param replace] to replace the current history entry. Navigating to a fragment in the current"
" document scrolls to its anchor without adding an entry. Remote page loading is asynchronous; "
"connect to [signal navigation_failed] to handle failures."
msgstr ""
"加载本地 HTML 文件或 HTTP(S) HTML 页面，并将其加入此标签的导航历史记录。设置 [param replace] "
"可替换当前历史记录项。跳转到当前文档中的片段时，只会滚动到对应锚点，不会新增历史记录。远程页面采用异步加载；可连接 [signal navigation_failed] 处理加载失败。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Loads the next entry in this label's navigation history. Returns [code]false[/code] when there is"
" no next entry."
msgstr "加载此标签导航历史记录中的下一项。没有下一项时返回 [code]false[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Loads the previous entry in this label's navigation history. Returns [code]false[/code] when "
"there is no previous entry."
msgstr "加载此标签导航历史记录中的上一项。没有上一项时返回 [code]false[/code]。"

#. doc_classes/MarkdownLabel.xml
msgid ""
"MarkdownLabel displays Markdown text in a [Control] node and provides scrolling, text selection, "
"search, link handling, and streaming output. Images are scaled to fit the content area. When "
"[member fit_content] is enabled, the control height grows with its content.\n"
"Configure streaming with [member streaming_enabled], [method append_text], [member "
"max_unstable_lines], and [member deferred_layout_enabled]. Call [method finish_stream] after the "
"final append to parse and lay out the complete text.\n"
"At [constant Node.NOTIFICATION_ENTER_TREE], the node creates internal scrolling, margin, and "
"drawing nodes. Avoid adding child nodes manually."
msgstr ""
"MarkdownLabel 是在 [Control] 节点中显示 Markdown 文本的控件，提供滚动、文本选择、搜索、链接处理和流式输出。图像会缩放到内容区域内；启用 [member "
"fit_content] 时，控件高度会随内容增长。\n"
"可通过 [member streaming_enabled]、[method append_text]、[member max_unstable_lines] 和 [member "
"deferred_layout_enabled] 配置流式输出。最后一次追加后调用 [method finish_stream]，完成最终解析和布局。\n"
"在 [constant Node.NOTIFICATION_ENTER_TREE] 通知时，节点会创建内部滚动、边距和绘制节点。请勿手动添加子节点。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Moves by [param delta] entries in this label's navigation history. Returns [code]false[/code] "
"when the target is outside the history or is the current entry."
msgstr "在此标签的导航历史记录中移动 [param delta] 项。目标超出历史记录范围或就是当前项时返回 [code]false[/code]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Moves the current path point."
msgstr "移动当前路径的当前点。"

#. doc_classes/HTMLTouchPoint.xml
msgid "One active or changed contact in a touch event."
msgstr "触摸事件中的一个活动触点或发生变化的触点。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Persistent behavior storage namespace. When empty, the label derives one from its document source"
" or node identity."
msgstr "持久化行为存储使用的命名空间。留空时，标签会根据文档来源或节点标识生成命名空间。"

#. doc_classes/HTMLBehavior.xml
msgid "Persistent string key-value storage for the current document namespace."
msgstr "当前文档命名空间下的持久化字符串键值存储。"

#. doc_classes/HTMLPointerEvent.xml
msgid ""
"Pointer events report a stable pointer ID and a type of [code]mouse[/code], [code]pen[/code], or "
"[code]touch[/code]. [HTMLLabel] synthesizes mouse and touch pointer events. Touch pointer IDs "
"remain stable for each device and touch index pair. When Godot emulates mouse input from touch, "
"[HTMLLabel] uses that mouse input instead of also dispatching touch pointer events. A touch "
"pointer receives [code]pointercancel[/code] when viewport scrolling takes over the gesture or the"
" touch is canceled. Call [method HTMLElement.set_pointer_capture] from an active pointer handler "
"to keep subsequent pointer events targeted at an element. Move events are coalesced per frame."
msgstr ""
"指针事件会报告稳定的指针 ID，以及 [code]mouse[/code]、[code]pen[/code] 或 [code]touch[/code] 类型。[HTMLLabel] "
"会合成鼠标和触摸指针事件。每组设备和触摸索引对应的触摸指针 ID 保持稳定。Godot 从触摸模拟鼠标输入时，[HTMLLabel] "
"使用该鼠标输入，不再派发对应的触摸指针事件。视口滚动接管手势或触摸被取消时，会派发 [code]pointercancel[/code]。在活动指针处理器中调用 [method "
"HTMLElement.set_pointer_capture] 可让后续指针事件继续以该元素为目标。移动事件按帧合并。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Prints a summary of each DOM event dispatched by this label, including its target, propagation "
"path size, registered listener count, and default-canceled state."
msgstr "输出此标签派发的每个 DOM 事件的摘要，包括目标、传播路径长度、已注册监听器数量以及默认动作是否已取消。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"Queries and edits the live DOM of one layout. It becomes invalid when that layout clears or "
"replaces its document. Queries and creation methods on an invalid document node return "
"[code]null[/code] or empty arrays. [member visibility_state] reflects whether the owning "
"[HTMLLabel] is effectively visible in the scene tree; changes dispatch "
"[code]visibilitychange[/code] on this document."
msgstr ""
"查询和编辑一个布局的实时 DOM。布局清空或替换文档后，该句柄会失效。对失效的文档节点调用查询或创建方法会返回 [code]null[/code] 或空数组。[member "
"visibility_state] 反映所属 [HTMLLabel] 在场景树中是否有效可见；状态变化时，此文档会派发 [code]visibilitychange[/code]。"

#. doc_classes/HTMLEventTarget.xml
msgid ""
"Registers [param callable] and returns a handle whose [method HTMLListenerHandle.cancel] method "
"removes it. Returns [code]null[/code] when registration fails. Options match [method "
"add_event_listener]."
msgstr ""
"注册 [param callable] 并返回一个句柄；调用其 [method HTMLListenerHandle.cancel] 方法即可移除监听器。注册失败时返回 "
"[code]null[/code]。选项与 [method add_event_listener] 相同。"

#. doc_classes/HTMLEventTarget.xml
msgid ""
"Registers [param callable] for events of [param type] on this target. The callback receives the "
"[HTMLEvent] as its only argument.\n"
"[param options] accepts [code]capture[/code] to run during the capture phase, [code]once[/code] "
"to remove the listener after its first call, and [code]passive[/code] to make [method "
"HTMLEvent.prevent_default] a no-op that only warns once.\n"
"When [code]passive[/code] is omitted for [code]wheel[/code], [code]touchstart[/code], or "
"[code]touchmove[/code] on the document or window, it defaults to [code]true[/code]. Other targets"
" and types default to [code]false[/code].\n"
"Registering the same callback, type, and [code]capture[/code] flag twice is a no-op. Registering "
"on the document node handles events for all of its descendants, which is the supported way to "
"delegate.\n"
"Listeners survive detaching the node and follow it back into the tree. They are discarded when "
"the node is removed with [method HTMLElement.remove], when the document is replaced, and when the"
" owning layout is cleared."
msgstr ""
"在此目标上为 [param type] 事件注册 [param callable]。回调只接收一个 [HTMLEvent] 参数。\n"
"[param options] 可包含 [code]capture[/code]（在捕获阶段运行）、[code]once[/code]（首次调用后移除）和 "
"[code]passive[/code]（令 [method HTMLEvent.prevent_default] 无效且仅警告一次）。\n"
"在 document 或 window 上注册 [code]wheel[/code]、[code]touchstart[/code] 或 [code]touchmove[/code] "
"监听器时，未指定 [code]passive[/code] 会默认为 [code]true[/code]；其他目标和事件类型默认为 [code]false[/code]。\n"
"重复注册相同回调、事件类型和 [code]capture[/code] 标志不会产生额外效果。在文档节点注册可接收所有后代的事件，这是支持的事件委托方式。\n"
"节点分离后监听器仍会保留，并在节点重新接入时继续生效。节点通过 [method HTMLElement.remove] 移除、文档被替换或所属布局被清空时，监听器会被丢弃。"

#. doc_classes/HTMLElement.xml
msgid ""
"Releases this pointer's active capture. Returns [constant ERR_UNAVAILABLE] if the pointer is not "
"captured by an element."
msgstr "释放此指针当前的捕获。该指针未被元素捕获时返回 [constant ERR_UNAVAILABLE]。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid "Removes [param key] if present."
msgstr "如果存在则移除 [param key]。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid "Removes all values from this storage."
msgstr "移除此存储中的所有值。"

#. doc_classes/HTMLListenerHandle.xml
msgid "Removes the listener. Calling this more than once has no additional effect."
msgstr "移除此监听器。重复调用不会产生额外效果。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Replaces the current transform with the affine matrix [code](a, b, c, d, e, f)[/code]."
msgstr "使用仿射矩阵 [code](a, b, c, d, e, f)[/code] 替换当前变换。"

#. doc_classes/HTMLDetailsElement.xml
msgid ""
"Represents [code]<details>[/code]. Activate the first [code]<summary>[/code] child to toggle it. "
"Setting [member open] through this element API dispatches cancelable [code]beforetoggle[/code]; "
"accepted changes produce a coalesced [code]toggle[/code] event and the [signal toggled] signal."
msgstr ""
"表示 [code]<details>[/code]。激活第一个 [code]<summary>[/code] 子元素可切换其状态。通过此元素 API 设置 [member open] "
"时会派发可取消的 [code]beforetoggle[/code]；更改获准后会合并派发 [code]toggle[/code] 事件，并发出 [signal toggled]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Resets the current transform to the identity transform."
msgstr "将当前变换重置为单位变换。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Restores the most recently saved context state when one is available."
msgstr "有可恢复的状态时，恢复最近保存的上下文状态。"

#. doc_classes/HTMLCanvasElement.xml
msgid ""
"Returned by DOM queries for [code]<canvas>[/code]. The default backing size is 300 by 150 pixels."
" CSS controls the displayed box independently from the backing image. Resizing either intrinsic "
"dimension clears the image and resets the 2D context state. Backing storage is limited to 8192 "
"pixels per dimension and 16 million pixels total."
msgstr ""
"DOM 查询 [code]<canvas>[/code] 时返回此对象。默认缓冲区尺寸为 300 × 150 像素。CSS "
"控制显示区域，缓冲图像尺寸则独立设置。更改任一固有尺寸都会清空图像并重置二维上下文状态。缓冲区每个方向最多 8192 像素，总计最多 1600 万像素。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns [code]true[/code] after the initial layout and all remote resources have settled."
msgstr "首次布局完成且所有远程资源加载完毕后返回 [code]true[/code]。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid "Returns [code]true[/code] if [param key] exists."
msgstr "如果存在 [param key]，则返回 [code]true[/code]。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"Returns [code]visible[/code] or [code]hidden[/code] based on the owning [HTMLLabel]'s effective "
"scene-tree visibility."
msgstr "根据所属 [HTMLLabel] 在场景树中的有效可见性，返回 [code]visible[/code] 或 [code]hidden[/code]。"

#. doc_classes/HTMLCanvasElement.xml
msgid ""
"Returns a copy of the backing RGBA image. A canvas without a created context returns a "
"transparent image at its intrinsic size."
msgstr "返回缓冲区 RGBA 图像的副本。尚未创建上下文的 canvas 会返回固有尺寸的透明图像。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Returns a copy of the full backing image."
msgstr "返回完整缓冲图像的副本。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Returns a copy of the requested pixel rectangle. Pixels outside the canvas are transparent."
msgstr "返回指定像素矩形的副本。canvas 外部的像素为透明。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns a message for the most recent layout or export error."
msgstr "返回最近一次布局或导出错误的消息。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns a snapshot of behavior mounting failures. Each Dictionary contains [code]src[/code], "
"[code]path[/code], and [code]reason[/code]. Failures are also reported with "
"[code]push_warning[/code]."
msgstr ""
"返回行为挂载失败记录的快照。每个 Dictionary 都包含 [code]src[/code]、[code]path[/code] 和 "
"[code]reason[/code]。发生失败时也会通过 [code]push_warning[/code] 报告。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Returns matching elements from the document element tree in document order, with each element "
"included once. Queries support tags, classes, IDs, attributes, combinators, selector lists, "
"structural pseudo-classes, relational [code]:has()[/code], forgiving [code]:is()[/code] and "
"[code]:where()[/code], [code]:lang()[/code], [code]:dir()[/code], and supported state selectors. "
"Queries include hidden elements and are available after parsing. Invalid or unsupported selectors"
" report an error and return an empty array."
msgstr ""
"按文档顺序返回文档元素树中匹配的元素，每个元素只包含一次。查询支持标签、类、ID、属性、组合器、选择器列表、结构伪类、关系选择器 [code]:has()[/code]、宽容解析的 "
"[code]:is()[/code] 和 [code]:where()[/code]、[code]:lang()[/code]、[code]:dir()[/code] "
"以及受支持的状态选择器。解析后即可查询，结果包含隐藏元素。选择器无效或不受支持时会报告错误并返回空数组。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Returns persistent storage for this document namespace. It is shared by behavior instances using "
"the same namespace."
msgstr "返回此文档命名空间对应的持久化存储。同一命名空间下的行为实例会共享此存储。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Returns storage shared by behavior instances on this [HTMLLabel] and retained across its "
"navigations."
msgstr "返回此 [HTMLLabel] 上行为实例共享的存储。该存储在标签导航期间保留。"

#. doc_classes/HTMLBehavior.xml
msgid "Returns the attached host or [code]null[/code] outside the behavior's attachment lifecycle."
msgstr "返回当前宿主；行为未处于挂载生命周期时为 [code]null[/code]。"

#. doc_classes/HTMLCanvasElement.xml
msgid ""
"Returns the cached 2D context for [code]2d[/code], or [code]null[/code] for unsupported context "
"IDs or invalid handles."
msgstr "返回缓存的 [code]2d[/code] 上下文；上下文 ID 不受支持或句柄无效时返回 [code]null[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the configured storage namespace, or the document source and host identity used by "
"persistent behavior storage."
msgstr "返回已配置的存储命名空间；未配置时返回持久化行为存储所用的文档来源和宿主标识。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Returns the current live DOM. It is available during both attach hooks and [method _detach], and "
"is [code]null[/code] before attachment and after [method _detach] returns."
msgstr "返回当前实时 DOM。两个挂载钩子和 [method _detach] 执行期间均可使用；挂载前及 [method _detach] 返回后为 [code]null[/code]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the current navigation URL, or the effective document base URL when no navigation has "
"occurred."
msgstr "返回当前导航 URL；尚未导航时返回生效的文档基准 URL。"

#. doc_classes/HTMLPrintLayout.xml
msgid ""
"Returns the most recent Godot error code, or [constant OK] when the layout and last export "
"succeeded."
msgstr "返回最近一次 Godot 错误代码；布局和上一次导出均成功时返回 [constant OK]。"

#. doc_classes/HTMLLabel.xml
msgid ""
"Returns the number of explicit listeners registered for [param type] on this label's document, "
"elements, and window. Event handler properties and HTML attributes are not included."
msgstr "返回此标签的文档、元素和 window 上为 [param type] 显式注册的监听器数量。不包括事件处理器属性和 HTML 属性。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns the number of pages in this layout."
msgstr "返回此布局的页数。"

#. doc_classes/HTMLPrintLayout.xml
msgid "Returns the physical page size in CSS pixels."
msgstr "返回物理页面尺寸，单位为 CSS 像素。"

#. doc_classes/HTMLEvent.xml
msgid ""
"Returns the propagation path of the current dispatch, with the target first and the window last. "
"The array is empty outside event dispatch."
msgstr "返回当前派发的传播路径，目标位于首位、window 位于末尾。事件派发期间以外返回空数组。"

#. doc_classes/HTMLDataTransfer.xml
msgid "Returns the supported data types currently present."
msgstr "返回当前存在的受支持数据类型。"

#. doc_classes/HTMLDataTransfer.xml
msgid ""
"Returns the value associated with [param type], or an empty string when the type is absent or "
"data is protected."
msgstr "返回 [param type] 对应的数据；类型不存在或数据受保护时返回空字符串。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid ""
"Returns the value for [param key], or an empty string when it is missing. Use [method has_item] "
"to distinguish a missing key from an empty value."
msgstr "返回 [param key] 对应的值；键不存在时返回空字符串。可使用 [method has_item] 区分键不存在和键值为空。"

#. doc_classes/HTMLElement.xml
msgid "Returns whether this element currently captures the pointer."
msgstr "返回此元素当前是否捕获了指针。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Rotates the current transform in radians."
msgstr "以弧度旋转当前变换。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Saves the fill style, stroke style, line width, and transform."
msgstr "保存填充样式、描边样式、线宽和变换。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Scales the current transform."
msgstr "缩放当前变换。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"Set to [code]on[/code] to make the document body editable, or [code]off[/code] to disable "
"document-wide editing. Other values are ignored."
msgstr "将文档主体设为 [code]on[/code] 时可编辑，设为 [code]off[/code] 时会禁用整个文档的编辑。其他值会被忽略。"

#. doc_classes/HTMLDataTransfer.xml
msgid "Sets a MIME payload while the transfer is writable. The type is normalized to lowercase."
msgstr "在数据传输对象可写时设置 MIME 数据。类型名称会转换为小写。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"Starts an asynchronous HTTP request. [param options] accepts [code]method[/code] (GET, HEAD, "
"POST, PUT, DELETE, OPTIONS, or PATCH), [code]headers[/code] as a Dictionary, [code]body[/code] as"
" a String, [code]max_body_size[/code], [code]timeout[/code], and [code]track_redirects[/code]. "
"The callback receives a Dictionary with [code]url[/code], [code]status_code[/code], "
"[code]headers[/code], [code]body[/code], and [code]error[/code]. Returns an ID for [method "
"cancel_request], or [code]0[/code] if the URL or options are invalid."
msgstr ""
"启动异步 HTTP 请求。[param options] 可包含 [code]method[/code]（GET、HEAD、POST、PUT、DELETE、OPTIONS 或 PATCH）、作为"
" Dictionary 的 [code]headers[/code]、字符串 "
"[code]body[/code]、[code]max_body_size[/code]、[code]timeout[/code] 和 "
"[code]track_redirects[/code]。回调会收到包含 "
"[code]url[/code]、[code]status_code[/code]、[code]headers[/code]、[code]body[/code] 和 "
"[code]error[/code] 的 Dictionary。返回供 [method cancel_request] 使用的 ID；URL 或选项无效时返回 [code]0[/code]。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid "Stores [param value] under [param key]. An empty key is ignored."
msgstr "将 [param value] 存储在 [param key] 下。空键会被忽略。"

#. doc_classes/HTMLDataTransfer.xml
msgid "String data exposed to clipboard and drag events."
msgstr "剪贴板和拖放事件中提供的字符串数据。"

#. doc_classes/HTMLBehaviorStorage.xml
msgid "String key-value storage for an HTML behavior."
msgstr "HTML 行为使用的字符串键值存储。"

#. doc_classes/HTMLBehavior.xml
msgid "String key-value storage retained for this host's session."
msgstr "此宿主会话期间保留的字符串键值存储。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Strokes the current path using [member stroke_style] and [member line_width]."
msgstr "使用 [member stroke_style] 和 [member line_width] 描画当前路径。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "Strokes the rectangle using [member stroke_style] and [member line_width]."
msgstr "使用 [member stroke_style] 和 [member line_width] 描画矩形。"

#. doc_classes/HTMLLayout.xml
msgid ""
"Tests a CSS property and value, or a [code]@supports[/code] condition when [param value] is "
"empty. Registered custom properties support a documented subset of [code]@property[/code] syntax;"
" see the CSS support reference."
msgstr ""
"测试 CSS 属性和值；[param value] 为空时测试 [code]@supports[/code] 条件。已登记的自定义属性支持 [code]@property[/code] "
"语法的文档所列子集，详见 CSS 支持参考。"

#. doc_classes/HTMLInputEvent.xml
msgid "Text inserted by this edit, or an empty string when the edit does not insert text."
msgstr "此次编辑插入的文本；未插入文本时为空字符串。"

#. doc_classes/HTMLAnimationEvent.xml
msgid "The CSS animation name."
msgstr "CSS 动画名称。"

#. doc_classes/HTMLTransitionEvent.xml
msgid "The CSS property being transitioned."
msgstr "正在过渡的 CSS 属性。"

#. doc_classes/HTMLClipboardEvent.xml
msgid ""
"The [member clipboard_data] payload is limited to [code]text/plain[/code]. Cancelling "
"[code]paste[/code] prevents the default insertion; cancelling [code]cut[/code] prevents deletion "
"of the selected text."
msgstr ""
"[member clipboard_data] 仅提供 [code]text/plain[/code] 数据。取消 [code]paste[/code] 会阻止默认插入；取消 "
"[code]cut[/code] 会阻止删除选中文本。"

#. doc_classes/HTMLCompositionEvent.xml
msgid "The composition text associated with this event."
msgstr "与此事件关联的组合文本。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"The connected element focused in the owning [HTMLLabel], or [code]null[/code] when the label has "
"no focused DOM element."
msgstr "所属 [HTMLLabel] 中当前获得焦点且已连接的元素；标签没有获得焦点的 DOM 元素时为 [code]null[/code]。"

#. doc_classes/HTMLTouchEvent.xml
msgid "The contact changed by this event."
msgstr "此事件中发生变化的触点。"

#. doc_classes/HTMLTouchPoint.xml
msgid "The contact position in the label's local coordinates."
msgstr "触点在标签局部坐标系中的位置。"

#. doc_classes/HTMLBehavior.xml
msgid ""
"The current host, available from the attach hooks through [method _detach]. It is "
"[code]null[/code] before attachment and after detachment."
msgstr "挂载期间可通过挂载钩子至 [method _detach] 访问当前宿主。挂载前和分离后为 [code]null[/code]。"

#. doc_classes/HTMLLabel.xml
msgid "The current navigation URL. Read-only."
msgstr "当前导航 URL。只读。"

#. doc_classes/HTMLInputEvent.xml
msgid ""
"The edit operation, such as [code]insertText[/code], [code]deleteContentBackward[/code], or "
"[code]historyUndo[/code]."
msgstr "编辑操作，例如 [code]insertText[/code]、[code]deleteContentBackward[/code] 或 [code]historyUndo[/code]。"

#. doc_classes/HTMLDocumentNode.xml
msgid ""
"The effective visibility of the owning [HTMLLabel]: [code]visible[/code] or [code]hidden[/code]. "
"A change dispatches [code]visibilitychange[/code] on this document."
msgstr ""
"所属 [HTMLLabel] 的有效可见性：[code]visible[/code] 或 [code]hidden[/code]。可见性改变时，此文档会派发 "
"[code]visibilitychange[/code]。"

#. doc_classes/HTMLAnimationEvent.xml
msgid "The elapsed animation time in seconds."
msgstr "动画已运行的时间，单位为秒。"

#. doc_classes/HTMLTransitionEvent.xml
msgid "The elapsed transition time in seconds."
msgstr "过渡已运行的时间，单位为秒。"

#. doc_classes/HTMLTouchPoint.xml
msgid "The element initially targeted by the contact."
msgstr "此触摸事件中最初作为目标的元素。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "The fill [Color], CSS color string, [HTMLCanvasGradient], or [HTMLCanvasPattern]."
msgstr "填充所用的 [Color]、CSS 颜色字符串、[HTMLCanvasGradient] 或 [HTMLCanvasPattern]。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "The font pixel size used by [method fill_text]. Values range from 1 to 512."
msgstr "[method fill_text] 使用的字体像素大小。取值范围为 1 到 512。"

#. doc_classes/HTMLCanvasRenderingContext2D.xml
msgid "The font resource used by [method fill_text], or [code]null[/code] to use Godot's fallback font."
