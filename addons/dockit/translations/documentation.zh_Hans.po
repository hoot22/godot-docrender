"[code]link[/code]."
msgstr "请求的放下操作：[code]none[/code]、[code]copy[/code]、[code]move[/code] 或 [code]link[/code]。"

#. doc_classes/HTMLToggleEvent.xml
msgid "The resulting state, [code]open[/code] or [code]closed[/code]."
msgstr "更改后的状态：[code]open[/code] 或 [code]closed[/code]。"

